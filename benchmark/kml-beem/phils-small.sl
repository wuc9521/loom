        (declare-term-types
         ((Modal 0))
         (((modal.not Modal)
           (modal.and Modal Modal)
           (modal.or Modal Modal)
           (modal.box Modal)
           (modal.dia Modal)
           (fork_0_is_0) (fork_0_is_1) (fork_1_is_0) (fork_1_is_1) (fork_2_is_0) (fork_2_is_1) (fork_3_is_0) (fork_3_is_1) (phil0_eat) (phil0_finish) (phil0_one) (phil0_think) (some_phil_eat) (some_phil_finish) (some_phil_one) (some_phil_think))))

        (define-finite ModalAsp
          (record (model Model) (node U))
          :where true)

        (define-semantics
          ((Modal.Sem (phi Modal) (asp ModalAsp)))
          ((match phi
             ((fork_0_is_0) (fork_0_is_0 (node asp)))
     ((fork_0_is_1) (fork_0_is_1 (node asp)))
     ((fork_1_is_0) (fork_1_is_0 (node asp)))
     ((fork_1_is_1) (fork_1_is_1 (node asp)))
     ((fork_2_is_0) (fork_2_is_0 (node asp)))
     ((fork_2_is_1) (fork_2_is_1 (node asp)))
     ((fork_3_is_0) (fork_3_is_0 (node asp)))
     ((fork_3_is_1) (fork_3_is_1 (node asp)))
     ((phil0_eat) (phil0_eat (node asp)))
     ((phil0_finish) (phil0_finish (node asp)))
     ((phil0_one) (phil0_one (node asp)))
     ((phil0_think) (phil0_think (node asp)))
     ((some_phil_eat) (some_phil_eat (node asp)))
     ((some_phil_finish) (some_phil_finish (node asp)))
     ((some_phil_one) (some_phil_one (node asp)))
     ((some_phil_think) (some_phil_think (node asp)))
             ((modal.not x) (not (Modal.Sem x asp)))
             ((modal.and x y) (and (Modal.Sem x asp) (Modal.Sem y asp)))
             ((modal.or x y) (or (Modal.Sem x asp) (Modal.Sem y asp)))
             ((modal.box x)
              (forall ((next (domain (U (model asp)))))
                (or (not (R (node asp) next))
                    (Modal.Sem x (ModalAsp (model asp) next)))))
             ((modal.dia x)
              (exists ((next (domain (U (model asp)))))
                (and (R (node asp) next)
                     (Modal.Sem x (ModalAsp (model asp) next))))))))

        (synth-fun phi () Modal)
        (constraint (not (Modal.Sem phi (ModalAsp phils_1 $0))))
(constraint (Modal.Sem phi (ModalAsp phils_2 $0)))

        (check-synth)
