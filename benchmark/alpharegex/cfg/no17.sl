(set-logic ALL)
(require "./theories/main.sl")
(require "../common/models/no17.sl")

(synth-fun g () CFG)

(constraint (CFG.Sem g (CFG.Asp p0 0 (size (Pos p0)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p001 0 (size (Pos p001)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p0001 0 (size (Pos p0001)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p0010 0 (size (Pos p0010)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p01000 0 (size (Pos p01000)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p100000 0 (size (Pos p100000)) reset.S)))
(constraint (not (CFG.Sem g (CFG.Asp n1 0 (size (Pos n1)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n101 0 (size (Pos n101)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n0110 0 (size (Pos n0110)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n1010 0 (size (Pos n1010)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n1001 0 (size (Pos n1001)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n10001 0 (size (Pos n10001)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n111000 0 (size (Pos n111000)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n010000100 0 (size (Pos n010000100)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n000101001 0 (size (Pos n000101001)) reset.S))))

(check-synth)
