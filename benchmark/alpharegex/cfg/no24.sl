(set-logic ALL)
(require "./theories/main.sl")
(require "../common/models/no24.sl")

(synth-fun g () CFG)

(constraint (CFG.Sem g (CFG.Asp p0 0 (size (Pos p0)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p1 0 (size (Pos p1)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p01 0 (size (Pos p01)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p010 0 (size (Pos p010)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p0101 0 (size (Pos p0101)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p1010 0 (size (Pos p1010)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p00111 0 (size (Pos p00111)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p001100111 0 (size (Pos p001100111)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p100110011 0 (size (Pos p100110011)) reset.S)))
(constraint (not (CFG.Sem g (CFG.Asp n00 0 (size (Pos n00)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n100 0 (size (Pos n100)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n001 0 (size (Pos n001)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n0010 0 (size (Pos n0010)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n1001 0 (size (Pos n1001)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n11001 0 (size (Pos n11001)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n00101 0 (size (Pos n00101)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n001100 0 (size (Pos n001100)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n1001011 0 (size (Pos n1001011)) reset.S))))

(check-synth)
