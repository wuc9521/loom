(set-logic ALL)
(require "./theories/main.sl")
(require "../common/models/no11.sl")

(synth-fun g () CFG)

(constraint (CFG.Sem g (CFG.Asp p0 0 (size (Pos p0)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p000 0 (size (Pos p000)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p10 0 (size (Pos p10)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p010 0 (size (Pos p010)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p100 0 (size (Pos p100)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p1010 0 (size (Pos p1010)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p10010 0 (size (Pos p10010)) reset.S)))
(constraint (not (CFG.Sem g (CFG.Asp n1 0 (size (Pos n1)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n110 0 (size (Pos n110)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n01 0 (size (Pos n01)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n0101 0 (size (Pos n0101)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n10101 0 (size (Pos n10101)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n100101 0 (size (Pos n100101)) reset.S))))

(check-synth)
