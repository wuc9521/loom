(set-logic ALL)
(require "./theories/main.sl")
(require "../common/models/no10.sl")

(synth-fun g () CFG)

(constraint (CFG.Sem g (CFG.Asp p0 0 (size (Pos p0)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p1 0 (size (Pos p1)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p01 0 (size (Pos p01)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p10 0 (size (Pos p10)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p101 0 (size (Pos p101)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p010 0 (size (Pos p010)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p1010 0 (size (Pos p1010)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p0101 0 (size (Pos p0101)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p10101 0 (size (Pos p10101)) reset.S)))
(constraint (not (CFG.Sem g (CFG.Asp n00 0 (size (Pos n00)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n11 0 (size (Pos n11)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n011 0 (size (Pos n011)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n001 0 (size (Pos n001)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n110 0 (size (Pos n110)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n1001 0 (size (Pos n1001)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n101101 0 (size (Pos n101101)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n010010 0 (size (Pos n010010)) reset.S))))

(check-synth)
