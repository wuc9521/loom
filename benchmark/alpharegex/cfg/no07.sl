(set-logic ALL)
(require "./theories/main.sl")
(require "../common/models/no07.sl")

(synth-fun g () CFG)

(constraint (CFG.Sem g (CFG.Asp p0 0 (size (Pos p0)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p00 0 (size (Pos p00)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p000 0 (size (Pos p000)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p111 0 (size (Pos p111)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p111111 0 (size (Pos p111111)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p10101 0 (size (Pos p10101)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p1001001 0 (size (Pos p1001001)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p100100110010010 0 (size (Pos p100100110010010)) reset.S)))
(constraint (not (CFG.Sem g (CFG.Asp n11 0 (size (Pos n11)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n011 0 (size (Pos n011)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n101 0 (size (Pos n101)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n110 0 (size (Pos n110)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n1111 0 (size (Pos n1111)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n11111 0 (size (Pos n11111)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n1111111 0 (size (Pos n1111111)) reset.S))))

(check-synth)
