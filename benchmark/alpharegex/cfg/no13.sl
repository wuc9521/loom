(set-logic ALL)
(require "./theories/main.sl")
(require "../common/models/no13.sl")

(synth-fun g () CFG)

(constraint (CFG.Sem g (CFG.Asp p0 0 (size (Pos p0)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p1 0 (size (Pos p1)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p00 0 (size (Pos p00)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p11 0 (size (Pos p11)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p10101 0 (size (Pos p10101)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p11011011 0 (size (Pos p11011011)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p111 0 (size (Pos p111)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp p1111 0 (size (Pos p1111)) reset.S)))
(constraint (not (CFG.Sem g (CFG.Asp n000 0 (size (Pos n000)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n11011010 0 (size (Pos n11011010)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n11000 0 (size (Pos n11000)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n00011 0 (size (Pos n00011)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n11010101 0 (size (Pos n11010101)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n0000 0 (size (Pos n0000)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp n101010101 0 (size (Pos n101010101)) reset.S))))

(check-synth)
