(require "./theories/main.sl")
(require "../common/models/no22.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (ReAsp p00 0 (size (Pos p00)))))
(constraint (RegLan.Sem r (ReAsp p01 0 (size (Pos p01)))))
(constraint (RegLan.Sem r (ReAsp p11 0 (size (Pos p11)))))
(constraint (RegLan.Sem r (ReAsp p_00 0 (size (Pos p_00)))))
(constraint (RegLan.Sem r (ReAsp p_01 0 (size (Pos p_01)))))
(constraint (RegLan.Sem r (ReAsp p_11 0 (size (Pos p_11)))))
(constraint (RegLan.Sem r (ReAsp p__00 0 (size (Pos p__00)))))
(constraint (RegLan.Sem r (ReAsp p__01 0 (size (Pos p__01)))))
(constraint (RegLan.Sem r (ReAsp p__11 0 (size (Pos p__11)))))
(constraint (not (RegLan.Sem r (ReAsp n? 0 (size (Pos n?))))))
(constraint (not (RegLan.Sem r (ReAsp n10 0 (size (Pos n10))))))
(constraint (not (RegLan.Sem r (ReAsp n?10 0 (size (Pos n?10))))))
(constraint (not (RegLan.Sem r (ReAsp n??10 0 (size (Pos n??10))))))

(check-synth)
