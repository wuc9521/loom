(require "./theories/main.sl")
(require "../common/models/no10.sl")

(synth-fun regex () RegLan)

(constraint (RegLan.Sem r (ReAsp p0 0 (size (Pos p0)))))
(constraint (RegLan.Sem r (ReAsp p1 0 (size (Pos p1)))))
(constraint (RegLan.Sem r (ReAsp p01 0 (size (Pos p01)))))
(constraint (RegLan.Sem r (ReAsp p10 0 (size (Pos p10)))))
(constraint (RegLan.Sem r (ReAsp p101 0 (size (Pos p101)))))
(constraint (RegLan.Sem r (ReAsp p010 0 (size (Pos p010)))))
(constraint (RegLan.Sem r (ReAsp p1010 0 (size (Pos p1010)))))
(constraint (RegLan.Sem r (ReAsp p0101 0 (size (Pos p0101)))))
(constraint (RegLan.Sem r (ReAsp p10101 0 (size (Pos p10101)))))
(constraint (not (RegLan.Sem r (ReAsp n00 0 (size (Pos n00))))))
(constraint (not (RegLan.Sem r (ReAsp n11 0 (size (Pos n11))))))
(constraint (not (RegLan.Sem r (ReAsp n011 0 (size (Pos n011))))))
(constraint (not (RegLan.Sem r (ReAsp n001 0 (size (Pos n001))))))
(constraint (not (RegLan.Sem r (ReAsp n110 0 (size (Pos n110))))))
(constraint (not (RegLan.Sem r (ReAsp n1001 0 (size (Pos n1001))))))
(constraint (not (RegLan.Sem r (ReAsp n101101 0 (size (Pos n101101))))))
(constraint (not (RegLan.Sem r (ReAsp n010010 0 (size (Pos n010010))))))

(check-synth)
