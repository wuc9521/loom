(require "./theories/main.sl")
(require "../common/models/no18.sl")

(synth-fun regex () RegLan)

(constraint (RegLan.Sem r (ReAsp p0 0 (size (Pos p0)))))
(constraint (RegLan.Sem r (ReAsp p0110 0 (size (Pos p0110)))))
(constraint (RegLan.Sem r (ReAsp p01110 0 (size (Pos p01110)))))
(constraint (RegLan.Sem r (ReAsp p011110 0 (size (Pos p011110)))))
(constraint (RegLan.Sem r (ReAsp p111 0 (size (Pos p111)))))
(constraint (RegLan.Sem r (ReAsp p01111 0 (size (Pos p01111)))))
(constraint (RegLan.Sem r (ReAsp p1111110 0 (size (Pos p1111110)))))
(constraint (not (RegLan.Sem r (ReAsp n00 0 (size (Pos n00))))))
(constraint (not (RegLan.Sem r (ReAsp n010 0 (size (Pos n010))))))
(constraint (not (RegLan.Sem r (ReAsp n10101 0 (size (Pos n10101))))))
(constraint (not (RegLan.Sem r (ReAsp n010111 0 (size (Pos n010111))))))
(constraint (not (RegLan.Sem r (ReAsp n111010 0 (size (Pos n111010))))))
(constraint (not (RegLan.Sem r (ReAsp n0011111 0 (size (Pos n0011111))))))
(constraint (not (RegLan.Sem r (ReAsp n1111100 0 (size (Pos n1111100))))))

(check-synth)
