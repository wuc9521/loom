(require "./theories/main.sl")
(require "../common/models/no24.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (ReAsp p0 0 (size (Pos p0)))))
(constraint (RegLan.Sem r (ReAsp p1 0 (size (Pos p1)))))
(constraint (RegLan.Sem r (ReAsp p01 0 (size (Pos p01)))))
(constraint (RegLan.Sem r (ReAsp p010 0 (size (Pos p010)))))
(constraint (RegLan.Sem r (ReAsp p0101 0 (size (Pos p0101)))))
(constraint (RegLan.Sem r (ReAsp p1010 0 (size (Pos p1010)))))
(constraint (RegLan.Sem r (ReAsp p00111 0 (size (Pos p00111)))))
(constraint (RegLan.Sem r (ReAsp p001100111 0 (size (Pos p001100111)))))
(constraint (RegLan.Sem r (ReAsp p100110011 0 (size (Pos p100110011)))))
(constraint (not (RegLan.Sem r (ReAsp n00 0 (size (Pos n00))))))
(constraint (not (RegLan.Sem r (ReAsp n100 0 (size (Pos n100))))))
(constraint (not (RegLan.Sem r (ReAsp n001 0 (size (Pos n001))))))
(constraint (not (RegLan.Sem r (ReAsp n0010 0 (size (Pos n0010))))))
(constraint (not (RegLan.Sem r (ReAsp n1001 0 (size (Pos n1001))))))
(constraint (not (RegLan.Sem r (ReAsp n11001 0 (size (Pos n11001))))))
(constraint (not (RegLan.Sem r (ReAsp n00101 0 (size (Pos n00101))))))
(constraint (not (RegLan.Sem r (ReAsp n001100 0 (size (Pos n001100))))))
(constraint (not (RegLan.Sem r (ReAsp n1001011 0 (size (Pos n1001011))))))

(check-synth)
