(require "./theories/main.sl")
(require "../common/models/no08.sl")

(synth-fun regex () RegLan)

(constraint (RegLan.Sem r (ReAsp p0 0 (size (Pos p0)))))
(constraint (RegLan.Sem r (ReAsp p11 0 (size (Pos p11)))))
(constraint (RegLan.Sem r (ReAsp p01010 0 (size (Pos p01010)))))
(constraint (RegLan.Sem r (ReAsp p00100100 0 (size (Pos p00100100)))))
(constraint (RegLan.Sem r (ReAsp p1111 0 (size (Pos p1111)))))
(constraint (RegLan.Sem r (ReAsp p010101010 0 (size (Pos p010101010)))))
(constraint (RegLan.Sem r (ReAsp p00100100100100 0 (size (Pos p00100100100100)))))
(constraint (not (RegLan.Sem r (ReAsp n1 0 (size (Pos n1))))))
(constraint (not (RegLan.Sem r (ReAsp n01 0 (size (Pos n01))))))
(constraint (not (RegLan.Sem r (ReAsp n10 0 (size (Pos n10))))))
(constraint (not (RegLan.Sem r (ReAsp n100 0 (size (Pos n100))))))
(constraint (not (RegLan.Sem r (ReAsp n111 0 (size (Pos n111))))))
(constraint (not (RegLan.Sem r (ReAsp n0101010 0 (size (Pos n0101010))))))
(constraint (not (RegLan.Sem r (ReAsp n11111 0 (size (Pos n11111))))))

(check-synth)
