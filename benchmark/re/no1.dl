(set-logic ALL)

(declare-sort Pos 0)

; define signatures here.
(declare-fun a (Pos) Bool)
(declare-fun b (Pos) Bool)


; ab
(define-model w1
  (define-univ Pos ($0 $1))
  (interp-fun a (match (
      (($0) true)
      ((_) false)
  )))
  (interp-fun b (match (
      (($0) false)
      ((_) true)
  )))
)

; abab
(define-model w2
  (define-univ Pos ($0 $1 $2 $3))
  (interp-fun a (match (
      (($0) true)
      (($2) true)
      ((_) false)
  )))
  (interp-fun b (match (
      (($1) true)
      (($3) true)
      ((_) false)
  )))
)

; ababab
(define-model w3
  (define-univ Pos ($0 $1 $2 $3 $4 $5))
  (interp-fun a (match (
      (($0) true)
      (($2) true)
      (($4) true)
      ((_) false)
  )))
  (interp-fun b (match (
      (($1) true)
      (($3) true)
      (($5) true)
      ((_) false)
  )))
)


; baa
(define-model w4
  (define-univ Pos ($0 $1 $2))
  (interp-fun a (match (
      (($0) false)
      ((_) true)
  )))
  (interp-fun b (match (
      (($0) true)
      (($1) true)
      ((_) false)
  )))
)

; aab
(define-model w5
  (define-univ Pos ($0 $1 $2))
  (interp-fun a (match (
      (($0) true)
      ((_) false)
  )))   
  (interp-fun b (match (
      (($0) true)
      (($1) true)
      ((_) false)
  )))
)


(declare-term-types
 ((RegLan 0))
 (((re.a) (re.b)
   (re.++ RegLan RegLan)
   (re.union RegLan RegLan)
   (re.inter RegLan RegLan)
   (re.comp RegLan)
   (re.* RegLan))))


(define-finite ReAsp
  (record (model Model) (i Int) (j Int))
  :where (and (<= 0 i) (<= i j) (<= j (len model))))

(define-semantics
  ((RegLan.Sem (r RegLan) (asp ReAsp)))
  ((match r
     ((re.a) (and (= (j asp) (+ (i asp) 1)) (a (i asp))))
     ((re.b) (and (= (j asp) (+ (i asp) 1)) (b (i asp))))
     ((re.++ x y)
      (exists ((k (int-range (i asp) (j asp))))
        (and (RegLan.Sem x (ReAsp (model asp) (i asp) k))
             (RegLan.Sem y (ReAsp (model asp) k (j asp))))))
     ((re.union x y)
      (or (RegLan.Sem x asp) (RegLan.Sem y asp)))
     ((re.inter x y)
      (and (RegLan.Sem x asp) (RegLan.Sem y asp)))
     ((re.comp x)
      (dual (RegLan.Sem x asp)))
     ((re.* x)
      (or (= (i asp) (j asp))
          (exists ((k (int-range (+ (i asp) 1) (j asp))))
            (and (RegLan.Sem x (ReAsp (model asp) (i asp) k))
                 (RegLan.Sem r (ReAsp (model asp) k (j asp))))))))))

(synth-fun regex () RegLan)
(constraint (RegLan.Sem regex (ReAsp w1 0 (len w1))))        
(constraint (RegLan.Sem regex (ReAsp w2 0 (len w2))))        
(constraint (RegLan.Sem regex (ReAsp w3 0 (len w3))))        
(constraint (not (RegLan.Sem regex (ReAsp w4 0 (len w4)))))        
(constraint (not (RegLan.Sem regex (ReAsp w5 0 (len w5)))))        

(check-synth)
