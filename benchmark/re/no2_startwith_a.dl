(declare-sort Pos 0)
(declare-fun X (Pos) Bool)
(declare-fun a (Pos) Bool)
(declare-fun b (Pos) Bool)
(define-model wb (define-univ Pos ($0)) (interp-fun a (match ((($0) true)))) )
(define-model w2 (define-univ Pos ($0 $1)) (interp-fun X (match ((($0) false) (($1) true)))) (interp-fun a (match ((($0) true) (($1) false)))) )
(define-model w3 (define-univ Pos ($0 $1 $2)) (interp-fun X (match ((($0) false) (($1) true) (($2) true)))) (interp-fun a (match ((($0) true) (($1) false) (($2) false)))) )
(define-model w4 (define-univ Pos ($0)) (interp-fun X (match ((($0) false)))) (interp-fun a (match ((($0) false)))) (interp-fun b (match ((($0) true)))) )
(define-model w5 (define-univ Pos ($0 $1)) (interp-fun X (match ((($0) false) (($1) true)))) (interp-fun b (match ((($0) true) (($1) false)))) (interp-fun a (match ((($0) false) (($1) false)))) )
(define-model w6 (define-univ Pos ($0 $1 $2)) (interp-fun X (match ((($0) false) (($1) true) (($2) true)))) (interp-fun b (match ((($0) true) (($1) false) (($2) false)))) (interp-fun a (match ((($0) false) (($1) false) (($2) false)))) )
(set-logic ALL)
(set-logic ALL)

(declare-term-types
 ((RegLan 0))
 (((a) (b) (X) (re.a) (re.b)
   (re.++ RegLan RegLan)
   (re.union RegLan RegLan)
   (re.inter RegLan RegLan)
   (re.comp RegLan)
   (re.* RegLan))))


(define-finite ReAsp
  (record (model Model) (i Int) (j Int))
  :where (and (<= 0 i) (<= i j) (<= j (len (Pos model)))))

(define-semantics
  ((RegLan.Sem (r RegLan) (asp ReAsp)))
  ((match r
     ((a) (and (= (j asp) (+ (i asp) 1)) (a (i asp))))
     ((b) (and (= (j asp) (+ (i asp) 1)) (b (i asp))))
     ((X) (and (= (j asp) (+ (i asp) 1)) (X (i asp))))
     ((re.a) (and (= (j asp) (+ (i asp) 1)) (a (i asp))))
     ((re.b) (and (= (j asp) (+ (i asp) 1)) (b (i asp))))
     ((re.++ x y)
      (exists ((k (int-range (i asp) (j asp))))
        (and (RegLan.Sem x (ReAsp (model asp) (i asp) k))
             (RegLan.Sem y (ReAsp (model asp) k (j asp))))))
     ((re.union x y)
      (or (RegLan.Sem x asp) (RegLan.Sem y asp)))
     ((re.inter x y)
      (and (RegLan.Sem x asp) (RegLan.Sem y asp)))
     ((re.comp x)
      (not (RegLan.Sem x asp)))
     ((re.* x)
      (or (= (i asp) (j asp))
          (exists ((k (int-range (+ (i asp) 1) (j asp))))
            (and (RegLan.Sem x (ReAsp (model asp) (i asp) k))
                 (RegLan.Sem r (ReAsp (model asp) k (j asp))))))))))

(synth-fun regex () RegLan  ((Start RegLan)) ((Start RegLan (a b X (re.++ Start Start) (re.union Start Start) (re.inter Start Start) (re.* Start)))))
(constraint (RegLan.Sem regex (ReAsp wb 0 (len (Pos wb)))))
(constraint (RegLan.Sem regex (ReAsp w2 0 (len (Pos w2)))))
(constraint (RegLan.Sem regex (ReAsp w3 0 (len (Pos w3)))))
(constraint (not (RegLan.Sem regex (ReAsp w4 0 (len (Pos w4))))))
(constraint (not (RegLan.Sem regex (ReAsp w5 0 (len (Pos w5))))))
(constraint (not (RegLan.Sem regex (ReAsp w6 0 (len (Pos w6))))))
(check-synth)
