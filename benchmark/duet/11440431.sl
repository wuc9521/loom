  (define-univ Chr (cPad cSpace cA cC cE cF cM cN cO cS cU ca cb cc ce cg ch ci cl cm cn co cr cs ct cx cy))
  (interp-fun in.len ($9))
  (interp-fun out.len ($6))
  (interp-fun in.suffix.us (true))
  (interp-fun in.suffix.can (false))
  (interp-fun in.chr (match (
    (($0) cM) (($1) ci) (($2) cn) (($3) ci) (($4) cn) (($5) cg)
    (($6) cSpace) (($7) cU) (($8) cS)
    ((_) cPad)
  )))
  (interp-fun out.chr (match (
    (($0) cM) (($1) ci) (($2) cn) (($3) ci) (($4) cn) (($5) cg)
    ((_) cPad)
  )))
  (interp-fun plus.idx (match (
    (($1 $1) $2) (($2 $2) $4)
    ((_ _) bot)
  )))
  (interp-fun minus.idx (match (
    (($9 $3) $6) (($9 $0) $9)
    ((_ _) bot)
  )))
  (interp-fun idx.lt (match (
    (($0 $1) true)
    (($0 $2) true) (($1 $2) true)
    (($0 $3) true) (($1 $3) true) (($2 $3) true)
    (($0 $4) true) (($1 $4) true) (($2 $4) true) (($3 $4) true)
    (($0 $6) true) (($1 $6) true) (($2 $6) true) (($3 $6) true) (($4 $6) true) (($5 $6) true)
    (($0 $9) true) (($1 $9) true) (($2 $9) true) (($3 $9) true) (($4 $9) true) (($5 $9) true) (($6 $9) true) (($7 $9) true) (($8 $9) true)
    ((_ _) false)
  )))
)

