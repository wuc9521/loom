(provide Str Idx Chr StrProg IdxProg BoolProg ExAsp CharAsp
  StrProg.Len StrProg.Char StrProg.OutEq IdxProg.Sem BoolProg.Sem
  in.len out.len in.chr out.chr plus.idx minus.idx idx.lt in.suffix.us in.suffix.can
  arg0 lit.empty lit.space lit.us lit.can
  str.++.p str.replace.p str.at.p int.to.str.p ite.str str.substr.p
  idx.0 idx.1 idx.bot plus minus str.len.p str.to.int.p ite.idx str.indexof.p
  bool.true bool.false eq.idx str.prefixof.p str.suffixof.p str.contains.p)
(set-logic ALL)

(declare-sort Str 0)
(declare-sort Idx 0)
(declare-sort Chr 0)

(declare-fun in.len () Idx)
(declare-fun out.len () Idx)
(declare-fun in.chr (Idx) Chr)
(declare-fun out.chr (Idx) Chr)
(declare-fun plus.idx (Idx Idx) Idx)
(declare-fun minus.idx (Idx Idx) Idx)
(declare-fun idx.lt (Idx Idx) Bool)
(declare-fun in.suffix.us () Bool)
(declare-fun in.suffix.can () Bool)

(declare-term-types
 ((StrProg 0) (IdxProg 0) (BoolProg 0))
 (((arg0)
   (lit.empty)
   (lit.space)
   (lit.us)
   (lit.can)
   (str.++.p StrProg StrProg)
   (str.replace.p StrProg StrProg StrProg)
   (str.at.p StrProg IdxProg)
   (int.to.str.p IdxProg)
   (ite.str BoolProg StrProg StrProg)
   (str.substr.p StrProg IdxProg IdxProg))
  ((idx.0)
   (idx.1)
   (idx.bot)
   (plus IdxProg IdxProg)
   (minus IdxProg IdxProg)
   (str.len.p StrProg)
   (str.to.int.p StrProg)
   (ite.idx BoolProg IdxProg IdxProg)
   (str.indexof.p StrProg StrProg IdxProg))
  ((bool.true)
   (bool.false)
   (eq.idx IdxProg IdxProg)
   (str.prefixof.p StrProg StrProg)
   (str.suffixof.p StrProg StrProg)
   (str.contains.p StrProg StrProg))))

(define-finite ExAsp
  (record (model Model)))

(define-finite CharAsp
  (record (model Model) (k Idx)))

(define-semantics
  ((IdxProg.Sem (p IdxProg) (asp ExAsp)))
  :returns Idx
  ((match p
     ((idx.0) $0)
     ((idx.1) $1)
     ((idx.bot) bot)
     ((plus x y)
      (plus.idx (IdxProg.Sem x asp) (IdxProg.Sem y asp)))
     ((minus x y)
      (minus.idx (IdxProg.Sem x asp) (IdxProg.Sem y asp)))
     ((str.len.p s)
      (StrProg.Len s asp))
     ((str.to.int.p s)
      bot)
     ((ite.idx b x y)
      (ite (BoolProg.Sem b asp)
           (IdxProg.Sem x asp)
           (IdxProg.Sem y asp)))
     ((str.indexof.p s t i)
      bot))))

(define-semantics
  ((BoolProg.Sem (p BoolProg) (asp ExAsp)))
  ((match p
     ((bool.true) true)
     ((bool.false) false)
     ((eq.idx x y)
      (= (IdxProg.Sem x asp) (IdxProg.Sem y asp)))
     ((str.prefixof.p x y)
      false)
     ((str.suffixof.p lit.us arg0)
      in.suffix.us)
     ((str.suffixof.p lit.can arg0)
      in.suffix.can)
     ((str.suffixof.p x y)
      false)
     ((str.contains.p x y)
      false))))

(define-semantics
  ((StrProg.Len (p StrProg) (asp ExAsp)))
  :returns Idx
  ((match p
     ((arg0) in.len)
     ((lit.empty) $0)
     ((lit.space) $1)
     ((lit.us) $2)
     ((lit.can) $3)
     ((str.++.p x y) bot)
     ((str.replace.p s old new) bot)
     ((str.at.p s i) bot)
     ((int.to.str.p i) bot)
     ((ite.str b x y)
      (ite (BoolProg.Sem b asp)
           (StrProg.Len x asp)
           (StrProg.Len y asp)))
     ((str.substr.p s i n)
      (ite (= (IdxProg.Sem i asp) $0)
           (IdxProg.Sem n asp)
           bot)))))

(define-semantics
  ((StrProg.Char (p StrProg) (asp CharAsp)))
  :returns Chr
  ((match p
     ((arg0) (in.chr (k asp)))
     ((lit.empty) cPad)
     ((lit.space)
      (ite (= (k asp) $0) cSpace cPad))
     ((lit.us)
      (ite (= (k asp) $0) cU
        (ite (= (k asp) $1) cS cPad)))
     ((lit.can)
      (ite (= (k asp) $0) cC
        (ite (= (k asp) $1) cA
          (ite (= (k asp) $2) cN cPad))))
     ((str.++.p x y) cPad)
     ((str.replace.p s old new) cPad)
     ((str.at.p s i) cPad)
     ((int.to.str.p i) cPad)
     ((ite.str b x y)
      (ite (BoolProg.Sem b (ExAsp (model asp)))
           (StrProg.Char x asp)
           (StrProg.Char y asp)))
     ((str.substr.p s i n)
      (ite (= (IdxProg.Sem i (ExAsp (model asp))) $0)
           (ite (idx.lt (k asp) (IdxProg.Sem n (ExAsp (model asp))))
                (StrProg.Char s asp)
                cPad)
           cPad)))))

(define-semantics
  ((StrProg.OutEq (p StrProg) (asp ExAsp)))
  ((match p
     ((arg0)
      (and
        (= in.len out.len)
        (= (in.chr $0) (out.chr $0))
        (= (in.chr $1) (out.chr $1))
        (= (in.chr $2) (out.chr $2))
        (= (in.chr $3) (out.chr $3))
        (= (in.chr $4) (out.chr $4))
        (= (in.chr $5) (out.chr $5))
        (= (in.chr $6) (out.chr $6))
        (= (in.chr $7) (out.chr $7))
        (= (in.chr $8) (out.chr $8))
        (= (in.chr $9) (out.chr $9))
        (= (in.chr $10) (out.chr $10))
        (= (in.chr $11) (out.chr $11))
        (= (in.chr $12) (out.chr $12))
        (= (in.chr $13) (out.chr $13))
        (= (in.chr $14) (out.chr $14))
        (= (in.chr $15) (out.chr $15))
        (= (in.chr $16) (out.chr $16))
        (= (in.chr $17) (out.chr $17))
        (= (in.chr $18) (out.chr $18))
        (= (in.chr $19) (out.chr $19))))
     ((lit.empty) false)
     ((lit.space) false)
     ((lit.us) false)
     ((lit.can) false)
     ((str.++.p x y) false)
     ((str.replace.p s old new) false)
     ((str.at.p s i) false)
     ((int.to.str.p i) false)
     ((ite.str b x y)
      (ite (BoolProg.Sem b asp)
           (StrProg.OutEq x asp)
           (StrProg.OutEq y asp)))
     ((str.substr.p s i n)
      (and
        (= out.len (ite (= (IdxProg.Sem i asp) $0) (IdxProg.Sem n asp) bot))
        (= (out.chr $0) (ite (idx.lt $0 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $0)) cPad))
        (= (out.chr $1) (ite (idx.lt $1 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $1)) cPad))
        (= (out.chr $2) (ite (idx.lt $2 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $2)) cPad))
        (= (out.chr $3) (ite (idx.lt $3 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $3)) cPad))
        (= (out.chr $4) (ite (idx.lt $4 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $4)) cPad))
        (= (out.chr $5) (ite (idx.lt $5 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $5)) cPad))
        (= (out.chr $6) (ite (idx.lt $6 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $6)) cPad))
        (= (out.chr $7) (ite (idx.lt $7 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $7)) cPad))
        (= (out.chr $8) (ite (idx.lt $8 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $8)) cPad))
        (= (out.chr $9) (ite (idx.lt $9 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $9)) cPad))
        (= (out.chr $10) (ite (idx.lt $10 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $10)) cPad))
        (= (out.chr $11) (ite (idx.lt $11 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $11)) cPad))
        (= (out.chr $12) (ite (idx.lt $12 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $12)) cPad))
        (= (out.chr $13) (ite (idx.lt $13 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $13)) cPad))
        (= (out.chr $14) (ite (idx.lt $14 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $14)) cPad))
        (= (out.chr $15) (ite (idx.lt $15 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $15)) cPad))
        (= (out.chr $16) (ite (idx.lt $16 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $16)) cPad))
        (= (out.chr $17) (ite (idx.lt $17 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $17)) cPad))
        (= (out.chr $18) (ite (idx.lt $18 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $18)) cPad))
        (= (out.chr $19) (ite (idx.lt $19 (IdxProg.Sem n asp)) (StrProg.Char s (CharAsp (model asp) $19)) cPad)))))))
