(set-logic ALL)

(declare-sort U 0)
(declare-fun p (U) Bool)
(declare-fun Next (U U) Bool)

(define-model w-pos
  (define-univ U ($0 $1))
  (interp-fun p (match (
    (($1) true)
    ((_) false)
  )))
  (interp-fun Next (match (
    (($0 $1) true)
    (($1 $1) true)
    ((_ _) false)
  ))))

(define-model w-neg
  (define-univ U ($0 $1))
  (interp-fun p (match (
    ((_) false)
  )))
  (interp-fun Next (match (
    (($0 $1) true)
    (($1 $1) true)
    ((_ _) false)
  ))))

(declare-term-types
 ((LTL 0))
 (((p)
   (ltl.not LTL)
   (ltl.and LTL LTL)
   (ltl.or LTL LTL)
   (ltl.next LTL))))

(define-finite LtlAsp
  (record (model Model) (pos U))
  :where true)

(define-semantics
  ((Ltl.Sem (phi LTL) (asp LtlAsp)))
  ((match phi
     ((p) (p (pos asp)))
     ((ltl.not x) (not (Ltl.Sem x asp)))
     ((ltl.and x y) (and (Ltl.Sem x asp) (Ltl.Sem y asp)))
     ((ltl.or x y) (or (Ltl.Sem x asp) (Ltl.Sem y asp)))
     ((ltl.next x)
      (exists ((next (domain (U (model asp)))))
        (and (Next (pos asp) next)
             (Ltl.Sem x (LtlAsp (model asp) next))))))))

(synth-fun phi () LTL)
(constraint (Ltl.Sem phi (LtlAsp w-pos $0)))
(constraint (not (Ltl.Sem phi (LtlAsp w-neg $0))))
(check-synth)
