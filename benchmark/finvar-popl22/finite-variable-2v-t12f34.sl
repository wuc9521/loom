(require "theories/common-t12f34.sl")

(declare-term-types
 ((FO2.Formula 0) (FO2.Formula.x0 0) (FO2.Formula.x0.x1 0) (FO2.TermU 0) (FO2.TermU.x0 0) (FO2.TermU.x0.x1 0))
 (((FO2.true)
   (FO2.false)
   (FO2.not FO2.Formula)
   (FO2.and FO2.Formula FO2.Formula)
   (FO2.or FO2.Formula FO2.Formula)
   (FO2.forall.x0.U FO2.Formula.x0)
   (FO2.exists.x0.U FO2.Formula.x0)
   (FO2.eq.U FO2.TermU FO2.TermU)
   (FO2.atom.E FO2.TermU FO2.TermU))
  ((FO2.ctx-x0.true)
   (FO2.ctx-x0.false)
   (FO2.ctx-x0.not FO2.Formula.x0)
   (FO2.ctx-x0.and FO2.Formula.x0 FO2.Formula.x0)
   (FO2.ctx-x0.or FO2.Formula.x0 FO2.Formula.x0)
   (FO2.ctx-x0.forall.x0.U FO2.Formula.x0)
   (FO2.ctx-x0.exists.x0.U FO2.Formula.x0)
   (FO2.ctx-x0.forall.x1.U FO2.Formula.x0.x1)
   (FO2.ctx-x0.exists.x1.U FO2.Formula.x0.x1)
   (FO2.ctx-x0.eq.U FO2.TermU.x0 FO2.TermU.x0)
   (FO2.ctx-x0.atom.E FO2.TermU.x0 FO2.TermU.x0))
  ((FO2.ctx-x0-x1.true)
   (FO2.ctx-x0-x1.false)
   (FO2.ctx-x0-x1.not FO2.Formula.x0.x1)
   (FO2.ctx-x0-x1.and FO2.Formula.x0.x1 FO2.Formula.x0.x1)
   (FO2.ctx-x0-x1.or FO2.Formula.x0.x1 FO2.Formula.x0.x1)
   (FO2.ctx-x0-x1.forall.x0.U FO2.Formula.x0.x1)
   (FO2.ctx-x0-x1.exists.x0.U FO2.Formula.x0.x1)
   (FO2.ctx-x0-x1.forall.x1.U FO2.Formula.x0.x1)
   (FO2.ctx-x0-x1.exists.x1.U FO2.Formula.x0.x1)
   (FO2.ctx-x0-x1.eq.U FO2.TermU.x0.x1 FO2.TermU.x0.x1)
   (FO2.ctx-x0-x1.atom.E FO2.TermU.x0.x1 FO2.TermU.x0.x1))
  ((FO2.term.s)
   (FO2.term.t))
  ((FO2.ctx-x0.var)
   (FO2.ctx-x0.term.s)
   (FO2.ctx-x0.term.t))
  ((FO2.ctx-x0-x1.var.x0)
   (FO2.ctx-x0-x1.var.x1)
   (FO2.ctx-x0-x1.term.s)
   (FO2.ctx-x0-x1.term.t))))

(define-finite FO2.Asp (record (model Model)))
(define-finite FO2.Asp.x0 (record (model Model) (x0 U)))
(define-finite FO2.Asp.x0.x1 (record (model Model) (x0 U) (x1 U)))

(define-semantics
  ((FO2.TermU.Sem (term FO2.TermU) (asp FO2.Asp)))
  :returns U
  ((match term
     ((FO2.term.s) s)
     ((FO2.term.t) t))))

(define-semantics
  ((FO2.TermU.x0.Sem (term FO2.TermU.x0) (asp FO2.Asp.x0)))
  :returns U
  ((match term
     ((FO2.ctx-x0.var) (x0 asp))
     ((FO2.ctx-x0.term.s) s)
     ((FO2.ctx-x0.term.t) t))))

(define-semantics
  ((FO2.TermU.x0.x1.Sem (term FO2.TermU.x0.x1) (asp FO2.Asp.x0.x1)))
  :returns U
  ((match term
     ((FO2.ctx-x0-x1.var.x0) (x0 asp))
     ((FO2.ctx-x0-x1.var.x1) (x1 asp))
     ((FO2.ctx-x0-x1.term.s) s)
     ((FO2.ctx-x0-x1.term.t) t))))

(define-semantics
  ((FO2.Sem (phi FO2.Formula) (asp FO2.Asp)))
  ((match phi
     ((FO2.true) true)
     ((FO2.false) false)
     ((FO2.not psi) (not (FO2.Sem psi asp)))
     ((FO2.and psi1 psi2) (and (FO2.Sem psi1 asp) (FO2.Sem psi2 asp)))
     ((FO2.or psi1 psi2) (or (FO2.Sem psi1 asp) (FO2.Sem psi2 asp)))
     ((FO2.forall.x0.U psi)
      (forall ((v (domain (U (model asp)))))
        (FO2.ctx-x0.Sem psi (FO2.Asp.x0 (model asp) v))))
     ((FO2.exists.x0.U psi)
      (exists ((v (domain (U (model asp)))))
        (FO2.ctx-x0.Sem psi (FO2.Asp.x0 (model asp) v))))
     ((FO2.eq.U lhs rhs)
      (= (FO2.TermU.Sem lhs asp) (FO2.TermU.Sem rhs asp)))
     ((FO2.atom.E lhs rhs)
      (E (FO2.TermU.Sem lhs asp) (FO2.TermU.Sem rhs asp))))))

(define-semantics
  ((FO2.ctx-x0.Sem (phi FO2.Formula.x0) (asp FO2.Asp.x0)))
  ((match phi
     ((FO2.ctx-x0.true) true)
     ((FO2.ctx-x0.false) false)
     ((FO2.ctx-x0.not psi) (not (FO2.ctx-x0.Sem psi asp)))
     ((FO2.ctx-x0.and psi1 psi2) (and (FO2.ctx-x0.Sem psi1 asp) (FO2.ctx-x0.Sem psi2 asp)))
     ((FO2.ctx-x0.or psi1 psi2) (or (FO2.ctx-x0.Sem psi1 asp) (FO2.ctx-x0.Sem psi2 asp)))
     ((FO2.ctx-x0.forall.x0.U psi)
      (forall ((v (domain (U (model asp)))))
        (FO2.ctx-x0.Sem psi (FO2.Asp.x0 (model asp) v))))
     ((FO2.ctx-x0.exists.x0.U psi)
      (exists ((v (domain (U (model asp)))))
        (FO2.ctx-x0.Sem psi (FO2.Asp.x0 (model asp) v))))
     ((FO2.ctx-x0.forall.x1.U psi)
      (forall ((v (domain (U (model asp)))))
        (FO2.ctx-x0-x1.Sem psi (FO2.Asp.x0.x1 (model asp) (x0 asp) v))))
     ((FO2.ctx-x0.exists.x1.U psi)
      (exists ((v (domain (U (model asp)))))
        (FO2.ctx-x0-x1.Sem psi (FO2.Asp.x0.x1 (model asp) (x0 asp) v))))
     ((FO2.ctx-x0.eq.U lhs rhs)
      (= (FO2.TermU.x0.Sem lhs asp) (FO2.TermU.x0.Sem rhs asp)))
     ((FO2.ctx-x0.atom.E lhs rhs)
      (E (FO2.TermU.x0.Sem lhs asp) (FO2.TermU.x0.Sem rhs asp))))))

(define-semantics
  ((FO2.ctx-x0-x1.Sem (phi FO2.Formula.x0.x1) (asp FO2.Asp.x0.x1)))
  ((match phi
     ((FO2.ctx-x0-x1.true) true)
     ((FO2.ctx-x0-x1.false) false)
     ((FO2.ctx-x0-x1.not psi) (not (FO2.ctx-x0-x1.Sem psi asp)))
     ((FO2.ctx-x0-x1.and psi1 psi2) (and (FO2.ctx-x0-x1.Sem psi1 asp) (FO2.ctx-x0-x1.Sem psi2 asp)))
     ((FO2.ctx-x0-x1.or psi1 psi2) (or (FO2.ctx-x0-x1.Sem psi1 asp) (FO2.ctx-x0-x1.Sem psi2 asp)))
     ((FO2.ctx-x0-x1.forall.x0.U psi)
      (forall ((v (domain (U (model asp)))))
        (FO2.ctx-x0-x1.Sem psi (FO2.Asp.x0.x1 (model asp) v (x1 asp)))))
     ((FO2.ctx-x0-x1.exists.x0.U psi)
      (exists ((v (domain (U (model asp)))))
        (FO2.ctx-x0-x1.Sem psi (FO2.Asp.x0.x1 (model asp) v (x1 asp)))))
     ((FO2.ctx-x0-x1.forall.x1.U psi)
      (forall ((v (domain (U (model asp)))))
        (FO2.ctx-x0-x1.Sem psi (FO2.Asp.x0.x1 (model asp) (x0 asp) v))))
     ((FO2.ctx-x0-x1.exists.x1.U psi)
      (exists ((v (domain (U (model asp)))))
        (FO2.ctx-x0-x1.Sem psi (FO2.Asp.x0.x1 (model asp) (x0 asp) v))))
     ((FO2.ctx-x0-x1.eq.U lhs rhs)
      (= (FO2.TermU.x0.x1.Sem lhs asp) (FO2.TermU.x0.x1.Sem rhs asp)))
     ((FO2.ctx-x0-x1.atom.E lhs rhs)
      (E (FO2.TermU.x0.x1.Sem lhs asp) (FO2.TermU.x0.x1.Sem rhs asp))))))

(synth-fun phi () FO2.Formula)

(constraint (FO2.Sem phi (FO2.Asp G1)))
(constraint (FO2.Sem phi (FO2.Asp G2)))
(constraint (not (FO2.Sem phi (FO2.Asp G3))))
(constraint (not (FO2.Sem phi (FO2.Asp G4))))

(check-synth)
