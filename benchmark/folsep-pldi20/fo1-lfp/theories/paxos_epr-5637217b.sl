     ((fol.ctx-x0-value.atom.le a0 a1) (le (Term.x0.value.round.Sem a0 (FoAsp.x0.value (model asp) (x0 asp))) (Term.x0.value.round.Sem a1 (FoAsp.x0.value (model asp) (x0 asp)))))
