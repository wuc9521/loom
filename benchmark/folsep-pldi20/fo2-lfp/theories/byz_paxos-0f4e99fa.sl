     ((fol.ctx-x1-value.eq.round lhs rhs)
      (= (Term.x1.value.round.Sem lhs (FoAsp.x1.value (model asp) (x1 asp))) (Term.x1.value.round.Sem rhs (FoAsp.x1.value (model asp) (x1 asp)))))
     ((fol.ctx-x1-value.eq.value lhs rhs)
      (= (Term.x1.value.value.Sem lhs (FoAsp.x1.value (model asp) (x1 asp))) (Term.x1.value.value.Sem rhs (FoAsp.x1.value (model asp) (x1 asp)))))
     ((fol.ctx-x1-value.atom.le a0 a1) (le (Term.x1.value.round.Sem a0 (FoAsp.x1.value (model asp) (x1 asp))) (Term.x1.value.round.Sem a1 (FoAsp.x1.value (model asp) (x1 asp)))))
     ((fol.ctx-x1-value.atom.one_a a0) (one_a (Term.x1.value.round.Sem a0 (FoAsp.x1.value (model asp) (x1 asp)))))
     ((fol.ctx-x1-value.atom.proposal a0 a1) (proposal (Term.x1.value.round.Sem a0 (FoAsp.x1.value (model asp) (x1 asp))) (Term.x1.value.value.Sem a1 (FoAsp.x1.value (model asp) (x1 asp)))))
  )))

(define-semantics
  ((FO.x1.value.FindLfp (phi Formula.x1.value) (asp FoAsp.x1.value.lfp)))
  ((match phi
     ((fol.ctx-x1-value.true) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.false) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.not p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.and p q) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.or p q) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.lfp p) (FO.x1.value.LfpSem p (FoAsp.x1.value.lfp (model asp) (x1 asp) (fuel asp))))
     ((fol.ctx-x1-value.atom.rec a0) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.forall.x0.node p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.exists.x0.node p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.forall.x0.quorum_c p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.exists.x0.quorum_c p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.forall.x0.quorum_w p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.exists.x0.quorum_w p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.forall.x0.round p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.exists.x0.round p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.forall.x0.value p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.exists.x0.value p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.forall.x1.node p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.exists.x1.node p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.forall.x1.quorum_c p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.exists.x1.quorum_c p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.forall.x1.quorum_w p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.exists.x1.quorum_w p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.forall.x1.round p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.exists.x1.round p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.forall.x1.value p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.exists.x1.value p) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.eq.round lhs rhs) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.eq.value lhs rhs) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.atom.le a0 a1) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.atom.one_a a0) (FO.x1.value.FindLfp (parent phi) asp))
     ((fol.ctx-x1-value.atom.proposal a0 a1) (FO.x1.value.FindLfp (parent phi) asp))
  )))
