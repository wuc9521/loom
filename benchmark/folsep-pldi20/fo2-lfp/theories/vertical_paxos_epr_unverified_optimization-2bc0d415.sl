     ((fol.ctx-x1-value.exists.x1.value p)
      (exists ((v (domain (value (model asp)))))
        (FO.x1.value.LfpSem p (FoAsp.x1.value.lfp (model asp) v (fuel asp)))))
     ((fol.ctx-x1-value.eq.quorum lhs rhs)
      (= (Term.x1.value.quorum.Sem lhs (FoAsp.x1.value (model asp) (x1 asp))) (Term.x1.value.quorum.Sem rhs (FoAsp.x1.value (model asp) (x1 asp)))))
     ((fol.ctx-x1-value.eq.round lhs rhs)
      (= (Term.x1.value.round.Sem lhs (FoAsp.x1.value (model asp) (x1 asp))) (Term.x1.value.round.Sem rhs (FoAsp.x1.value (model asp) (x1 asp)))))
     ((fol.ctx-x1-value.eq.value lhs rhs)
