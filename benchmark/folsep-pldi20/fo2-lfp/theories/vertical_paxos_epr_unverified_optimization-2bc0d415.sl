     ((fol.ctx-x1-value.atom.irrelevant_msg a0) (irrelevant_msg (Term.x1.value.round.Sem a0 (FoAsp.x1.value (model asp) (x1 asp)))))
     ((fol.ctx-x1-value.atom.le a0 a1) (le (Term.x1.value.round.Sem a0 (FoAsp.x1.value (model asp) (x1 asp))) (Term.x1.value.round.Sem a1 (FoAsp.x1.value (model asp) (x1 asp)))))
     ((fol.ctx-x1-value.atom.one_a a0 a1) (one_a (Term.x1.value.round.Sem a0 (FoAsp.x1.value (model asp) (x1 asp))) (Term.x1.value.round.Sem a1 (FoAsp.x1.value (model asp) (x1 asp)))))
     ((fol.ctx-x1-value.atom.proposal a0 a1) (proposal (Term.x1.value.round.Sem a0 (FoAsp.x1.value (model asp) (x1 asp))) (Term.x1.value.value.Sem a1 (FoAsp.x1.value (model asp) (x1 asp)))))
