(provide config node quorum round value master_minrel none quorum_of_round configure_round_msg decision irrelevant_msg joined_round le left_rnd member minrelof one_a one_b_max_vote proposal quorumin vote)
(set-logic ALL)
(declare-sort config 0)
(declare-sort node 0)
(declare-sort quorum 0)
(declare-sort round 0)
(declare-sort value 0)
(declare-fun master_minrel () round)
(declare-fun none () round)
(declare-fun quorum_of_round (round) quorum)
(declare-fun configure_round_msg (round config) Bool)
(declare-fun decision (node round value) Bool)
(declare-fun irrelevant_msg (round) Bool)
(declare-fun joined_round (node round) Bool)
(declare-fun le (round round) Bool)
(declare-fun left_rnd (node round) Bool)
(declare-fun member (node quorum) Bool)
(declare-fun minrelof (config round) Bool)
(declare-fun one_a (round round) Bool)
(declare-fun one_b_max_vote (node round round value) Bool)
(declare-fun proposal (round value) Bool)
(declare-fun quorumin (quorum config) Bool)
(declare-fun vote (node round value) Bool)
