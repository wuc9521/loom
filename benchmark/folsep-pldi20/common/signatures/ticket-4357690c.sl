(provide ticket_protocol.thread ticket_protocol.ticket ticket_protocol.next_ticket ticket_protocol.service ticket_protocol.tp1.sk0 ticket_protocol.zero ticket_protocol.le ticket_protocol.m ticket_protocol.pc1 ticket_protocol.pc2 ticket_protocol.pc3 ticket_protocol.scheduled)
(set-logic ALL)
(declare-sort ticket_protocol.thread 0)
(declare-sort ticket_protocol.ticket 0)
(declare-fun ticket_protocol.next_ticket () ticket_protocol.ticket)
(declare-fun ticket_protocol.service () ticket_protocol.ticket)
(declare-fun ticket_protocol.tp1.sk0 () ticket_protocol.thread)
(declare-fun ticket_protocol.zero () ticket_protocol.ticket)
(declare-fun ticket_protocol.le (ticket_protocol.ticket ticket_protocol.ticket) Bool)
(declare-fun ticket_protocol.m (ticket_protocol.thread ticket_protocol.ticket) Bool)
(declare-fun ticket_protocol.pc1 (ticket_protocol.thread) Bool)
(declare-fun ticket_protocol.pc2 (ticket_protocol.thread) Bool)
(declare-fun ticket_protocol.pc3 (ticket_protocol.thread) Bool)
(declare-fun ticket_protocol.scheduled (ticket_protocol.thread) Bool)
