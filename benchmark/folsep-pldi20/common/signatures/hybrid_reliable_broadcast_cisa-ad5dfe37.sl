(provide node quorum_a quorum_b rb.tp_correctness.n0 rb.tp_relay.n1 rb.tp_relay.n2 member_a member_b member_fa member_fc member_fi member_fs rb.accept rb.correct rb.d rb.obedient rb.rcv_init rb.rcv_msg rb.sent_msg rb.sent_msg_proj rb.symmetric)
(set-logic ALL)
(declare-sort node 0)
(declare-sort quorum_a 0)
(declare-sort quorum_b 0)
(declare-fun rb.tp_correctness.n0 () node)
(declare-fun rb.tp_relay.n1 () node)
(declare-fun rb.tp_relay.n2 () node)
(declare-fun member_a (node quorum_a) Bool)
(declare-fun member_b (node quorum_b) Bool)
(declare-fun member_fa (node) Bool)
(declare-fun member_fc (node) Bool)
(declare-fun member_fi (node) Bool)
(declare-fun member_fs (node) Bool)
(declare-fun rb.accept (node) Bool)
(declare-fun rb.correct (node) Bool)
(declare-fun rb.d (node) Bool)
(declare-fun rb.obedient (node) Bool)
(declare-fun rb.rcv_init (node) Bool)
(declare-fun rb.rcv_msg (node node) Bool)
(declare-fun rb.sent_msg (node node) Bool)
(declare-fun rb.sent_msg_proj (node) Bool)
(declare-fun rb.symmetric (node) Bool)
