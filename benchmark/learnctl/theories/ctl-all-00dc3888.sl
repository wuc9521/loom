(provide U Ctr CTL CTL.Asp CTL.Sem R bound next.depth p0 p1 p2 p3 p4 ap.p0 ap.p1 ap.p2 ap.p3 ap.p4 ctl.top ctl.not ctl.AX ctl.AF ctl.AG ctl.and ctl.or ctl.AU)
(set-logic ALL)

(declare-sort U 0)
(declare-sort Ctr 0)
(declare-fun p0 (U) Bool)
(declare-fun p1 (U) Bool)
(declare-fun p2 (U) Bool)
(declare-fun p3 (U) Bool)
(declare-fun p4 (U) Bool)
(declare-fun R (U U) Bool)
(declare-fun bound (U) Ctr)
(declare-fun next.depth (U Ctr) Ctr)

(declare-term-types
 ((CTL 0))
 (((ap.p0)
   (ap.p1)
   (ap.p2)
   (ap.p3)
   (ap.p4)
   (ctl.top)
   (ctl.not CTL)
   (ctl.AX CTL)
   (ctl.AF CTL)
   (ctl.AG CTL)
   (ctl.and CTL CTL)
   (ctl.or CTL CTL)
   (ctl.AU CTL CTL)
  )))

(define-finite CTL.Asp
  (record (model Model) (state U) (depth Ctr)))

(define-semantics
  ((CTL.Sem (phi CTL) (asp CTL.Asp)))
  ((match phi
     ((ap.p0) (p0 (state asp)))
     ((ap.p1) (p1 (state asp)))
     ((ap.p2) (p2 (state asp)))
     ((ap.p3) (p3 (state asp)))
     ((ap.p4) (p4 (state asp)))
     ((ctl.top) true)
     ((ctl.not x) (not (CTL.Sem x asp)))
     ((ctl.and x y) (and (CTL.Sem x asp) (CTL.Sem y asp)))
     ((ctl.or x y) (or (CTL.Sem x asp) (CTL.Sem y asp)))
     ((ctl.AX x)
      (forall ((next (domain (U (model asp)))))
        (or (not (R (state asp) next))
            (CTL.Sem x (CTL.Asp (model asp) next (depth asp))))))
     ((ctl.AF x)
      (or (CTL.Sem x asp)
          (and (not (= (depth asp) $0))
               (not (= (depth asp) bot))
               (forall ((next (domain (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.AG x)
      (and (CTL.Sem x asp)
           (or (= (depth asp) $0)
               (= (depth asp) bot)
               (forall ((next (domain (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.AU x y)
      (or (CTL.Sem y asp)
          (and (not (= (depth asp) $0))
               (not (= (depth asp) bot))
               (CTL.Sem x asp)
               (forall ((next (domain (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp))))))))))))
