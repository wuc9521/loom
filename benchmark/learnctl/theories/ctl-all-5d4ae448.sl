(provide U Ctr CTL CTL.Asp CTL.Sem R bound next.depth a b c d ap.a ap.b ap.c ap.d ctl.top ctl.not ctl.AX ctl.AF ctl.AG ctl.and ctl.or ctl.AU)
(set-logic ALL)

(declare-sort U 0)
(declare-sort Ctr 0)
(declare-fun a (U) Bool)
(declare-fun b (U) Bool)
(declare-fun c (U) Bool)
(declare-fun d (U) Bool)
(declare-fun R (U U) Bool)
(declare-fun bound (U) Ctr)
(declare-fun next.depth (U Ctr) Ctr)

(declare-term-types
 ((CTL 0))
 (((ap.a)
   (ap.b)
   (ap.c)
   (ap.d)
   (ctl.top)
   (ctl.not CTL)
   (ctl.AX CTL)
   (ctl.AF CTL)
   (ctl.AG CTL)
   (ctl.and CTL CTL)
   (ctl.or CTL CTL)
   (ctl.AU CTL CTL)
  )))

(define-finite CTL.Asp
  (record (model Model) (state U) (depth Ctr)))

(define-semantics
  ((CTL.Sem (phi CTL) (asp CTL.Asp)))
  ((match phi
     ((ap.a) (a (state asp)))
     ((ap.b) (b (state asp)))
     ((ap.c) (c (state asp)))
     ((ap.d) (d (state asp)))
     ((ctl.top) true)
     ((ctl.not x) (not (CTL.Sem x asp)))
     ((ctl.and x y) (and (CTL.Sem x asp) (CTL.Sem y asp)))
     ((ctl.or x y) (or (CTL.Sem x asp) (CTL.Sem y asp)))
     ((ctl.AX x)
      (forall ((next (domain (U (model asp)))))
        (or (not (R (state asp) next))
            (CTL.Sem x (CTL.Asp (model asp) next (depth asp))))))
     ((ctl.AF x)
      (or (CTL.Sem x asp)
          (and (not (= (depth asp) $0))
               (not (= (depth asp) bot))
               (forall ((next (domain (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.AG x)
      (and (CTL.Sem x asp)
           (or (= (depth asp) $0)
               (= (depth asp) bot)
               (forall ((next (domain (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.AU x y)
      (or (CTL.Sem y asp)
          (and (not (= (depth asp) $0))
               (not (= (depth asp) bot))
               (CTL.Sem x asp)
               (forall ((next (domain (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp))))))))))))
