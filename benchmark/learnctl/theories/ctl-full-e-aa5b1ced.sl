(provide U Ctr CTL CTL.Asp CTL.Sem R bound next.depth a b c d e f ap.a ap.b ap.c ap.d ap.e ap.f nap.a nap.b nap.c nap.d nap.e nap.f ctl.top ctl.AX ctl.EX ctl.AF ctl.EF ctl.AG ctl.EG ctl.and ctl.or ctl.AU ctl.EU)
(set-logic ALL)

(declare-sort U 0)
(declare-sort Ctr 0)
(declare-fun a (U) Bool)
(declare-fun b (U) Bool)
(declare-fun c (U) Bool)
(declare-fun d (U) Bool)
(declare-fun e (U) Bool)
(declare-fun f (U) Bool)
(declare-fun R (U U) Bool)
(declare-fun bound (U) Ctr)
(declare-fun next.depth (U Ctr) Ctr)

(declare-term-types
 ((CTL 0))
 (((ap.a)
   (nap.a)
   (ap.b)
   (nap.b)
   (ap.c)
   (nap.c)
   (ap.d)
   (nap.d)
   (ap.e)
   (nap.e)
   (ap.f)
   (nap.f)
   (ctl.top)
   (ctl.AX CTL)
   (ctl.EX CTL)
   (ctl.AF CTL)
   (ctl.EF CTL)
   (ctl.AG CTL)
   (ctl.EG CTL)
   (ctl.and CTL CTL)
   (ctl.or CTL CTL)
   (ctl.AU CTL CTL)
   (ctl.EU CTL CTL)
  )))

(define-finite CTL.Asp
  (record (model Model) (state U) (depth Ctr)))

(define-semantics
  ((CTL.Sem (phi CTL) (asp CTL.Asp)))
  ((match phi
     ((ap.a) (a (state asp)))
     ((nap.a) (not (a (state asp))))
     ((ap.b) (b (state asp)))
     ((nap.b) (not (b (state asp))))
     ((ap.c) (c (state asp)))
     ((nap.c) (not (c (state asp))))
     ((ap.d) (d (state asp)))
     ((nap.d) (not (d (state asp))))
     ((ap.e) (e (state asp)))
     ((nap.e) (not (e (state asp))))
     ((ap.f) (f (state asp)))
     ((nap.f) (not (f (state asp))))
     ((ctl.top) true)
     ((ctl.and x y) (and (CTL.Sem x asp) (CTL.Sem y asp)))
     ((ctl.or x y) (or (CTL.Sem x asp) (CTL.Sem y asp)))
     ((ctl.AX x)
      (forall ((next (domain (U (model asp)))))
        (or (not (R (state asp) next))
            (CTL.Sem x (CTL.Asp (model asp) next (depth asp))))))
     ((ctl.EX x)
      (exists ((next (domain (U (model asp)))))
        (and (R (state asp) next)
             (CTL.Sem x (CTL.Asp (model asp) next (depth asp))))))
     ((ctl.AF x)
      (or (CTL.Sem x asp)
          (and (not (= (depth asp) $0))
               (not (= (depth asp) bot))
               (forall ((next (domain (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.EF x)
      (or (CTL.Sem x asp)
          (and (not (= (depth asp) $0))
               (not (= (depth asp) bot))
               (exists ((next (domain (U (model asp)))))
                 (and (R (state asp) next)
                      (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.AG x)
      (and (CTL.Sem x asp)
           (or (= (depth asp) $0)
               (= (depth asp) bot)
               (forall ((next (domain (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.EG x)
      (and (CTL.Sem x asp)
           (or (= (depth asp) $0)
               (= (depth asp) bot)
               (exists ((next (domain (U (model asp)))))
                 (and (R (state asp) next)
                      (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.AU x y)
      (or (CTL.Sem y asp)
          (and (not (= (depth asp) $0))
               (not (= (depth asp) bot))
               (CTL.Sem x asp)
               (forall ((next (domain (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.EU x y)
      (or (CTL.Sem y asp)
          (and (not (= (depth asp) $0))
               (not (= (depth asp) bot))
               (CTL.Sem x asp)
               (exists ((next (domain (U (model asp)))))
                 (and (R (state asp) next)
                      (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp))))))))))))
