(provide small_m7)
(define-model small_m7
  (define-univ U (st_i st_q1 st_q2 st_q3 st_q4 st_q5 st_q6 st_state_7))
  (define-univ Ctr ($0 $1 $2 $3 $4 $5 $6 $7 bot))
  (interp-fun a (match (
    ((st_i) true)
    ((st_q2) true)
    ((st_q3) true)
    ((st_q6) true)
    ((_) false)
  )))
  (interp-fun b (match (
    ((st_q1) true)
    ((st_q2) true)
    ((st_q5) true)
    ((_) false)
  )))
  (interp-fun c (match (
    ((st_q4) true)
    ((st_q6) true)
    ((_) false)
  )))
  (interp-fun d (match (
    ((st_q3) true)
    ((_) false)
  )))
  (interp-fun R (match (
    ((st_i st_q1) true)
    ((st_i st_q4) true)
    ((st_q1 st_q2) true)
    ((st_q2 st_q3) true)
    ((st_q2 st_state_7) true)
    ((st_q3 st_q1) true)
    ((st_q4 st_q6) true)
    ((st_q4 st_q3) true)
    ((st_q5 st_q4) true)
    ((st_q6 st_q6) true)
    ((st_state_7 st_q6) true)
    ((_ _) false)
  )))
  (interp-fun bound (match (
    ((st_i) $7)
    ((st_q1) $7)
    ((st_q2) $7)
    ((st_q3) $7)
    ((st_q4) $7)
    ((st_q5) $7)
    ((st_q6) $7)
    ((st_state_7) $7)
    ((_) bot)
  )))
  (interp-fun next.depth (match (
    ((st_i $0) $0)
    ((st_i $1) $0)
    ((st_i $2) $1)
    ((st_i $3) $2)
    ((st_i $4) $3)
    ((st_i $5) $4)
    ((st_i $6) $5)
    ((st_i $7) $6)
    ((st_i bot) bot)
    ((st_q1 $0) $0)
    ((st_q1 $1) $0)
    ((st_q1 $2) $1)
    ((st_q1 $3) $2)
    ((st_q1 $4) $3)
    ((st_q1 $5) $4)
    ((st_q1 $6) $5)
    ((st_q1 $7) $6)
    ((st_q1 bot) bot)
    ((st_q2 $0) $0)
    ((st_q2 $1) $0)
    ((st_q2 $2) $1)
    ((st_q2 $3) $2)
    ((st_q2 $4) $3)
    ((st_q2 $5) $4)
    ((st_q2 $6) $5)
    ((st_q2 $7) $6)
    ((st_q2 bot) bot)
    ((st_q3 $0) $0)
    ((st_q3 $1) $0)
    ((st_q3 $2) $1)
    ((st_q3 $3) $2)
    ((st_q3 $4) $3)
    ((st_q3 $5) $4)
    ((st_q3 $6) $5)
    ((st_q3 $7) $6)
    ((st_q3 bot) bot)
    ((st_q4 $0) $0)
    ((st_q4 $1) $0)
    ((st_q4 $2) $1)
    ((st_q4 $3) $2)
    ((st_q4 $4) $3)
    ((st_q4 $5) $4)
    ((st_q4 $6) $5)
    ((st_q4 $7) $6)
    ((st_q4 bot) bot)
    ((st_q5 $0) $0)
    ((st_q5 $1) $0)
    ((st_q5 $2) $1)
    ((st_q5 $3) $2)
    ((st_q5 $4) $3)
    ((st_q5 $5) $4)
    ((st_q5 $6) $5)
    ((st_q5 $7) $6)
    ((st_q5 bot) bot)
    ((st_q6 $0) $0)
    ((st_q6 $1) $0)
    ((st_q6 $2) $1)
    ((st_q6 $3) $2)
    ((st_q6 $4) $3)
    ((st_q6 $5) $4)
    ((st_q6 $6) $5)
    ((st_q6 $7) $6)
    ((st_q6 bot) bot)
    ((st_state_7 $0) $0)
    ((st_state_7 $1) $0)
    ((st_state_7 $2) $1)
    ((st_state_7 $3) $2)
    ((st_state_7 $4) $3)
    ((st_state_7 $5) $4)
    ((st_state_7 $6) $5)
    ((st_state_7 $7) $6)
    ((st_state_7 bot) bot)
    ((_ _) bot)
  )))
)
