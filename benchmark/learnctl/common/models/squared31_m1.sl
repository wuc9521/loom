(provide squared31_m1)
(define-model squared31_m1
  (define-univ U (st_q0 st_q1 st_q2))
  (define-univ Ctr ($0 $1 $2 bot))
  (interp-fun p0 (match (
    ((st_q0) true)
    ((st_q1) true)
    ((st_q2) true)
    ((_) false)
  )))
  (interp-fun R (match (
    ((st_q0 st_q1) true)
    ((st_q0 st_q0) true)
    ((st_q1 st_q2) true)
    ((st_q2 st_q2) true)
    ((_ _) false)
  )))
  (interp-fun bound (match (
    ((st_q0) $2)
    ((st_q1) $2)
    ((st_q2) $2)
    ((_) bot)
  )))
  (interp-fun next.depth (match (
    ((st_q0 $0) $0)
    ((st_q0 $1) $0)
    ((st_q0 $2) $1)
    ((st_q0 bot) bot)
    ((st_q1 $0) $0)
    ((st_q1 $1) $0)
    ((st_q1 $2) $1)
    ((st_q1 bot) bot)
    ((st_q2 $0) $0)
    ((st_q2 $1) $0)
    ((st_q2 $2) $1)
    ((st_q2 bot) bot)
    ((_ _) bot)
  )))
)
