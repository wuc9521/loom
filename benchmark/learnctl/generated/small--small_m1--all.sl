(set-logic ALL)

(declare-sort U 0)
(declare-sort Ctr 0)
(declare-fun a (U) Bool)
(declare-fun b (U) Bool)
(declare-fun c (U) Bool)
(declare-fun d (U) Bool)
(declare-fun R (U U) Bool)
(declare-fun bound (U) Ctr)
(declare-fun next.depth (U Ctr) Ctr)

(declare-term-types
 ((CTL 0))
 (((ap.a)
   (ap.b)
   (ap.c)
   (ap.d)
   (ctl.top)
   (ctl.not CTL)
   (ctl.AX CTL)
   (ctl.AF CTL)
   (ctl.AG CTL)
   (ctl.and CTL CTL)
   (ctl.or CTL CTL)
   (ctl.AU CTL CTL)
  )))

(define-finite CTL.Asp
  (record (model Model) (state U) (depth Ctr)))

(define-semantics
  ((CTL.Sem (phi CTL) (asp CTL.Asp)))
  ((match phi
     ((ap.a) (a (state asp)))
     ((ap.b) (b (state asp)))
     ((ap.c) (c (state asp)))
     ((ap.d) (d (state asp)))
     ((ctl.top) true)
     ((ctl.not x) (not (CTL.Sem x asp)))
     ((ctl.and x y) (and (CTL.Sem x asp) (CTL.Sem y asp)))
     ((ctl.or x y) (or (CTL.Sem x asp) (CTL.Sem y asp)))
     ((ctl.AX x)
      (forall ((next (domain (U (model asp)))))
        (or (not (R (state asp) next))
            (CTL.Sem x (CTL.Asp (model asp) next (depth asp))))))
     ((ctl.AF x)
      (or (CTL.Sem x asp)
          (and (not (= (depth asp) $0))
               (not (= (depth asp) bot))
               (forall ((next (domain (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.AG x)
      (and (CTL.Sem x asp)
           (or (= (depth asp) $0)
               (= (depth asp) bot)
               (forall ((next (domain (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp)))))))))
     ((ctl.AU x y)
      (or (CTL.Sem y asp)
          (and (not (= (depth asp) $0))
               (not (= (depth asp) bot))
               (CTL.Sem x asp)
               (forall ((next (domain (U (model asp)))))
                 (or (not (R (state asp) next))
                     (CTL.Sem phi (CTL.Asp (model asp) next (next.depth next (depth asp))))))))))))

(define-model small
  (define-univ U (st_i st_q1 st_q2 st_q3 st_q4 st_q5 st_q6))
  (define-univ Ctr ($0 $1 $2 $3 $4 bot))
  (interp-fun a (match (
    ((st_i) true)
    ((st_q2) true)
    ((st_q3) true)
    ((st_q6) true)
    ((_) false)
  )))
  (interp-fun b (match (
    ((st_q1) true)
    ((st_q2) true)
    ((st_q5) true)
    ((_) false)
  )))
  (interp-fun c (match (
    ((st_q4) true)
    ((st_q6) true)
    ((_) false)
  )))
  (interp-fun d (match (
    ((st_q3) true)
    ((_) false)
  )))
  (interp-fun R (match (
    ((st_i st_q1) true)
    ((st_i st_q4) true)
    ((st_q1 st_q2) true)
    ((st_q2 st_q3) true)
    ((st_q2 st_q6) true)
    ((st_q3 st_q1) true)
    ((st_q4 st_q5) true)
    ((st_q4 st_q6) true)
    ((st_q5 st_q4) true)
    ((st_q6 st_q6) true)
    ((_ _) false)
  )))
  (interp-fun bound (match (
    ((st_i) $4)
    ((st_q1) $3)
    ((st_q2) $3)
    ((st_q3) $3)
    ((st_q4) $2)
    ((st_q5) $2)
    ((st_q6) $0)
    ((_) bot)
  )))
  (interp-fun next.depth (match (
    ((st_i $0) $0)
    ((st_i $1) $0)
    ((st_i $2) $1)
    ((st_i $3) $2)
    ((st_i $4) $3)
    ((st_i bot) bot)
    ((st_q1 $0) $0)
    ((st_q1 $1) $0)
    ((st_q1 $2) $1)
    ((st_q1 $3) $2)
    ((st_q1 $4) $3)
    ((st_q1 bot) bot)
    ((st_q2 $0) $0)
    ((st_q2 $1) $0)
    ((st_q2 $2) $1)
    ((st_q2 $3) $2)
    ((st_q2 $4) $3)
    ((st_q2 bot) bot)
    ((st_q3 $0) $0)
    ((st_q3 $1) $0)
    ((st_q3 $2) $1)
    ((st_q3 $3) $2)
    ((st_q3 $4) $3)
    ((st_q3 bot) bot)
    ((st_q4 $0) $0)
    ((st_q4 $1) $0)
    ((st_q4 $2) $1)
    ((st_q4 $3) $2)
    ((st_q4 $4) $2)
    ((st_q4 bot) bot)
    ((st_q5 $0) $0)
    ((st_q5 $1) $0)
    ((st_q5 $2) $1)
    ((st_q5 $3) $2)
    ((st_q5 $4) $2)
    ((st_q5 bot) bot)
    ((st_q6 $0) $0)
    ((st_q6 $1) $0)
    ((st_q6 $2) $0)
    ((st_q6 $3) $0)
    ((st_q6 $4) $0)
    ((st_q6 bot) bot)
    ((_ _) bot)
  )))
)

(define-model small_m1
  (define-univ U (st_i st_q1 st_q2 st_q3 st_q4 st_q5 st_q6))
  (define-univ Ctr ($0 $1 $2 $3 bot))
  (interp-fun a (match (
    ((st_i) true)
    ((st_q2) true)
    ((st_q3) true)
    ((st_q5) true)
    ((st_q6) true)
    ((_) false)
  )))
  (interp-fun b (match (
    ((st_q1) true)
    ((st_q5) true)
    ((_) false)
  )))
  (interp-fun c (match (
    ((st_q4) true)
    ((st_q6) true)
    ((_) false)
  )))
  (interp-fun d (match (
    ((st_q3) true)
    ((_) false)
  )))
  (interp-fun R (match (
    ((st_i st_q1) true)
    ((st_i st_q4) true)
    ((st_q1 st_q6) true)
    ((st_q2 st_q3) true)
    ((st_q2 st_q6) true)
    ((st_q3 st_q1) true)
    ((st_q4 st_q5) true)
    ((st_q4 st_q6) true)
    ((st_q5 st_q4) true)
    ((st_q6 st_q6) true)
    ((_ _) false)
  )))
  (interp-fun bound (match (
    ((st_i) $3)
    ((st_q1) $1)
    ((st_q2) $3)
    ((st_q3) $2)
    ((st_q4) $2)
    ((st_q5) $2)
    ((st_q6) $0)
    ((_) bot)
  )))
  (interp-fun next.depth (match (
    ((st_i $0) $0)
    ((st_i $1) $0)
    ((st_i $2) $1)
    ((st_i $3) $2)
    ((st_i bot) bot)
    ((st_q1 $0) $0)
    ((st_q1 $1) $0)
    ((st_q1 $2) $1)
    ((st_q1 $3) $1)
    ((st_q1 bot) bot)
    ((st_q2 $0) $0)
    ((st_q2 $1) $0)
    ((st_q2 $2) $1)
    ((st_q2 $3) $2)
    ((st_q2 bot) bot)
    ((st_q3 $0) $0)
    ((st_q3 $1) $0)
    ((st_q3 $2) $1)
    ((st_q3 $3) $2)
    ((st_q3 bot) bot)
    ((st_q4 $0) $0)
    ((st_q4 $1) $0)
    ((st_q4 $2) $1)
    ((st_q4 $3) $2)
    ((st_q4 bot) bot)
    ((st_q5 $0) $0)
    ((st_q5 $1) $0)
    ((st_q5 $2) $1)
    ((st_q5 $3) $2)
    ((st_q5 bot) bot)
    ((st_q6 $0) $0)
    ((st_q6 $1) $0)
    ((st_q6 $2) $0)
    ((st_q6 $3) $0)
    ((st_q6 bot) bot)
    ((_ _) bot)
  )))
)

(synth-fun phi () CTL)

(constraint (CTL.Sem phi (CTL.Asp small st_i $4)))
(constraint (not (CTL.Sem phi (CTL.Asp small_m1 st_i $3))))

(check-synth)
