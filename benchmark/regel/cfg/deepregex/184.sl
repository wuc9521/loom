(constraint (CFG.Sem g (CFG.Asp deepregex_184_P1 0 (size (Pos deepregex_184_P1)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp deepregex_184_P2 0 (size (Pos deepregex_184_P2)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp deepregex_184_P3 0 (size (Pos deepregex_184_P3)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp deepregex_184_P4 0 (size (Pos deepregex_184_P4)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp deepregex_184_P5 0 (size (Pos deepregex_184_P5)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp deepregex_184_P6 0 (size (Pos deepregex_184_P6)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp deepregex_184_P7 0 (size (Pos deepregex_184_P7)) reset.S)))
(constraint (not (CFG.Sem g (CFG.Asp deepregex_184_N1 0 (size (Pos deepregex_184_N1)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp deepregex_184_N2 0 (size (Pos deepregex_184_N2)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp deepregex_184_N3 0 (size (Pos deepregex_184_N3)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp deepregex_184_N4 0 (size (Pos deepregex_184_N4)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp deepregex_184_N5 0 (size (Pos deepregex_184_N5)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp deepregex_184_N6 0 (size (Pos deepregex_184_N6)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp deepregex_184_N7 0 (size (Pos deepregex_184_N7)) reset.S))))

