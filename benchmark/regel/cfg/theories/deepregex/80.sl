(provide CFG Rhs Rules CFG.Asp CFG.Sem cfg.top.S cfg.++ cfg.rhs.S cfg.rhs.T cfg.lhs.S cfg.lhs.T end tok.any tok.digit tok.lower tok.upper tok.alpha tok.alnum tok.word tok.space tok.hex tok.x20 tok.x21 tok.x2C)
(require "../../../common/signatures/deepregex/80.sl")

(declare-term-types
 ((CFG 0) (Rhs 0) (Rules 0))
 (
   (
      (cfg.top.S Rhs Rules)
    )
   (
      (tok.any)
      (tok.digit)
      (tok.lower)
      (tok.upper)
      (tok.alpha)
      (tok.alnum)
      (tok.word)
      (tok.space)
      (tok.hex)
      (tok.x20)
      (tok.x21)
      (tok.x2C)
      (cfg.++ Rhs Rhs)
      (cfg.rhs.S)
      (cfg.rhs.T)
    )
   (
      (cfg.lhs.S Rhs Rules)
      (cfg.lhs.T Rhs Rules)
      (end)
   )
  )
)

(define-finite CFG.Asp
  (record
    (model Model)
    (i Int)
    (j Int)
    (mode (enum base reset.S find.S reset.T find.T)))
  :where (and (<= 0 i) (<= i j) (<= j (size (Pos model)))))

(define-semantics
  ((CFG.Sem (n CFG) (asp CFG.Asp)))
  ((match n
     ((cfg.top.S x y)
      (or
        (and (= (mode asp) reset.S)
             (or (CFG.Sem x (CFG.Asp (model asp) (i asp) (j asp) base))
                 (CFG.Sem y (CFG.Asp (model asp) (i asp) (j asp) find.S))))
        (and (= (mode asp) reset.T)
             (CFG.Sem y (CFG.Asp (model asp) (i asp) (j asp) find.T)))))

     ((tok.any)
      (or
        (and (= (mode asp) base)
             (= (j asp) (+ (i asp) 1))
             (is.any (i asp)))
        (and (or (= (mode asp) reset.S) (= (mode asp) reset.T))
             (CFG.Sem (parent n) asp))))
     ((tok.digit)
      (or
        (and (= (mode asp) base)
             (= (j asp) (+ (i asp) 1))
             (is.digit (i asp)))
        (and (or (= (mode asp) reset.S) (= (mode asp) reset.T))
             (CFG.Sem (parent n) asp))))
     ((tok.lower)
      (or
        (and (= (mode asp) base)
             (= (j asp) (+ (i asp) 1))
             (is.lower (i asp)))
        (and (or (= (mode asp) reset.S) (= (mode asp) reset.T))
             (CFG.Sem (parent n) asp))))
     ((tok.upper)
      (or
        (and (= (mode asp) base)
             (= (j asp) (+ (i asp) 1))
             (is.upper (i asp)))
        (and (or (= (mode asp) reset.S) (= (mode asp) reset.T))
             (CFG.Sem (parent n) asp))))
     ((tok.alpha)
      (or
        (and (= (mode asp) base)
             (= (j asp) (+ (i asp) 1))
             (is.alpha (i asp)))
        (and (or (= (mode asp) reset.S) (= (mode asp) reset.T))
             (CFG.Sem (parent n) asp))))
     ((tok.alnum)
      (or
        (and (= (mode asp) base)
             (= (j asp) (+ (i asp) 1))
             (is.alnum (i asp)))
        (and (or (= (mode asp) reset.S) (= (mode asp) reset.T))
             (CFG.Sem (parent n) asp))))
     ((tok.word)
      (or
        (and (= (mode asp) base)
             (= (j asp) (+ (i asp) 1))
             (is.word (i asp)))
        (and (or (= (mode asp) reset.S) (= (mode asp) reset.T))
             (CFG.Sem (parent n) asp))))
     ((tok.space)
      (or
        (and (= (mode asp) base)
             (= (j asp) (+ (i asp) 1))
             (is.space (i asp)))
        (and (or (= (mode asp) reset.S) (= (mode asp) reset.T))
             (CFG.Sem (parent n) asp))))
     ((tok.hex)
      (or
        (and (= (mode asp) base)
             (= (j asp) (+ (i asp) 1))
             (is.hex (i asp)))
        (and (or (= (mode asp) reset.S) (= (mode asp) reset.T))
             (CFG.Sem (parent n) asp))))
     ((tok.x20)
      (or
        (and (= (mode asp) base)
             (= (j asp) (+ (i asp) 1))
             (is.x20 (i asp)))
        (and (or (= (mode asp) reset.S) (= (mode asp) reset.T))
             (CFG.Sem (parent n) asp))))
     ((tok.x21)
      (or
        (and (= (mode asp) base)
             (= (j asp) (+ (i asp) 1))
             (is.x21 (i asp)))
        (and (or (= (mode asp) reset.S) (= (mode asp) reset.T))
             (CFG.Sem (parent n) asp))))
     ((tok.x2C)
      (or
        (and (= (mode asp) base)
             (= (j asp) (+ (i asp) 1))
             (is.x2C (i asp)))
        (and (or (= (mode asp) reset.S) (= (mode asp) reset.T))
             (CFG.Sem (parent n) asp))))
     ((cfg.++ x y)
      (or
        (and (= (mode asp) base)
             (exists ((k (int-range (i asp) (j asp))))
               (and (CFG.Sem x (CFG.Asp (model asp) (i asp) k base))
                    (CFG.Sem y (CFG.Asp (model asp) k (j asp) base)))))
        (and (or (= (mode asp) reset.S) (= (mode asp) reset.T))
             (CFG.Sem (parent n) asp))))

     ((cfg.rhs.S)
      (and (= (mode asp) base)
           (CFG.Sem (parent n) (CFG.Asp (model asp) (i asp) (j asp) reset.S))))

     ((cfg.rhs.T)
      (and (= (mode asp) base)
           (CFG.Sem (parent n) (CFG.Asp (model asp) (i asp) (j asp) reset.T))))

     ((cfg.lhs.S x y)
      (or
        (and (or (= (mode asp) reset.S) (= (mode asp) reset.T))
             (CFG.Sem (parent n) asp))
        (and (= (mode asp) find.S)
             (or (CFG.Sem x (CFG.Asp (model asp) (i asp) (j asp) base))
                 (CFG.Sem y (CFG.Asp (model asp) (i asp) (j asp) find.S))))
        (and (= (mode asp) find.T)
             (CFG.Sem y (CFG.Asp (model asp) (i asp) (j asp) find.T)))))

     ((cfg.lhs.T x y)
      (or
        (and (or (= (mode asp) reset.S) (= (mode asp) reset.T))
             (CFG.Sem (parent n) asp))
        (and (= (mode asp) find.T)
             (or (CFG.Sem x (CFG.Asp (model asp) (i asp) (j asp) base))
                 (CFG.Sem y (CFG.Asp (model asp) (i asp) (j asp) find.T))))
        (and (= (mode asp) find.S)
             (CFG.Sem y (CFG.Asp (model asp) (i asp) (j asp) find.S)))))

     ((end)
      false))))
