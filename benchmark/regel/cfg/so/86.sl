(set-logic ALL)
(require "../theories/so/86.sl")
(require "../../common/models/so/86.sl")

(synth-fun g () CFG)

(constraint (CFG.Sem g (CFG.Asp so_86_P1 0 (size (Pos so_86_P1)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_86_P2 0 (size (Pos so_86_P2)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_86_P3 0 (size (Pos so_86_P3)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_86_P4 0 (size (Pos so_86_P4)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_86_P5 0 (size (Pos so_86_P5)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_86_P6 0 (size (Pos so_86_P6)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_86_P7 0 (size (Pos so_86_P7)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_86_P8 0 (size (Pos so_86_P8)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_86_P9 0 (size (Pos so_86_P9)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_86_P10 0 (size (Pos so_86_P10)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_86_P11 0 (size (Pos so_86_P11)) reset.S)))
(constraint (not (CFG.Sem g (CFG.Asp so_86_N1 0 (size (Pos so_86_N1)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_86_N2 0 (size (Pos so_86_N2)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_86_N3 0 (size (Pos so_86_N3)) reset.S))))

(check-synth)
