(set-logic ALL)
(require "../theories/so/48.sl")
(require "../../common/models/so/48.sl")

(synth-fun g () CFG)

(constraint (CFG.Sem g (CFG.Asp so_48_P1 0 (size (Pos so_48_P1)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_48_P2 0 (size (Pos so_48_P2)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_48_P3 0 (size (Pos so_48_P3)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_48_P4 0 (size (Pos so_48_P4)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_48_P5 0 (size (Pos so_48_P5)) reset.S)))
(constraint (not (CFG.Sem g (CFG.Asp so_48_N1 0 (size (Pos so_48_N1)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_48_N2 0 (size (Pos so_48_N2)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_48_N3 0 (size (Pos so_48_N3)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_48_N4 0 (size (Pos so_48_N4)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_48_N5 0 (size (Pos so_48_N5)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_48_N6 0 (size (Pos so_48_N6)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_48_N7 0 (size (Pos so_48_N7)) reset.S))))

(check-synth)
