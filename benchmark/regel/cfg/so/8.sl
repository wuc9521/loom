(set-logic ALL)
(require "../theories/so/8.sl")
(require "../../common/models/so/8.sl")

(synth-fun g () CFG)

(constraint (CFG.Sem g (CFG.Asp so_8_P1 0 (size (Pos so_8_P1)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_8_P2 0 (size (Pos so_8_P2)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_8_P3 0 (size (Pos so_8_P3)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_8_P4 0 (size (Pos so_8_P4)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_8_P5 0 (size (Pos so_8_P5)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_8_P6 0 (size (Pos so_8_P6)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_8_P7 0 (size (Pos so_8_P7)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_8_P8 0 (size (Pos so_8_P8)) reset.S)))
(constraint (not (CFG.Sem g (CFG.Asp so_8_N1 0 (size (Pos so_8_N1)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_8_N2 0 (size (Pos so_8_N2)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_8_N3 0 (size (Pos so_8_N3)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_8_N4 0 (size (Pos so_8_N4)) reset.S))))

(check-synth)
