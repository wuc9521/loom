(set-logic ALL)
(require "../theories/so/32.sl")
(require "../../common/models/so/32.sl")

(synth-fun g () CFG)

(constraint (CFG.Sem g (CFG.Asp so_32_P1 0 (size (Pos so_32_P1)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_32_P2 0 (size (Pos so_32_P2)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_32_P3 0 (size (Pos so_32_P3)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_32_P4 0 (size (Pos so_32_P4)) reset.S)))
(constraint (CFG.Sem g (CFG.Asp so_32_P5 0 (size (Pos so_32_P5)) reset.S)))
(constraint (not (CFG.Sem g (CFG.Asp so_32_N1 0 (size (Pos so_32_N1)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_32_N2 0 (size (Pos so_32_N2)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_32_N3 0 (size (Pos so_32_N3)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_32_N4 0 (size (Pos so_32_N4)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_32_N5 0 (size (Pos so_32_N5)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_32_N6 0 (size (Pos so_32_N6)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_32_N7 0 (size (Pos so_32_N7)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_32_N8 0 (size (Pos so_32_N8)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_32_N9 0 (size (Pos so_32_N9)) reset.S))))
(constraint (not (CFG.Sem g (CFG.Asp so_32_N10 0 (size (Pos so_32_N10)) reset.S))))

(check-synth)
