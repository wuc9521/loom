(provide Pos is.any is.digit is.lower is.upper is.alpha is.alnum is.word is.space is.hex is.x21 is.x23 is.x28 is.x2A is.x3E is.x7B is.x7E)
(declare-sort Pos 0)
(declare-fun is.any (Pos) Bool)
(declare-fun is.digit (Pos) Bool)
(declare-fun is.lower (Pos) Bool)
(declare-fun is.upper (Pos) Bool)
(declare-fun is.alpha (Pos) Bool)
(declare-fun is.alnum (Pos) Bool)
(declare-fun is.word (Pos) Bool)
(declare-fun is.space (Pos) Bool)
(declare-fun is.hex (Pos) Bool)
(declare-fun is.x21 (Pos) Bool)
(declare-fun is.x23 (Pos) Bool)
(declare-fun is.x28 (Pos) Bool)
(declare-fun is.x2A (Pos) Bool)
(declare-fun is.x3E (Pos) Bool)
(declare-fun is.x7B (Pos) Bool)
(declare-fun is.x7E (Pos) Bool)
