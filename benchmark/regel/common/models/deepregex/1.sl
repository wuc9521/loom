(require "../../signatures/deepregex/1.sl")
(provide deepregex_1_P1 deepregex_1_P2 deepregex_1_P3 deepregex_1_P4 deepregex_1_P5 deepregex_1_P6 deepregex_1_P7 deepregex_1_N1 deepregex_1_N2 deepregex_1_N3 deepregex_1_N4 deepregex_1_N5 deepregex_1_N6 deepregex_1_N7)

(define-model deepregex_1_P1
  (define-univ Pos ($0 $1))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    ((_) false)
  )))
  (interp-fun is.lower (match (
    ((_) false)
  )))
  (interp-fun is.upper (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.x20 (match (
    ((_) false)
  )))
  (interp-fun is.x21 (match (
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.x23 (match (
    ((_) false)
  )))
  (interp-fun is.x2E (match (
    ((_) false)
  )))
  (interp-fun is.x3B (match (
    ((_) false)
  )))
  (interp-fun is.x40 (match (
    ((_) false)
  )))
)

