(require "../../signatures/deepregex/38.sl")
(provide deepregex_38_P1 deepregex_38_P2 deepregex_38_P3 deepregex_38_P4 deepregex_38_P5 deepregex_38_P6 deepregex_38_P7 deepregex_38_N1 deepregex_38_N2 deepregex_38_N3 deepregex_38_N4 deepregex_38_N5 deepregex_38_N6 deepregex_38_N7)

(define-model deepregex_38_P1
  (define-univ Pos ($0 $1))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    ((_) false)
  )))
  (interp-fun is.lower (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.upper (match (
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.x21 (match (
    ((_) false)
  )))
  (interp-fun is.x3B (match (
    ((_) false)
  )))
)

