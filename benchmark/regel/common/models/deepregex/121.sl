(require "../../signatures/deepregex/121.sl")
(provide deepregex_121_P1 deepregex_121_P2 deepregex_121_P3 deepregex_121_P4 deepregex_121_P5 deepregex_121_P6 deepregex_121_P7 deepregex_121_N1 deepregex_121_N2 deepregex_121_N3 deepregex_121_N4 deepregex_121_N5 deepregex_121_N6 deepregex_121_N7)

(define-model deepregex_121_P1
  (define-univ Pos ($0 $1))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    ((_) false)
  )))
  (interp-fun is.lower (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.upper (match (
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    ((_) false)
  )))
  (interp-fun is.x21 (match (
    (($1) true)
    ((_) false)
  )))
)

