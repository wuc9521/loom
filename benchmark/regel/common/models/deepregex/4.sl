(require "../../signatures/deepregex/4.sl")
(provide deepregex_4_P1 deepregex_4_P2 deepregex_4_P3 deepregex_4_P4 deepregex_4_P5 deepregex_4_P6 deepregex_4_P7 deepregex_4_N1 deepregex_4_N2 deepregex_4_N3 deepregex_4_N4 deepregex_4_N5 deepregex_4_N6 deepregex_4_N7)

(define-model deepregex_4_P1
  (define-univ Pos ($0 $1))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    ((_) false)
  )))
  (interp-fun is.lower (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.upper (match (
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.x20 (match (
    ((_) false)
  )))
)

