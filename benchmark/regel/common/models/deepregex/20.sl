(require "../../signatures/deepregex/20.sl")
(provide deepregex_20_P1 deepregex_20_P2 deepregex_20_P3 deepregex_20_P4 deepregex_20_P5 deepregex_20_P6 deepregex_20_P7 deepregex_20_N1 deepregex_20_N2 deepregex_20_N3 deepregex_20_N4 deepregex_20_N5 deepregex_20_N6 deepregex_20_N7)

(define-model deepregex_20_P1
  (define-univ Pos ($0 $1))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    ((_) false)
  )))
  (interp-fun is.lower (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.upper (match (
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.x21 (match (
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.x2E (match (
    ((_) false)
  )))
)

