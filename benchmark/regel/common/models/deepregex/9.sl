(require "../../signatures/deepregex/9.sl")
(provide deepregex_9_P1 deepregex_9_P2 deepregex_9_P3 deepregex_9_P4 deepregex_9_P5 deepregex_9_P6 deepregex_9_P7 deepregex_9_N1 deepregex_9_N2 deepregex_9_N3 deepregex_9_N4 deepregex_9_N5 deepregex_9_N6 deepregex_9_N7)

(define-model deepregex_9_P1
  (define-univ Pos ($0 $1))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.lower (match (
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.upper (match (
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.x27 (match (
    ((_) false)
  )))
  (interp-fun is.x2C (match (
    ((_) false)
  )))
  (interp-fun is.x3B (match (
    ((_) false)
  )))
)

