(require "../../signatures/deepregex/120.sl")
(provide deepregex_120_P1 deepregex_120_P2 deepregex_120_P3 deepregex_120_P4 deepregex_120_P5 deepregex_120_P6 deepregex_120_P7 deepregex_120_N1 deepregex_120_N2 deepregex_120_N3 deepregex_120_N4 deepregex_120_N5 deepregex_120_N6 deepregex_120_N7)

(define-model deepregex_120_P1
  (define-univ Pos ($0 $1))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    ((_) false)
  )))
  (interp-fun is.lower (match (
    ((_) false)
  )))
  (interp-fun is.upper (match (
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    ((_) false)
  )))
  (interp-fun is.word (match (
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    ((_) false)
  )))
  (interp-fun is.x21 (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.x23 (match (
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.x40 (match (
    ((_) false)
  )))
)

