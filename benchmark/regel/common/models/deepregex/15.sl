(require "../../signatures/deepregex/15.sl")
(provide deepregex_15_P1 deepregex_15_P2 deepregex_15_P3 deepregex_15_P4 deepregex_15_P5 deepregex_15_P6 deepregex_15_P7 deepregex_15_N1 deepregex_15_N2 deepregex_15_N3 deepregex_15_N4 deepregex_15_N5 deepregex_15_N6 deepregex_15_N7)

(define-model deepregex_15_P1
  (define-univ Pos ($0 $1))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    ((_) false)
  )))
  (interp-fun is.lower (match (
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.upper (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.x21 (match (
    ((_) false)
  )))
)

