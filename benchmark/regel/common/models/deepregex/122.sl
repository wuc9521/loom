(require "../../signatures/deepregex/122.sl")
(provide deepregex_122_P1 deepregex_122_P2 deepregex_122_P3 deepregex_122_P4 deepregex_122_P5 deepregex_122_P6 deepregex_122_P7 deepregex_122_N1 deepregex_122_N2 deepregex_122_N3 deepregex_122_N4 deepregex_122_N5 deepregex_122_N6 deepregex_122_N7)

(define-model deepregex_122_P1
  (define-univ Pos ($0 $1 $2 $3 $4 $5))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    (($2) true)
    (($3) true)
    (($4) true)
    (($5) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    ((_) false)
  )))
  (interp-fun is.lower (match (
    ((_) false)
  )))
  (interp-fun is.upper (match (
    (($1) true)
    (($3) true)
    (($5) true)
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    (($1) true)
    (($3) true)
    (($5) true)
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($1) true)
    (($3) true)
    (($5) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($1) true)
    (($3) true)
    (($5) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    ((_) false)
  )))
  (interp-fun is.x21 (match (
    (($0) true)
    (($2) true)
    (($4) true)
    ((_) false)
  )))
)

