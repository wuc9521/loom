(require "../../signatures/deepregex/100.sl")
(provide deepregex_100_P1 deepregex_100_P2 deepregex_100_P3 deepregex_100_P4 deepregex_100_P5 deepregex_100_P6 deepregex_100_P7 deepregex_100_N1 deepregex_100_N2 deepregex_100_N3 deepregex_100_N4 deepregex_100_N5 deepregex_100_N6 deepregex_100_N7)

(define-model deepregex_100_P1
  (define-univ Pos ($0 $1 $2))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    (($2) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.lower (match (
    (($2) true)
    ((_) false)
  )))
  (interp-fun is.upper (match (
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    (($2) true)
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($1) true)
    (($2) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($1) true)
    (($2) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.x21 (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.x26 (match (
    ((_) false)
  )))
  (interp-fun is.x40 (match (
    ((_) false)
  )))
)

