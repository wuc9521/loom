(require "../../signatures/deepregex/168.sl")
(provide deepregex_168_P1 deepregex_168_P2 deepregex_168_P3 deepregex_168_P4 deepregex_168_P5 deepregex_168_P6 deepregex_168_P7 deepregex_168_N1 deepregex_168_N2 deepregex_168_N3 deepregex_168_N4 deepregex_168_N5 deepregex_168_N6 deepregex_168_N7)

(define-model deepregex_168_P1
  (define-univ Pos ($0 $1))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    ((_) false)
  )))
  (interp-fun is.lower (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.upper (match (
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.x20 (match (
    ((_) false)
  )))
  (interp-fun is.x21 (match (
    ((_) false)
  )))
  (interp-fun is.x40 (match (
    (($1) true)
    ((_) false)
  )))
)

