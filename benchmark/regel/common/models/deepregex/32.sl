(require "../../signatures/deepregex/32.sl")
(provide deepregex_32_P1 deepregex_32_P2 deepregex_32_P3 deepregex_32_P4 deepregex_32_P5 deepregex_32_P6 deepregex_32_P7 deepregex_32_N1 deepregex_32_N2 deepregex_32_N3 deepregex_32_N4 deepregex_32_N5 deepregex_32_N6 deepregex_32_N7)

(define-model deepregex_32_P1
  (define-univ Pos ($0 $1 $2))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    (($2) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.lower (match (
    (($2) true)
    ((_) false)
  )))
  (interp-fun is.upper (match (
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    (($2) true)
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($1) true)
    (($2) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($1) true)
    (($2) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    (($1) true)
    (($2) true)
    ((_) false)
  )))
  (interp-fun is.x21 (match (
    (($0) true)
    ((_) false)
  )))
)

