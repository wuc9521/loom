(require "../../signatures/deepregex/123.sl")
(provide deepregex_123_P1 deepregex_123_P2 deepregex_123_P3 deepregex_123_P4 deepregex_123_P5 deepregex_123_P6 deepregex_123_P7 deepregex_123_N1 deepregex_123_N2 deepregex_123_N3 deepregex_123_N4 deepregex_123_N5 deepregex_123_N6 deepregex_123_N7)

(define-model deepregex_123_P1
  (define-univ Pos ($0 $1))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    ((_) false)
  )))
  (interp-fun is.lower (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.upper (match (
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.x21 (match (
    (($1) true)
    ((_) false)
  )))
)

