(provide deepregex_158_P1 deepregex_158_P2 deepregex_158_P3 deepregex_158_P4 deepregex_158_P5 deepregex_158_P6 deepregex_158_P7 deepregex_158_N1 deepregex_158_N2 deepregex_158_N3 deepregex_158_N4 deepregex_158_N5 deepregex_158_N6 deepregex_158_N7)

(define-model deepregex_158_P1
  (define-univ Pos ($0 $1))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    ((_) false)
  )))
  (interp-fun is.lower (match (
    ((_) false)
  )))
  (interp-fun is.upper (match (
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    ((_) false)
  )))
  (interp-fun is.word (match (
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    ((_) false)
  )))
  (interp-fun is.x20 (match (
    ((_) false)
  )))
  (interp-fun is.x21 (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.x2C (match (
    ((_) false)
  )))
  (interp-fun is.x40 (match (
    (($1) true)
    ((_) false)
  )))
)

