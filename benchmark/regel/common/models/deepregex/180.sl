(require "../../signatures/deepregex/180.sl")
(provide deepregex_180_P1 deepregex_180_P2 deepregex_180_P3 deepregex_180_P4 deepregex_180_P5 deepregex_180_P6 deepregex_180_P7 deepregex_180_N1 deepregex_180_N2 deepregex_180_N3 deepregex_180_N4 deepregex_180_N5 deepregex_180_N6 deepregex_180_N7)

(define-model deepregex_180_P1
  (define-univ Pos ($0 $1))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    ((_) false)
  )))
  (interp-fun is.lower (match (
    ((_) false)
  )))
  (interp-fun is.upper (match (
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    ((_) false)
  )))
  (interp-fun is.word (match (
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    ((_) false)
  )))
  (interp-fun is.x20 (match (
    ((_) false)
  )))
  (interp-fun is.x21 (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.x40 (match (
    (($1) true)
    ((_) false)
  )))
)

