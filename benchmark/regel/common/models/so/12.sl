(require "../../signatures/so/12.sl")
(provide so_12_P1 so_12_P2 so_12_P3 so_12_P4 so_12_P5 so_12_N1 so_12_N2 so_12_N3 so_12_N4 so_12_N5 so_12_N6)

(define-model so_12_P1
  (define-univ Pos ($0 $1))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.lower (match (
    ((_) false)
  )))
  (interp-fun is.upper (match (
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($0) true)
    (($1) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    (($0) true)
    ((_) false)
  )))
  (interp-fun is.x20 (match (
    ((_) false)
  )))
  (interp-fun is.x5E (match (
    ((_) false)
  )))
)

