(require "../../signatures/so/75.sl")
(provide so_75_P1 so_75_P2 so_75_P3 so_75_P4 so_75_N1 so_75_N2 so_75_N3)

(define-model so_75_P1
  (define-univ Pos ($0 $1 $2 $3 $4 $5 $6 $7 $8))
  (interp-fun is.any (match (
    (($0) true)
    (($1) true)
    (($2) true)
    (($3) true)
    (($4) true)
    (($5) true)
    (($6) true)
    (($7) true)
    (($8) true)
    ((_) false)
  )))
  (interp-fun is.digit (match (
    (($0) true)
    (($2) true)
    (($4) true)
    (($5) true)
    (($7) true)
    (($8) true)
    ((_) false)
  )))
  (interp-fun is.lower (match (
    ((_) false)
  )))
  (interp-fun is.upper (match (
    ((_) false)
  )))
  (interp-fun is.alpha (match (
    ((_) false)
  )))
  (interp-fun is.alnum (match (
    (($0) true)
    (($2) true)
    (($4) true)
    (($5) true)
    (($7) true)
    (($8) true)
    ((_) false)
  )))
  (interp-fun is.word (match (
    (($0) true)
    (($2) true)
    (($4) true)
    (($5) true)
    (($7) true)
    (($8) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    (($0) true)
    (($2) true)
    (($4) true)
    (($5) true)
    (($7) true)
    (($8) true)
    ((_) false)
  )))
  (interp-fun is.x2C (match (
    (($1) true)
    (($3) true)
    (($6) true)
    ((_) false)
  )))
)

