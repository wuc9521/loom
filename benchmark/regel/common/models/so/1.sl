    (($2) true)
    (($3) true)
    (($4) true)
    ((_) false)
  )))
  (interp-fun is.space (match (
    ((_) false)
  )))
  (interp-fun is.hex (match (
    (($1) true)
    (($3) true)
    ((_) false)
  )))
  (interp-fun is.x2E (match (
    ((_) false)
  )))
  (interp-fun is.x3C (match (
    ((_) false)
  )))
  (interp-fun is.x3E (match (
