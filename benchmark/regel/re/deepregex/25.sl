(constraint (RegLan.Sem r (ReAsp deepregex_25_P2 0 (size (Pos deepregex_25_P2)))))
(constraint (RegLan.Sem r (ReAsp deepregex_25_P3 0 (size (Pos deepregex_25_P3)))))
