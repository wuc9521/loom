(constraint (RegLan.Sem r (ReAsp deepregex_35_P6 0 (size (Pos deepregex_35_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_35_P7 0 (size (Pos deepregex_35_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_35_N1 0 (size (Pos deepregex_35_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_35_N2 0 (size (Pos deepregex_35_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_35_N3 0 (size (Pos deepregex_35_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_35_N4 0 (size (Pos deepregex_35_N4))))))
