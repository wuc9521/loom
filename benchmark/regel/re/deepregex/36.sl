(constraint (RegLan.Sem r (ReAsp deepregex_36_P7 0 (size (Pos deepregex_36_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_36_N1 0 (size (Pos deepregex_36_N1))))))
