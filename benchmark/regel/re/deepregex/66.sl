(constraint (RegLan.Sem r (ReAsp deepregex_66_P1 0 (size (Pos deepregex_66_P1)))))
(constraint (RegLan.Sem r (ReAsp deepregex_66_P2 0 (size (Pos deepregex_66_P2)))))
(constraint (RegLan.Sem r (ReAsp deepregex_66_P3 0 (size (Pos deepregex_66_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_66_P4 0 (size (Pos deepregex_66_P4)))))
(constraint (RegLan.Sem r (ReAsp deepregex_66_P5 0 (size (Pos deepregex_66_P5)))))
(constraint (RegLan.Sem r (ReAsp deepregex_66_P6 0 (size (Pos deepregex_66_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_66_P7 0 (size (Pos deepregex_66_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_66_N1 0 (size (Pos deepregex_66_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_66_N2 0 (size (Pos deepregex_66_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_66_N3 0 (size (Pos deepregex_66_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_66_N4 0 (size (Pos deepregex_66_N4))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_66_N5 0 (size (Pos deepregex_66_N5))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_66_N6 0 (size (Pos deepregex_66_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_66_N7 0 (size (Pos deepregex_66_N7))))))

(check-synth)
