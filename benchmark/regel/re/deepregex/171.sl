(constraint (RegLan.Sem r (ReAsp deepregex_171_P1 0 (size (Pos deepregex_171_P1)))))
(constraint (RegLan.Sem r (ReAsp deepregex_171_P2 0 (size (Pos deepregex_171_P2)))))
(constraint (RegLan.Sem r (ReAsp deepregex_171_P3 0 (size (Pos deepregex_171_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_171_P4 0 (size (Pos deepregex_171_P4)))))
(constraint (RegLan.Sem r (ReAsp deepregex_171_P5 0 (size (Pos deepregex_171_P5)))))
(constraint (RegLan.Sem r (ReAsp deepregex_171_P6 0 (size (Pos deepregex_171_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_171_P7 0 (size (Pos deepregex_171_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_171_N1 0 (size (Pos deepregex_171_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_171_N2 0 (size (Pos deepregex_171_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_171_N3 0 (size (Pos deepregex_171_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_171_N4 0 (size (Pos deepregex_171_N4))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_171_N5 0 (size (Pos deepregex_171_N5))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_171_N6 0 (size (Pos deepregex_171_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_171_N7 0 (size (Pos deepregex_171_N7))))))

(check-synth)
