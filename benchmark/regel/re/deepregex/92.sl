(constraint (RegLan.Sem r (ReAsp deepregex_92_P3 0 (size (Pos deepregex_92_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_92_P4 0 (size (Pos deepregex_92_P4)))))
(constraint (RegLan.Sem r (ReAsp deepregex_92_P5 0 (size (Pos deepregex_92_P5)))))
(constraint (RegLan.Sem r (ReAsp deepregex_92_P6 0 (size (Pos deepregex_92_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_92_P7 0 (size (Pos deepregex_92_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_92_N1 0 (size (Pos deepregex_92_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_92_N2 0 (size (Pos deepregex_92_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_92_N3 0 (size (Pos deepregex_92_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_92_N4 0 (size (Pos deepregex_92_N4))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_92_N5 0 (size (Pos deepregex_92_N5))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_92_N6 0 (size (Pos deepregex_92_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_92_N7 0 (size (Pos deepregex_92_N7))))))

(check-synth)
