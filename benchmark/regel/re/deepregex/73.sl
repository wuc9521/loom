(constraint (RegLan.Sem r (ReAsp deepregex_73_P2 0 (size (Pos deepregex_73_P2)))))
(constraint (RegLan.Sem r (ReAsp deepregex_73_P3 0 (size (Pos deepregex_73_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_73_P4 0 (size (Pos deepregex_73_P4)))))
(constraint (RegLan.Sem r (ReAsp deepregex_73_P5 0 (size (Pos deepregex_73_P5)))))
(constraint (RegLan.Sem r (ReAsp deepregex_73_P6 0 (size (Pos deepregex_73_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_73_P7 0 (size (Pos deepregex_73_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_73_N1 0 (size (Pos deepregex_73_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_73_N2 0 (size (Pos deepregex_73_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_73_N3 0 (size (Pos deepregex_73_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_73_N4 0 (size (Pos deepregex_73_N4))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_73_N5 0 (size (Pos deepregex_73_N5))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_73_N6 0 (size (Pos deepregex_73_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_73_N7 0 (size (Pos deepregex_73_N7))))))

(check-synth)
