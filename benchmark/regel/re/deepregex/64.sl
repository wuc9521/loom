(require "../theories/deepregex/64.sl")
(require "../../common/models/deepregex/64.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (ReAsp deepregex_64_P1 0 (size (Pos deepregex_64_P1)))))
(constraint (RegLan.Sem r (ReAsp deepregex_64_P2 0 (size (Pos deepregex_64_P2)))))
(constraint (RegLan.Sem r (ReAsp deepregex_64_P3 0 (size (Pos deepregex_64_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_64_P4 0 (size (Pos deepregex_64_P4)))))
(constraint (RegLan.Sem r (ReAsp deepregex_64_P5 0 (size (Pos deepregex_64_P5)))))
(constraint (RegLan.Sem r (ReAsp deepregex_64_P6 0 (size (Pos deepregex_64_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_64_P7 0 (size (Pos deepregex_64_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_64_N1 0 (size (Pos deepregex_64_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_64_N2 0 (size (Pos deepregex_64_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_64_N3 0 (size (Pos deepregex_64_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_64_N4 0 (size (Pos deepregex_64_N4))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_64_N5 0 (size (Pos deepregex_64_N5))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_64_N6 0 (size (Pos deepregex_64_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_64_N7 0 (size (Pos deepregex_64_N7))))))

(check-synth)
