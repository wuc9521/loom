(constraint (RegLan.Sem r (ReAsp deepregex_18_P6 0 (size (Pos deepregex_18_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_18_P7 0 (size (Pos deepregex_18_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_18_N1 0 (size (Pos deepregex_18_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_18_N2 0 (size (Pos deepregex_18_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_18_N3 0 (size (Pos deepregex_18_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_18_N4 0 (size (Pos deepregex_18_N4))))))
