(constraint (not (RegLan.Sem r (ReAsp deepregex_18_N6 0 (size (Pos deepregex_18_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_18_N7 0 (size (Pos deepregex_18_N7))))))

