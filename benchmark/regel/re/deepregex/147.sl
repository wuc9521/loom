(constraint (RegLan.Sem r (ReAsp deepregex_147_P1 0 (size (Pos deepregex_147_P1)))))
(constraint (RegLan.Sem r (ReAsp deepregex_147_P2 0 (size (Pos deepregex_147_P2)))))
(constraint (RegLan.Sem r (ReAsp deepregex_147_P3 0 (size (Pos deepregex_147_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_147_P4 0 (size (Pos deepregex_147_P4)))))
(constraint (RegLan.Sem r (ReAsp deepregex_147_P5 0 (size (Pos deepregex_147_P5)))))
(constraint (RegLan.Sem r (ReAsp deepregex_147_P6 0 (size (Pos deepregex_147_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_147_P7 0 (size (Pos deepregex_147_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_147_N1 0 (size (Pos deepregex_147_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_147_N2 0 (size (Pos deepregex_147_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_147_N3 0 (size (Pos deepregex_147_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_147_N4 0 (size (Pos deepregex_147_N4))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_147_N5 0 (size (Pos deepregex_147_N5))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_147_N6 0 (size (Pos deepregex_147_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_147_N7 0 (size (Pos deepregex_147_N7))))))

(check-synth)
