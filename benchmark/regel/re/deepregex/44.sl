(require "../theories/deepregex/44.sl")
(require "../../common/models/deepregex/44.sl")

(synth-fun regex () RegLan)

(constraint (RegLan.Sem r (ReAsp deepregex_44_P1 0 (size (Pos deepregex_44_P1)))))
(constraint (RegLan.Sem r (ReAsp deepregex_44_P2 0 (size (Pos deepregex_44_P2)))))
(constraint (RegLan.Sem r (ReAsp deepregex_44_P3 0 (size (Pos deepregex_44_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_44_P4 0 (size (Pos deepregex_44_P4)))))
(constraint (RegLan.Sem r (ReAsp deepregex_44_P5 0 (size (Pos deepregex_44_P5)))))
(constraint (RegLan.Sem r (ReAsp deepregex_44_P6 0 (size (Pos deepregex_44_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_44_P7 0 (size (Pos deepregex_44_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_44_N1 0 (size (Pos deepregex_44_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_44_N2 0 (size (Pos deepregex_44_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_44_N3 0 (size (Pos deepregex_44_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_44_N4 0 (size (Pos deepregex_44_N4))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_44_N5 0 (size (Pos deepregex_44_N5))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_44_N6 0 (size (Pos deepregex_44_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_44_N7 0 (size (Pos deepregex_44_N7))))))

(check-synth)
