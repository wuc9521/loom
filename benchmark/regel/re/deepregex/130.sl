(constraint (RegLan.Sem r (ReAsp deepregex_130_P1 0 (size (Pos deepregex_130_P1)))))
(constraint (RegLan.Sem r (ReAsp deepregex_130_P2 0 (size (Pos deepregex_130_P2)))))
(constraint (RegLan.Sem r (ReAsp deepregex_130_P3 0 (size (Pos deepregex_130_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_130_P4 0 (size (Pos deepregex_130_P4)))))
(constraint (RegLan.Sem r (ReAsp deepregex_130_P5 0 (size (Pos deepregex_130_P5)))))
(constraint (RegLan.Sem r (ReAsp deepregex_130_P6 0 (size (Pos deepregex_130_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_130_P7 0 (size (Pos deepregex_130_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_130_N1 0 (size (Pos deepregex_130_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_130_N2 0 (size (Pos deepregex_130_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_130_N3 0 (size (Pos deepregex_130_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_130_N4 0 (size (Pos deepregex_130_N4))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_130_N5 0 (size (Pos deepregex_130_N5))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_130_N6 0 (size (Pos deepregex_130_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_130_N7 0 (size (Pos deepregex_130_N7))))))

(check-synth)
