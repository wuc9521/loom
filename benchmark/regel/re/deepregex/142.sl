(constraint (not (RegLan.Sem r (ReAsp deepregex_142_N6 0 (size (Pos deepregex_142_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_142_N7 0 (size (Pos deepregex_142_N7))))))

