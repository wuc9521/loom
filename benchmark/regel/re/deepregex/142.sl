(constraint (RegLan.Sem r (ReAsp deepregex_142_P7 0 (size (Pos deepregex_142_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_142_N1 0 (size (Pos deepregex_142_N1))))))
