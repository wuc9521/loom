(constraint (not (RegLan.Sem r (ReAsp deepregex_142_N3 0 (size (Pos deepregex_142_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_142_N4 0 (size (Pos deepregex_142_N4))))))
