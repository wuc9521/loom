(constraint (RegLan.Sem r (ReAsp deepregex_28_P3 0 (size (Pos deepregex_28_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_28_P4 0 (size (Pos deepregex_28_P4)))))
(constraint (RegLan.Sem r (ReAsp deepregex_28_P5 0 (size (Pos deepregex_28_P5)))))
(constraint (RegLan.Sem r (ReAsp deepregex_28_P6 0 (size (Pos deepregex_28_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_28_P7 0 (size (Pos deepregex_28_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_28_N1 0 (size (Pos deepregex_28_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_28_N2 0 (size (Pos deepregex_28_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_28_N3 0 (size (Pos deepregex_28_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_28_N4 0 (size (Pos deepregex_28_N4))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_28_N5 0 (size (Pos deepregex_28_N5))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_28_N6 0 (size (Pos deepregex_28_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_28_N7 0 (size (Pos deepregex_28_N7))))))

