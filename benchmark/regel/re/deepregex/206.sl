(constraint (RegLan.Sem r (ReAsp deepregex_206_P7 0 (size (Pos deepregex_206_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_206_N1 0 (size (Pos deepregex_206_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_206_N2 0 (size (Pos deepregex_206_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_206_N3 0 (size (Pos deepregex_206_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_206_N4 0 (size (Pos deepregex_206_N4))))))
