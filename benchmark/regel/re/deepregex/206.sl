(constraint (not (RegLan.Sem r (ReAsp deepregex_206_N6 0 (size (Pos deepregex_206_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_206_N7 0 (size (Pos deepregex_206_N7))))))

