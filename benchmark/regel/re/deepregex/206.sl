(constraint (RegLan.Sem r (ReAsp deepregex_206_P3 0 (size (Pos deepregex_206_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_206_P4 0 (size (Pos deepregex_206_P4)))))
