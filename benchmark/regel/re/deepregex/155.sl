(constraint (RegLan.Sem r (ReAsp deepregex_155_P7 0 (size (Pos deepregex_155_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_155_N1 0 (size (Pos deepregex_155_N1))))))
