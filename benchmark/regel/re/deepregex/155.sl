(constraint (not (RegLan.Sem r (ReAsp deepregex_155_N6 0 (size (Pos deepregex_155_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_155_N7 0 (size (Pos deepregex_155_N7))))))

