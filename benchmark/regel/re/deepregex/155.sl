(constraint (not (RegLan.Sem r (ReAsp deepregex_155_N3 0 (size (Pos deepregex_155_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_155_N4 0 (size (Pos deepregex_155_N4))))))
