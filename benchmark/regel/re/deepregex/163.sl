(constraint (RegLan.Sem r (ReAsp deepregex_163_P1 0 (size (Pos deepregex_163_P1)))))
(constraint (RegLan.Sem r (ReAsp deepregex_163_P2 0 (size (Pos deepregex_163_P2)))))
(constraint (RegLan.Sem r (ReAsp deepregex_163_P3 0 (size (Pos deepregex_163_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_163_P4 0 (size (Pos deepregex_163_P4)))))
(constraint (RegLan.Sem r (ReAsp deepregex_163_P5 0 (size (Pos deepregex_163_P5)))))
(constraint (RegLan.Sem r (ReAsp deepregex_163_P6 0 (size (Pos deepregex_163_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_163_P7 0 (size (Pos deepregex_163_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_163_N1 0 (size (Pos deepregex_163_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_163_N2 0 (size (Pos deepregex_163_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_163_N3 0 (size (Pos deepregex_163_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_163_N4 0 (size (Pos deepregex_163_N4))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_163_N5 0 (size (Pos deepregex_163_N5))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_163_N6 0 (size (Pos deepregex_163_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_163_N7 0 (size (Pos deepregex_163_N7))))))

(check-synth)
