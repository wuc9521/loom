(require "../../common/models/deepregex/113.sl")

(synth-fun regex () RegLan)

(constraint (RegLan.Sem r (ReAsp deepregex_113_P1 0 (size (Pos deepregex_113_P1)))))
(constraint (RegLan.Sem r (ReAsp deepregex_113_P2 0 (size (Pos deepregex_113_P2)))))
(constraint (RegLan.Sem r (ReAsp deepregex_113_P3 0 (size (Pos deepregex_113_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_113_P4 0 (size (Pos deepregex_113_P4)))))
(constraint (RegLan.Sem r (ReAsp deepregex_113_P5 0 (size (Pos deepregex_113_P5)))))
(constraint (RegLan.Sem r (ReAsp deepregex_113_P6 0 (size (Pos deepregex_113_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_113_P7 0 (size (Pos deepregex_113_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_113_N1 0 (size (Pos deepregex_113_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_113_N2 0 (size (Pos deepregex_113_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_113_N3 0 (size (Pos deepregex_113_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_113_N4 0 (size (Pos deepregex_113_N4))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_113_N5 0 (size (Pos deepregex_113_N5))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_113_N6 0 (size (Pos deepregex_113_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_113_N7 0 (size (Pos deepregex_113_N7))))))

(check-synth)
