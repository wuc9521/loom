(constraint (RegLan.Sem r (ReAsp deepregex_9_P1 0 (size (Pos deepregex_9_P1)))))
(constraint (RegLan.Sem r (ReAsp deepregex_9_P2 0 (size (Pos deepregex_9_P2)))))
(constraint (RegLan.Sem r (ReAsp deepregex_9_P3 0 (size (Pos deepregex_9_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_9_P4 0 (size (Pos deepregex_9_P4)))))
(constraint (RegLan.Sem r (ReAsp deepregex_9_P5 0 (size (Pos deepregex_9_P5)))))
(constraint (RegLan.Sem r (ReAsp deepregex_9_P6 0 (size (Pos deepregex_9_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_9_P7 0 (size (Pos deepregex_9_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_9_N1 0 (size (Pos deepregex_9_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_9_N2 0 (size (Pos deepregex_9_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_9_N3 0 (size (Pos deepregex_9_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_9_N4 0 (size (Pos deepregex_9_N4))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_9_N5 0 (size (Pos deepregex_9_N5))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_9_N6 0 (size (Pos deepregex_9_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_9_N7 0 (size (Pos deepregex_9_N7))))))

(check-synth)
