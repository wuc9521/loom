(constraint (RegLan.Sem r (ReAsp deepregex_159_P1 0 (size (Pos deepregex_159_P1)))))
(constraint (RegLan.Sem r (ReAsp deepregex_159_P2 0 (size (Pos deepregex_159_P2)))))
(constraint (RegLan.Sem r (ReAsp deepregex_159_P3 0 (size (Pos deepregex_159_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_159_P4 0 (size (Pos deepregex_159_P4)))))
(constraint (RegLan.Sem r (ReAsp deepregex_159_P5 0 (size (Pos deepregex_159_P5)))))
(constraint (RegLan.Sem r (ReAsp deepregex_159_P6 0 (size (Pos deepregex_159_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_159_P7 0 (size (Pos deepregex_159_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_159_N1 0 (size (Pos deepregex_159_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_159_N2 0 (size (Pos deepregex_159_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_159_N3 0 (size (Pos deepregex_159_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_159_N4 0 (size (Pos deepregex_159_N4))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_159_N5 0 (size (Pos deepregex_159_N5))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_159_N6 0 (size (Pos deepregex_159_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_159_N7 0 (size (Pos deepregex_159_N7))))))

(check-synth)
