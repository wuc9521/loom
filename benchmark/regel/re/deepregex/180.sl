(require "../theories/deepregex/180.sl")
(require "../../common/models/deepregex/180.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (ReAsp deepregex_180_P1 0 (size (Pos deepregex_180_P1)))))
(constraint (RegLan.Sem r (ReAsp deepregex_180_P2 0 (size (Pos deepregex_180_P2)))))
(constraint (RegLan.Sem r (ReAsp deepregex_180_P3 0 (size (Pos deepregex_180_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_180_P4 0 (size (Pos deepregex_180_P4)))))
(constraint (RegLan.Sem r (ReAsp deepregex_180_P5 0 (size (Pos deepregex_180_P5)))))
(constraint (RegLan.Sem r (ReAsp deepregex_180_P6 0 (size (Pos deepregex_180_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_180_P7 0 (size (Pos deepregex_180_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_180_N1 0 (size (Pos deepregex_180_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_180_N2 0 (size (Pos deepregex_180_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_180_N3 0 (size (Pos deepregex_180_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_180_N4 0 (size (Pos deepregex_180_N4))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_180_N5 0 (size (Pos deepregex_180_N5))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_180_N6 0 (size (Pos deepregex_180_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_180_N7 0 (size (Pos deepregex_180_N7))))))

(check-synth)
