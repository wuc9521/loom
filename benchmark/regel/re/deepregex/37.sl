(require "../theories/deepregex/37.sl")
(require "../../common/models/deepregex/37.sl")

(synth-fun r () RegLan)

(constraint (RegLan.Sem r (ReAsp deepregex_37_P1 0 (size (Pos deepregex_37_P1)))))
(constraint (RegLan.Sem r (ReAsp deepregex_37_P2 0 (size (Pos deepregex_37_P2)))))
(constraint (RegLan.Sem r (ReAsp deepregex_37_P3 0 (size (Pos deepregex_37_P3)))))
(constraint (RegLan.Sem r (ReAsp deepregex_37_P4 0 (size (Pos deepregex_37_P4)))))
(constraint (RegLan.Sem r (ReAsp deepregex_37_P5 0 (size (Pos deepregex_37_P5)))))
(constraint (RegLan.Sem r (ReAsp deepregex_37_P6 0 (size (Pos deepregex_37_P6)))))
(constraint (RegLan.Sem r (ReAsp deepregex_37_P7 0 (size (Pos deepregex_37_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_37_N1 0 (size (Pos deepregex_37_N1))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_37_N2 0 (size (Pos deepregex_37_N2))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_37_N3 0 (size (Pos deepregex_37_N3))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_37_N4 0 (size (Pos deepregex_37_N4))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_37_N5 0 (size (Pos deepregex_37_N5))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_37_N6 0 (size (Pos deepregex_37_N6))))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_37_N7 0 (size (Pos deepregex_37_N7))))))

(check-synth)
