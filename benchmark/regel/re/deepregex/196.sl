(constraint (RegLan.Sem r (ReAsp deepregex_196_P7 0 (size (Pos deepregex_196_P7)))))
(constraint (not (RegLan.Sem r (ReAsp deepregex_196_N1 0 (size (Pos deepregex_196_N1))))))
