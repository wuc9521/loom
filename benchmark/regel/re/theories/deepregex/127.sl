(provide RegLan ReAsp RegLan.Sem re.opt re.plus re.++ re.union re.inter re.* char.any char.digit char.lower char.upper char.alpha char.alnum char.word char.space char.hex char.x21)
(require "../../../common/signatures/deepregex/127.sl")

(declare-term-types
 ((RegLan 0))
 (((char.any)
   (char.digit)
   (char.lower)
   (char.upper)
   (char.alpha)
   (char.alnum)
   (char.word)
   (char.space)
   (char.hex)
   (char.x21)
   (re.opt RegLan)
   (re.plus RegLan)
   (re.++ RegLan RegLan)
   (re.union RegLan RegLan)
   (re.inter RegLan RegLan)
   (re.* RegLan))))

(define-finite ReAsp
  (record (model Model) (i Int) (j Int))
  :where (and (<= 0 i) (<= i j) (<= j (size (Pos model)))))

(define-semantics
  ((RegLan.Sem (r RegLan) (asp ReAsp)))
  ((match r
     ((char.any) (and (= (j asp) (+ (i asp) 1)) (is.any (i asp))))
     ((char.digit) (and (= (j asp) (+ (i asp) 1)) (is.digit (i asp))))
     ((char.lower) (and (= (j asp) (+ (i asp) 1)) (is.lower (i asp))))
     ((char.upper) (and (= (j asp) (+ (i asp) 1)) (is.upper (i asp))))
     ((char.alpha) (and (= (j asp) (+ (i asp) 1)) (is.alpha (i asp))))
     ((char.alnum) (and (= (j asp) (+ (i asp) 1)) (is.alnum (i asp))))
     ((char.word) (and (= (j asp) (+ (i asp) 1)) (is.word (i asp))))
     ((char.space) (and (= (j asp) (+ (i asp) 1)) (is.space (i asp))))
     ((char.hex) (and (= (j asp) (+ (i asp) 1)) (is.hex (i asp))))
     ((char.x21) (and (= (j asp) (+ (i asp) 1)) (is.x21 (i asp))))
     ((re.opt x)
      (or (= (i asp) (j asp))
          (RegLan.Sem x asp)))
     ((re.plus x)
      (exists ((k (int-range (+ (i asp) 1) (j asp))))
        (and (RegLan.Sem x (ReAsp (model asp) (i asp) k))
             (or (= k (j asp))
                 (RegLan.Sem r (ReAsp (model asp) k (j asp)))))))
     ((re.++ x y)
      (exists ((k (int-range (i asp) (j asp))))
        (and (RegLan.Sem x (ReAsp (model asp) (i asp) k))
             (RegLan.Sem y (ReAsp (model asp) k (j asp))))))
     ((re.union x y)
      (or (RegLan.Sem x asp) (RegLan.Sem y asp)))
     ((re.inter x y)
      (and (RegLan.Sem x asp) (RegLan.Sem y asp)))
     ((re.* x)
      (or (= (i asp) (j asp))
          (exists ((k (int-range (+ (i asp) 1) (j asp))))
            (and (RegLan.Sem x (ReAsp (model asp) (i asp) k))
                 (RegLan.Sem r (ReAsp (model asp) k (j asp))))))))))
