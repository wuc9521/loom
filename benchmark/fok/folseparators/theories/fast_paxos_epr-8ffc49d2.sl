(provide c_quorum f_quorum node round value none any_msg c_member decision f_member fast le left_rnd one_a one_b one_b_max_vote proposal vote Formula FoAsp Term.c_quorum Term.c_quorum.Sem Term.f_quorum Term.f_quorum.Sem Term.node Term.node.Sem Term.round Term.round.Sem Term.value Term.value.Sem FO.Sem fol.true fol.false fol.not fol.and fol.or fol.forall.x0.c_quorum fol.exists.x0.c_quorum fol.forall.x1.c_quorum fol.exists.x1.c_quorum fol.eq.c_quorum fol.forall.x0.f_quorum fol.exists.x0.f_quorum fol.forall.x1.f_quorum fol.exists.x1.f_quorum fol.eq.f_quorum fol.forall.x0.node fol.exists.x0.node fol.forall.x1.node fol.exists.x1.node fol.eq.node fol.forall.x0.round fol.exists.x0.round fol.forall.x1.round fol.exists.x1.round fol.eq.round fol.forall.x0.value fol.exists.x0.value fol.forall.x1.value fol.exists.x1.value fol.eq.value fol.atom.any_msg fol.atom.c_member fol.atom.decision fol.atom.f_member fol.atom.fast fol.atom.le fol.atom.left_rnd fol.atom.one_a fol.atom.one_b fol.atom.one_b_max_vote fol.atom.proposal fol.atom.vote fol.var.x0.c_quorum fol.var.x1.c_quorum fol.var.x0.f_quorum fol.var.x1.f_quorum fol.var.x0.node fol.var.x1.node fol.var.x0.round fol.var.x1.round fol.term.none fol.var.x0.value fol.var.x1.value)
(set-logic ALL)
(declare-sort c_quorum 0)
(declare-sort f_quorum 0)
(declare-sort node 0)
(declare-sort round 0)
(declare-sort value 0)
(declare-fun none () round)
(declare-fun any_msg (round) Bool)
(declare-fun c_member (node c_quorum) Bool)
(declare-fun decision (node round value) Bool)
(declare-fun f_member (node f_quorum) Bool)
(declare-fun fast (round) Bool)
(declare-fun le (round round) Bool)
(declare-fun left_rnd (node round) Bool)
(declare-fun one_a (round) Bool)
(declare-fun one_b (node round) Bool)
(declare-fun one_b_max_vote (node round round value) Bool)
(declare-fun proposal (round value) Bool)
(declare-fun vote (node round value) Bool)

(declare-term-types
 ((Formula 0) (Term.c_quorum 0) (Term.f_quorum 0) (Term.node 0) (Term.round 0) (Term.value 0))
 (((fol.true)
   (fol.false)
   (fol.not Formula)
   (fol.and Formula Formula)
   (fol.or Formula Formula)
   (fol.forall.x0.c_quorum Formula)
   (fol.exists.x0.c_quorum Formula)
   (fol.forall.x1.c_quorum Formula)
   (fol.exists.x1.c_quorum Formula)
   (fol.eq.c_quorum Term.c_quorum Term.c_quorum)
   (fol.forall.x0.f_quorum Formula)
   (fol.exists.x0.f_quorum Formula)
   (fol.forall.x1.f_quorum Formula)
   (fol.exists.x1.f_quorum Formula)
   (fol.eq.f_quorum Term.f_quorum Term.f_quorum)
   (fol.forall.x0.node Formula)
   (fol.exists.x0.node Formula)
   (fol.forall.x1.node Formula)
   (fol.exists.x1.node Formula)
   (fol.eq.node Term.node Term.node)
   (fol.forall.x0.round Formula)
   (fol.exists.x0.round Formula)
   (fol.forall.x1.round Formula)
   (fol.exists.x1.round Formula)
   (fol.eq.round Term.round Term.round)
   (fol.forall.x0.value Formula)
   (fol.exists.x0.value Formula)
   (fol.forall.x1.value Formula)
   (fol.exists.x1.value Formula)
   (fol.eq.value Term.value Term.value)
   (fol.atom.any_msg Term.round)
   (fol.atom.c_member Term.node Term.c_quorum)
   (fol.atom.decision Term.node Term.round Term.value)
   (fol.atom.f_member Term.node Term.f_quorum)
   (fol.atom.fast Term.round)
   (fol.atom.le Term.round Term.round)
   (fol.atom.left_rnd Term.node Term.round)
   (fol.atom.one_a Term.round)
   (fol.atom.one_b Term.node Term.round)
   (fol.atom.one_b_max_vote Term.node Term.round Term.round Term.value)
   (fol.atom.proposal Term.round Term.value)
   (fol.atom.vote Term.node Term.round Term.value))
  ((fol.var.x0.c_quorum)
   (fol.var.x1.c_quorum))
  ((fol.var.x0.f_quorum)
   (fol.var.x1.f_quorum))
  ((fol.var.x0.node)
   (fol.var.x1.node))
  ((fol.var.x0.round)
   (fol.var.x1.round)
   (fol.term.none))
  ((fol.var.x0.value)
   (fol.var.x1.value))))

(define-finite FoAsp (record (model Model) (x0.c_quorum c_quorum) (x1.c_quorum c_quorum) (x0.f_quorum f_quorum) (x1.f_quorum f_quorum) (x0.node node) (x1.node node) (x0.round round) (x1.round round) (x0.value value) (x1.value value)))

(define-semantics
  ((Term.c_quorum.Sem (term Term.c_quorum) (asp FoAsp)))
  :returns c_quorum
  ((match term
     ((fol.var.x0.c_quorum) (x0.c_quorum asp))
     ((fol.var.x1.c_quorum) (x1.c_quorum asp))
  )))

(define-semantics
  ((Term.f_quorum.Sem (term Term.f_quorum) (asp FoAsp)))
  :returns f_quorum
  ((match term
     ((fol.var.x0.f_quorum) (x0.f_quorum asp))
     ((fol.var.x1.f_quorum) (x1.f_quorum asp))
  )))

(define-semantics
  ((Term.node.Sem (term Term.node) (asp FoAsp)))
  :returns node
  ((match term
     ((fol.var.x0.node) (x0.node asp))
     ((fol.var.x1.node) (x1.node asp))
  )))

(define-semantics
  ((Term.round.Sem (term Term.round) (asp FoAsp)))
  :returns round
  ((match term
     ((fol.var.x0.round) (x0.round asp))
     ((fol.var.x1.round) (x1.round asp))
     ((fol.term.none) none)
  )))

(define-semantics
  ((Term.value.Sem (term Term.value) (asp FoAsp)))
  :returns value
  ((match term
     ((fol.var.x0.value) (x0.value asp))
     ((fol.var.x1.value) (x1.value asp))
  )))

(define-semantics
  ((FO.Sem (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) false)
     ((fol.not p) (not (FO.Sem p asp)))
     ((fol.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.forall.x0.c_quorum p)
      (forall ((v (domain (c_quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1.c_quorum asp) (x0.f_quorum asp) (x1.f_quorum asp) (x0.node asp) (x1.node asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.exists.x0.c_quorum p)
      (exists ((v (domain (c_quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1.c_quorum asp) (x0.f_quorum asp) (x1.f_quorum asp) (x0.node asp) (x1.node asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.forall.x1.c_quorum p)
      (forall ((v (domain (c_quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) v (x0.f_quorum asp) (x1.f_quorum asp) (x0.node asp) (x1.node asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.exists.x1.c_quorum p)
      (exists ((v (domain (c_quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) v (x0.f_quorum asp) (x1.f_quorum asp) (x0.node asp) (x1.node asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.eq.c_quorum lhs rhs)
      (= (Term.c_quorum.Sem lhs asp) (Term.c_quorum.Sem rhs asp)))
     ((fol.forall.x0.f_quorum p)
      (forall ((v (domain (f_quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) v (x1.f_quorum asp) (x0.node asp) (x1.node asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.exists.x0.f_quorum p)
      (exists ((v (domain (f_quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) v (x1.f_quorum asp) (x0.node asp) (x1.node asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.forall.x1.f_quorum p)
      (forall ((v (domain (f_quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) (x0.f_quorum asp) v (x0.node asp) (x1.node asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.exists.x1.f_quorum p)
      (exists ((v (domain (f_quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) (x0.f_quorum asp) v (x0.node asp) (x1.node asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.eq.f_quorum lhs rhs)
      (= (Term.f_quorum.Sem lhs asp) (Term.f_quorum.Sem rhs asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) (x0.f_quorum asp) (x1.f_quorum asp) v (x1.node asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.exists.x0.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) (x0.f_quorum asp) (x1.f_quorum asp) v (x1.node asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) (x0.f_quorum asp) (x1.f_quorum asp) (x0.node asp) v (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.exists.x1.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) (x0.f_quorum asp) (x1.f_quorum asp) (x0.node asp) v (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.eq.node lhs rhs)
      (= (Term.node.Sem lhs asp) (Term.node.Sem rhs asp)))
     ((fol.forall.x0.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) (x0.f_quorum asp) (x1.f_quorum asp) (x0.node asp) (x1.node asp) v (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.exists.x0.round p)
      (exists ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) (x0.f_quorum asp) (x1.f_quorum asp) (x0.node asp) (x1.node asp) v (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.forall.x1.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) (x0.f_quorum asp) (x1.f_quorum asp) (x0.node asp) (x1.node asp) (x0.round asp) v (x0.value asp) (x1.value asp)))))
     ((fol.exists.x1.round p)
      (exists ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) (x0.f_quorum asp) (x1.f_quorum asp) (x0.node asp) (x1.node asp) (x0.round asp) v (x0.value asp) (x1.value asp)))))
     ((fol.eq.round lhs rhs)
      (= (Term.round.Sem lhs asp) (Term.round.Sem rhs asp)))
     ((fol.forall.x0.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) (x0.f_quorum asp) (x1.f_quorum asp) (x0.node asp) (x1.node asp) (x0.round asp) (x1.round asp) v (x1.value asp)))))
     ((fol.exists.x0.value p)
      (exists ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) (x0.f_quorum asp) (x1.f_quorum asp) (x0.node asp) (x1.node asp) (x0.round asp) (x1.round asp) v (x1.value asp)))))
     ((fol.forall.x1.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) (x0.f_quorum asp) (x1.f_quorum asp) (x0.node asp) (x1.node asp) (x0.round asp) (x1.round asp) (x0.value asp) v))))
     ((fol.exists.x1.value p)
      (exists ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.c_quorum asp) (x1.c_quorum asp) (x0.f_quorum asp) (x1.f_quorum asp) (x0.node asp) (x1.node asp) (x0.round asp) (x1.round asp) (x0.value asp) v))))
     ((fol.eq.value lhs rhs)
      (= (Term.value.Sem lhs asp) (Term.value.Sem rhs asp)))
     ((fol.atom.any_msg a0) (any_msg (Term.round.Sem a0 asp)))
     ((fol.atom.c_member a0 a1) (c_member (Term.node.Sem a0 asp) (Term.c_quorum.Sem a1 asp)))
     ((fol.atom.decision a0 a1 a2) (decision (Term.node.Sem a0 asp) (Term.round.Sem a1 asp) (Term.value.Sem a2 asp)))
     ((fol.atom.f_member a0 a1) (f_member (Term.node.Sem a0 asp) (Term.f_quorum.Sem a1 asp)))
     ((fol.atom.fast a0) (fast (Term.round.Sem a0 asp)))
     ((fol.atom.le a0 a1) (le (Term.round.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.left_rnd a0 a1) (left_rnd (Term.node.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.one_a a0) (one_a (Term.round.Sem a0 asp)))
     ((fol.atom.one_b a0 a1) (one_b (Term.node.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.one_b_max_vote a0 a1 a2 a3) (one_b_max_vote (Term.node.Sem a0 asp) (Term.round.Sem a1 asp) (Term.round.Sem a2 asp) (Term.value.Sem a3 asp)))
     ((fol.atom.proposal a0 a1) (proposal (Term.round.Sem a0 asp) (Term.value.Sem a1 asp)))
     ((fol.atom.vote a0 a1 a2) (vote (Term.node.Sem a0 asp) (Term.round.Sem a1 asp) (Term.value.Sem a2 asp)))
  )))
