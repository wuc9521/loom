(provide chord.node chord.tp1.n0 chord.bs.f chord.bs.p chord.live chord.prd chord.prd_proj chord.ring.btw chord.scheduled_rectify chord.scheduled_stabilize chord.stable chord.started Formula FoAsp Term.chord.node Term.chord.node.Sem FO.Sem fol.true fol.false fol.not fol.and fol.or fol.forall.x0.chord.node fol.exists.x0.chord.node fol.forall.x1.chord.node fol.exists.x1.chord.node fol.eq.chord.node fol.atom.chord.bs.f fol.atom.chord.bs.p fol.atom.chord.live fol.atom.chord.prd fol.atom.chord.prd_proj fol.atom.chord.ring.btw fol.atom.chord.scheduled_rectify fol.atom.chord.scheduled_stabilize fol.atom.chord.stable fol.atom.chord.started fol.var.x0.chord.node fol.var.x1.chord.node fol.term.chord.tp1.n0)
(set-logic ALL)
(declare-sort chord.node 0)
(declare-fun chord.tp1.n0 () chord.node)
(declare-fun chord.bs.f (chord.node chord.node) Bool)
(declare-fun chord.bs.p (chord.node chord.node chord.node) Bool)
(declare-fun chord.live (chord.node) Bool)
(declare-fun chord.prd (chord.node chord.node) Bool)
(declare-fun chord.prd_proj (chord.node) Bool)
(declare-fun chord.ring.btw (chord.node chord.node chord.node) Bool)
(declare-fun chord.scheduled_rectify (chord.node chord.node) Bool)
(declare-fun chord.scheduled_stabilize (chord.node chord.node) Bool)
(declare-fun chord.stable () Bool)
(declare-fun chord.started () Bool)

(declare-term-types
 ((Formula 0) (Term.chord.node 0))
 (((fol.true)
   (fol.false)
   (fol.not Formula)
   (fol.and Formula Formula)
   (fol.or Formula Formula)
   (fol.forall.x0.chord.node Formula)
   (fol.exists.x0.chord.node Formula)
   (fol.forall.x1.chord.node Formula)
   (fol.exists.x1.chord.node Formula)
   (fol.eq.chord.node Term.chord.node Term.chord.node)
   (fol.atom.chord.bs.f Term.chord.node Term.chord.node)
   (fol.atom.chord.bs.p Term.chord.node Term.chord.node Term.chord.node)
   (fol.atom.chord.live Term.chord.node)
   (fol.atom.chord.prd Term.chord.node Term.chord.node)
   (fol.atom.chord.prd_proj Term.chord.node)
   (fol.atom.chord.ring.btw Term.chord.node Term.chord.node Term.chord.node)
   (fol.atom.chord.scheduled_rectify Term.chord.node Term.chord.node)
   (fol.atom.chord.scheduled_stabilize Term.chord.node Term.chord.node)
   (fol.atom.chord.stable )
   (fol.atom.chord.started ))
  ((fol.var.x0.chord.node)
   (fol.var.x1.chord.node)
   (fol.term.chord.tp1.n0))))

(define-finite FoAsp (record (model Model) (x0.chord.node chord.node) (x1.chord.node chord.node)))

(define-semantics
  ((Term.chord.node.Sem (term Term.chord.node) (asp FoAsp)))
  :returns chord.node
  ((match term
     ((fol.var.x0.chord.node) (x0.chord.node asp))
     ((fol.var.x1.chord.node) (x1.chord.node asp))
     ((fol.term.chord.tp1.n0) chord.tp1.n0)
  )))

(define-semantics
  ((FO.Sem (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) false)
     ((fol.not p) (not (FO.Sem p asp)))
     ((fol.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.forall.x0.chord.node p)
      (forall ((v (domain (chord.node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1.chord.node asp)))))
     ((fol.exists.x0.chord.node p)
      (exists ((v (domain (chord.node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1.chord.node asp)))))
     ((fol.forall.x1.chord.node p)
      (forall ((v (domain (chord.node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.chord.node asp) v))))
     ((fol.exists.x1.chord.node p)
      (exists ((v (domain (chord.node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.chord.node asp) v))))
     ((fol.eq.chord.node lhs rhs)
      (= (Term.chord.node.Sem lhs asp) (Term.chord.node.Sem rhs asp)))
     ((fol.atom.chord.bs.f a0 a1) (chord.bs.f (Term.chord.node.Sem a0 asp) (Term.chord.node.Sem a1 asp)))
     ((fol.atom.chord.bs.p a0 a1 a2) (chord.bs.p (Term.chord.node.Sem a0 asp) (Term.chord.node.Sem a1 asp) (Term.chord.node.Sem a2 asp)))
     ((fol.atom.chord.live a0) (chord.live (Term.chord.node.Sem a0 asp)))
     ((fol.atom.chord.prd a0 a1) (chord.prd (Term.chord.node.Sem a0 asp) (Term.chord.node.Sem a1 asp)))
     ((fol.atom.chord.prd_proj a0) (chord.prd_proj (Term.chord.node.Sem a0 asp)))
     ((fol.atom.chord.ring.btw a0 a1 a2) (chord.ring.btw (Term.chord.node.Sem a0 asp) (Term.chord.node.Sem a1 asp) (Term.chord.node.Sem a2 asp)))
     ((fol.atom.chord.scheduled_rectify a0 a1) (chord.scheduled_rectify (Term.chord.node.Sem a0 asp) (Term.chord.node.Sem a1 asp)))
     ((fol.atom.chord.scheduled_stabilize a0 a1) (chord.scheduled_stabilize (Term.chord.node.Sem a0 asp) (Term.chord.node.Sem a1 asp)))
     ((fol.atom.chord.stable ) (chord.stable))
     ((fol.atom.chord.started ) (chord.started))
  )))
