(provide inst node quorum round value votemap none stop maxr maxv active decision inst_le joined_round le left_round member one_a one_b_msg proposal vote Formula FoAsp Term.inst Term.inst.Sem Term.node Term.node.Sem Term.quorum Term.quorum.Sem Term.round Term.round.Sem Term.value Term.value.Sem Term.votemap Term.votemap.Sem FO.Sem fol.true fol.false fol.not fol.and fol.or fol.forall.x0.inst fol.exists.x0.inst fol.forall.x1.inst fol.exists.x1.inst fol.eq.inst fol.forall.x0.node fol.exists.x0.node fol.forall.x1.node fol.exists.x1.node fol.eq.node fol.forall.x0.quorum fol.exists.x0.quorum fol.forall.x1.quorum fol.exists.x1.quorum fol.eq.quorum fol.forall.x0.round fol.exists.x0.round fol.forall.x1.round fol.exists.x1.round fol.eq.round fol.forall.x0.value fol.exists.x0.value fol.forall.x1.value fol.exists.x1.value fol.eq.value fol.forall.x0.votemap fol.exists.x0.votemap fol.forall.x1.votemap fol.exists.x1.votemap fol.eq.votemap fol.atom.active fol.atom.decision fol.atom.inst_le fol.atom.joined_round fol.atom.le fol.atom.left_round fol.atom.member fol.atom.one_a fol.atom.one_b_msg fol.atom.proposal fol.atom.vote fol.var.x0.inst fol.var.x1.inst fol.var.x0.node fol.var.x1.node fol.var.x0.quorum fol.var.x1.quorum fol.var.x0.round fol.var.x1.round fol.term.none fol.term.maxr fol.var.x0.value fol.var.x1.value fol.term.stop fol.term.maxv fol.var.x0.votemap fol.var.x1.votemap)
(set-logic ALL)
(declare-sort inst 0)
(declare-sort node 0)
(declare-sort quorum 0)
(declare-sort round 0)
(declare-sort value 0)
(declare-sort votemap 0)
(declare-fun none () round)
(declare-fun stop () value)
(declare-fun maxr (votemap inst) round)
(declare-fun maxv (votemap inst) value)
(declare-fun active (round) Bool)
(declare-fun decision (node inst round value) Bool)
(declare-fun inst_le (inst inst) Bool)
(declare-fun joined_round (node round) Bool)
(declare-fun le (round round) Bool)
(declare-fun left_round (node round) Bool)
(declare-fun member (node quorum) Bool)
(declare-fun one_a (round) Bool)
(declare-fun one_b_msg (node round votemap) Bool)
(declare-fun proposal (inst round value) Bool)
(declare-fun vote (node inst round value) Bool)

(declare-term-types
 ((Formula 0) (Term.inst 0) (Term.node 0) (Term.quorum 0) (Term.round 0) (Term.value 0) (Term.votemap 0))
 (((fol.true)
   (fol.false)
   (fol.not Formula)
   (fol.and Formula Formula)
   (fol.or Formula Formula)
   (fol.forall.x0.inst Formula)
   (fol.exists.x0.inst Formula)
   (fol.forall.x1.inst Formula)
   (fol.exists.x1.inst Formula)
   (fol.eq.inst Term.inst Term.inst)
   (fol.forall.x0.node Formula)
   (fol.exists.x0.node Formula)
   (fol.forall.x1.node Formula)
   (fol.exists.x1.node Formula)
   (fol.eq.node Term.node Term.node)
   (fol.forall.x0.quorum Formula)
   (fol.exists.x0.quorum Formula)
   (fol.forall.x1.quorum Formula)
   (fol.exists.x1.quorum Formula)
   (fol.eq.quorum Term.quorum Term.quorum)
   (fol.forall.x0.round Formula)
   (fol.exists.x0.round Formula)
   (fol.forall.x1.round Formula)
   (fol.exists.x1.round Formula)
   (fol.eq.round Term.round Term.round)
   (fol.forall.x0.value Formula)
   (fol.exists.x0.value Formula)
   (fol.forall.x1.value Formula)
   (fol.exists.x1.value Formula)
   (fol.eq.value Term.value Term.value)
   (fol.forall.x0.votemap Formula)
   (fol.exists.x0.votemap Formula)
   (fol.forall.x1.votemap Formula)
   (fol.exists.x1.votemap Formula)
   (fol.eq.votemap Term.votemap Term.votemap)
   (fol.atom.active Term.round)
   (fol.atom.decision Term.node Term.inst Term.round Term.value)
   (fol.atom.inst_le Term.inst Term.inst)
   (fol.atom.joined_round Term.node Term.round)
   (fol.atom.le Term.round Term.round)
   (fol.atom.left_round Term.node Term.round)
   (fol.atom.member Term.node Term.quorum)
   (fol.atom.one_a Term.round)
   (fol.atom.one_b_msg Term.node Term.round Term.votemap)
   (fol.atom.proposal Term.inst Term.round Term.value)
   (fol.atom.vote Term.node Term.inst Term.round Term.value))
  ((fol.var.x0.inst)
   (fol.var.x1.inst))
  ((fol.var.x0.node)
   (fol.var.x1.node))
  ((fol.var.x0.quorum)
   (fol.var.x1.quorum))
  ((fol.var.x0.round)
   (fol.var.x1.round)
   (fol.term.none)
   (fol.term.maxr Term.votemap Term.inst))
  ((fol.var.x0.value)
   (fol.var.x1.value)
   (fol.term.stop)
   (fol.term.maxv Term.votemap Term.inst))
  ((fol.var.x0.votemap)
   (fol.var.x1.votemap))))

(define-finite FoAsp (record (model Model) (x0.inst inst) (x1.inst inst) (x0.node node) (x1.node node) (x0.quorum quorum) (x1.quorum quorum) (x0.round round) (x1.round round) (x0.value value) (x1.value value) (x0.votemap votemap) (x1.votemap votemap)))

(define-semantics
  ((Term.inst.Sem (term Term.inst) (asp FoAsp)))
  :returns inst
  ((match term
     ((fol.var.x0.inst) (x0.inst asp))
     ((fol.var.x1.inst) (x1.inst asp))
  )))

(define-semantics
  ((Term.node.Sem (term Term.node) (asp FoAsp)))
  :returns node
  ((match term
     ((fol.var.x0.node) (x0.node asp))
     ((fol.var.x1.node) (x1.node asp))
  )))

(define-semantics
  ((Term.quorum.Sem (term Term.quorum) (asp FoAsp)))
  :returns quorum
  ((match term
     ((fol.var.x0.quorum) (x0.quorum asp))
     ((fol.var.x1.quorum) (x1.quorum asp))
  )))

(define-semantics
  ((Term.round.Sem (term Term.round) (asp FoAsp)))
  :returns round
  ((match term
     ((fol.var.x0.round) (x0.round asp))
     ((fol.var.x1.round) (x1.round asp))
     ((fol.term.none) none)
     ((fol.term.maxr a0 a1) (maxr (Term.votemap.Sem a0 asp) (Term.inst.Sem a1 asp)))
  )))

(define-semantics
  ((Term.value.Sem (term Term.value) (asp FoAsp)))
  :returns value
  ((match term
     ((fol.var.x0.value) (x0.value asp))
     ((fol.var.x1.value) (x1.value asp))
     ((fol.term.stop) stop)
     ((fol.term.maxv a0 a1) (maxv (Term.votemap.Sem a0 asp) (Term.inst.Sem a1 asp)))
  )))

(define-semantics
  ((Term.votemap.Sem (term Term.votemap) (asp FoAsp)))
  :returns votemap
  ((match term
     ((fol.var.x0.votemap) (x0.votemap asp))
     ((fol.var.x1.votemap) (x1.votemap asp))
  )))

(define-semantics
  ((FO.Sem (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) false)
     ((fol.not p) (not (FO.Sem p asp)))
     ((fol.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.forall.x0.inst p)
      (forall ((v (domain (inst (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.exists.x0.inst p)
      (exists ((v (domain (inst (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.forall.x1.inst p)
      (forall ((v (domain (inst (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) v (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.exists.x1.inst p)
      (exists ((v (domain (inst (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) v (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.eq.inst lhs rhs)
      (= (Term.inst.Sem lhs asp) (Term.inst.Sem rhs asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) v (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.exists.x0.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) v (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) v (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.exists.x1.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) v (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.eq.node lhs rhs)
      (= (Term.node.Sem lhs asp) (Term.node.Sem rhs asp)))
     ((fol.forall.x0.quorum p)
      (forall ((v (domain (quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) v (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.exists.x0.quorum p)
      (exists ((v (domain (quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) v (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.forall.x1.quorum p)
      (forall ((v (domain (quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) v (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.exists.x1.quorum p)
      (exists ((v (domain (quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) v (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.eq.quorum lhs rhs)
      (= (Term.quorum.Sem lhs asp) (Term.quorum.Sem rhs asp)))
     ((fol.forall.x0.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) v (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.exists.x0.round p)
      (exists ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) v (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.forall.x1.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) v (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.exists.x1.round p)
      (exists ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) v (x0.value asp) (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.eq.round lhs rhs)
      (= (Term.round.Sem lhs asp) (Term.round.Sem rhs asp)))
     ((fol.forall.x0.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) v (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.exists.x0.value p)
      (exists ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) v (x1.value asp) (x0.votemap asp) (x1.votemap asp)))))
     ((fol.forall.x1.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) v (x0.votemap asp) (x1.votemap asp)))))
     ((fol.exists.x1.value p)
      (exists ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) v (x0.votemap asp) (x1.votemap asp)))))
     ((fol.eq.value lhs rhs)
      (= (Term.value.Sem lhs asp) (Term.value.Sem rhs asp)))
     ((fol.forall.x0.votemap p)
      (forall ((v (domain (votemap (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) v (x1.votemap asp)))))
     ((fol.exists.x0.votemap p)
      (exists ((v (domain (votemap (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) v (x1.votemap asp)))))
     ((fol.forall.x1.votemap p)
      (forall ((v (domain (votemap (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) v))))
     ((fol.exists.x1.votemap p)
      (exists ((v (domain (votemap (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.inst asp) (x1.inst asp) (x0.node asp) (x1.node asp) (x0.quorum asp) (x1.quorum asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp) (x0.votemap asp) v))))
     ((fol.eq.votemap lhs rhs)
      (= (Term.votemap.Sem lhs asp) (Term.votemap.Sem rhs asp)))
     ((fol.atom.active a0) (active (Term.round.Sem a0 asp)))
     ((fol.atom.decision a0 a1 a2 a3) (decision (Term.node.Sem a0 asp) (Term.inst.Sem a1 asp) (Term.round.Sem a2 asp) (Term.value.Sem a3 asp)))
     ((fol.atom.inst_le a0 a1) (inst_le (Term.inst.Sem a0 asp) (Term.inst.Sem a1 asp)))
     ((fol.atom.joined_round a0 a1) (joined_round (Term.node.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.le a0 a1) (le (Term.round.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.left_round a0 a1) (left_round (Term.node.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.member a0 a1) (member (Term.node.Sem a0 asp) (Term.quorum.Sem a1 asp)))
     ((fol.atom.one_a a0) (one_a (Term.round.Sem a0 asp)))
     ((fol.atom.one_b_msg a0 a1 a2) (one_b_msg (Term.node.Sem a0 asp) (Term.round.Sem a1 asp) (Term.votemap.Sem a2 asp)))
     ((fol.atom.proposal a0 a1 a2) (proposal (Term.inst.Sem a0 asp) (Term.round.Sem a1 asp) (Term.value.Sem a2 asp)))
     ((fol.atom.vote a0 a1 a2 a3) (vote (Term.node.Sem a0 asp) (Term.inst.Sem a1 asp) (Term.round.Sem a2 asp) (Term.value.Sem a3 asp)))
  )))
