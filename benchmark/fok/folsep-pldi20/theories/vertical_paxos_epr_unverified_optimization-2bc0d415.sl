(provide config node quorum round value master_minrel none quorum_of_round configure_round_msg decision irrelevant_msg joined_round le left_rnd member minrelof one_a one_b_max_vote proposal quorumin vote Formula FoAsp Term.config Term.config.Sem Term.node Term.node.Sem Term.quorum Term.quorum.Sem Term.round Term.round.Sem Term.value Term.value.Sem FO.Sem FO.Valid fol.true fol.false fol.not fol.and fol.or fol.forall.x0.config fol.exists.x0.config fol.forall.x1.config fol.exists.x1.config fol.eq.config fol.forall.x0.node fol.exists.x0.node fol.forall.x1.node fol.exists.x1.node fol.eq.node fol.forall.x0.quorum fol.exists.x0.quorum fol.forall.x1.quorum fol.exists.x1.quorum fol.eq.quorum fol.forall.x0.round fol.exists.x0.round fol.forall.x1.round fol.exists.x1.round fol.eq.round fol.forall.x0.value fol.exists.x0.value fol.forall.x1.value fol.exists.x1.value fol.eq.value fol.atom.configure_round_msg fol.atom.decision fol.atom.irrelevant_msg fol.atom.joined_round fol.atom.le fol.atom.left_rnd fol.atom.member fol.atom.minrelof fol.atom.one_a fol.atom.one_b_max_vote fol.atom.proposal fol.atom.quorumin fol.atom.vote fol.var.x0.config fol.var.x1.config fol.var.x0.node fol.var.x1.node fol.var.x0.quorum fol.var.x1.quorum fol.term.quorum_of_round fol.var.x0.round fol.var.x1.round fol.term.master_minrel fol.term.none fol.var.x0.value fol.var.x1.value)
(set-logic ALL)
(declare-sort config 0)
(declare-sort node 0)
(declare-sort quorum 0)
(declare-sort round 0)
(declare-sort value 0)
(declare-fun master_minrel () round)
(declare-fun none () round)
(declare-fun quorum_of_round (round) quorum)
(declare-fun configure_round_msg (round config) Bool)
(declare-fun decision (node round value) Bool)
(declare-fun irrelevant_msg (round) Bool)
(declare-fun joined_round (node round) Bool)
(declare-fun le (round round) Bool)
(declare-fun left_rnd (node round) Bool)
(declare-fun member (node quorum) Bool)
(declare-fun minrelof (config round) Bool)
(declare-fun one_a (round round) Bool)
(declare-fun one_b_max_vote (node round round value) Bool)
(declare-fun proposal (round value) Bool)
(declare-fun quorumin (quorum config) Bool)
(declare-fun vote (node round value) Bool)

(declare-term-types
 ((Formula 0) (Term.config 0) (Term.node 0) (Term.quorum 0) (Term.round 0) (Term.value 0))
 (((fol.true)
   (fol.false)
   (fol.not Formula)
   (fol.and Formula Formula)
   (fol.or Formula Formula)
   (fol.forall.x0.config Formula)
   (fol.exists.x0.config Formula)
   (fol.forall.x1.config Formula)
   (fol.exists.x1.config Formula)
   (fol.eq.config Term.config Term.config)
   (fol.forall.x0.node Formula)
   (fol.exists.x0.node Formula)
   (fol.forall.x1.node Formula)
   (fol.exists.x1.node Formula)
   (fol.eq.node Term.node Term.node)
   (fol.forall.x0.quorum Formula)
   (fol.exists.x0.quorum Formula)
   (fol.forall.x1.quorum Formula)
   (fol.exists.x1.quorum Formula)
   (fol.eq.quorum Term.quorum Term.quorum)
   (fol.forall.x0.round Formula)
   (fol.exists.x0.round Formula)
   (fol.forall.x1.round Formula)
   (fol.exists.x1.round Formula)
   (fol.eq.round Term.round Term.round)
   (fol.forall.x0.value Formula)
   (fol.exists.x0.value Formula)
   (fol.forall.x1.value Formula)
   (fol.exists.x1.value Formula)
   (fol.eq.value Term.value Term.value)
   (fol.atom.configure_round_msg Term.round Term.config)
   (fol.atom.decision Term.node Term.round Term.value)
   (fol.atom.irrelevant_msg Term.round)
   (fol.atom.joined_round Term.node Term.round)
   (fol.atom.le Term.round Term.round)
   (fol.atom.left_rnd Term.node Term.round)
   (fol.atom.member Term.node Term.quorum)
   (fol.atom.minrelof Term.config Term.round)
   (fol.atom.one_a Term.round Term.round)
   (fol.atom.one_b_max_vote Term.node Term.round Term.round Term.value)
   (fol.atom.proposal Term.round Term.value)
   (fol.atom.quorumin Term.quorum Term.config)
   (fol.atom.vote Term.node Term.round Term.value))
  ((fol.var.x0.config)
   (fol.var.x1.config))
  ((fol.var.x0.node)
   (fol.var.x1.node))
  ((fol.var.x0.quorum)
   (fol.var.x1.quorum)
   (fol.term.quorum_of_round Term.round))
  ((fol.var.x0.round)
   (fol.var.x1.round)
   (fol.term.master_minrel)
   (fol.term.none))
  ((fol.var.x0.value)
   (fol.var.x1.value))))

(define-finite FoAsp (record (model Model) (x0 (union fol.bot config node quorum round value)) (x1 (union fol.bot config node quorum round value))))

(define-semantics
  ((Term.config.Sem (term Term.config) (asp FoAsp)))
  :returns config
  ((match term
     ((fol.var.x0.config) (x0 asp))
     ((fol.var.x1.config) (x1 asp))
  )))

(define-semantics
  ((Term.node.Sem (term Term.node) (asp FoAsp)))
  :returns node
  ((match term
     ((fol.var.x0.node) (x0 asp))
     ((fol.var.x1.node) (x1 asp))
  )))

(define-semantics
  ((Term.quorum.Sem (term Term.quorum) (asp FoAsp)))
  :returns quorum
  ((match term
     ((fol.var.x0.quorum) (x0 asp))
     ((fol.var.x1.quorum) (x1 asp))
     ((fol.term.quorum_of_round a0) (quorum_of_round (Term.round.Sem a0 asp)))
  )))

(define-semantics
  ((Term.round.Sem (term Term.round) (asp FoAsp)))
  :returns round
  ((match term
     ((fol.var.x0.round) (x0 asp))
     ((fol.var.x1.round) (x1 asp))
     ((fol.term.master_minrel) master_minrel)
     ((fol.term.none) none)
  )))

(define-semantics
  ((Term.value.Sem (term Term.value) (asp FoAsp)))
  :returns value
  ((match term
     ((fol.var.x0.value) (x0 asp))
     ((fol.var.x1.value) (x1 asp))
  )))

(define-semantics
  ((FO.Sem (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) false)
     ((fol.not p) (not (FO.Sem p asp)))
     ((fol.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.forall.x0.config p)
      (forall ((v (domain (config (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.config p)
      (exists ((v (domain (config (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.config p)
      (forall ((v (domain (config (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.config p)
      (exists ((v (domain (config (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.config lhs rhs)
      (= (Term.config.Sem lhs asp) (Term.config.Sem rhs asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (= (Term.node.Sem lhs asp) (Term.node.Sem rhs asp)))
     ((fol.forall.x0.quorum p)
      (forall ((v (domain (quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum p)
      (exists ((v (domain (quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum p)
      (forall ((v (domain (quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum p)
      (exists ((v (domain (quorum (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum lhs rhs)
      (= (Term.quorum.Sem lhs asp) (Term.quorum.Sem rhs asp)))
     ((fol.forall.x0.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.round p)
      (exists ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.round p)
      (exists ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.round lhs rhs)
      (= (Term.round.Sem lhs asp) (Term.round.Sem rhs asp)))
     ((fol.forall.x0.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.value p)
      (exists ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.value p)
      (exists ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.value lhs rhs)
      (= (Term.value.Sem lhs asp) (Term.value.Sem rhs asp)))
     ((fol.atom.configure_round_msg a0 a1) (configure_round_msg (Term.round.Sem a0 asp) (Term.config.Sem a1 asp)))
     ((fol.atom.decision a0 a1 a2) (decision (Term.node.Sem a0 asp) (Term.round.Sem a1 asp) (Term.value.Sem a2 asp)))
     ((fol.atom.irrelevant_msg a0) (irrelevant_msg (Term.round.Sem a0 asp)))
     ((fol.atom.joined_round a0 a1) (joined_round (Term.node.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.le a0 a1) (le (Term.round.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.left_rnd a0 a1) (left_rnd (Term.node.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.member a0 a1) (member (Term.node.Sem a0 asp) (Term.quorum.Sem a1 asp)))
     ((fol.atom.minrelof a0 a1) (minrelof (Term.config.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.one_a a0 a1) (one_a (Term.round.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.one_b_max_vote a0 a1 a2 a3) (one_b_max_vote (Term.node.Sem a0 asp) (Term.round.Sem a1 asp) (Term.round.Sem a2 asp) (Term.value.Sem a3 asp)))
     ((fol.atom.proposal a0 a1) (proposal (Term.round.Sem a0 asp) (Term.value.Sem a1 asp)))
     ((fol.atom.quorumin a0 a1) (quorumin (Term.quorum.Sem a0 asp) (Term.config.Sem a1 asp)))
     ((fol.atom.vote a0 a1 a2) (vote (Term.node.Sem a0 asp) (Term.round.Sem a1 asp) (Term.value.Sem a2 asp)))
  )))

(define-semantics
  ((FO.Valid (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) true)
     ((fol.not p) (FO.Valid p asp))
     ((fol.and p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.or p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.forall.x0.config p)
      (forall ((v (domain (config (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.config p)
      (forall ((v (domain (config (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.config p)
      (forall ((v (domain (config (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.config p)
      (forall ((v (domain (config (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.config lhs rhs)
      (and (exists ((v (domain (config (model asp))))) (= (Term.config.Sem lhs asp) v)) (exists ((v (domain (config (model asp))))) (= (Term.config.Sem rhs asp) v))))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem lhs asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem rhs asp) v))))
     ((fol.forall.x0.quorum p)
      (forall ((v (domain (quorum (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum p)
      (forall ((v (domain (quorum (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum p)
      (forall ((v (domain (quorum (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum p)
      (forall ((v (domain (quorum (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum lhs rhs)
      (and (exists ((v (domain (quorum (model asp))))) (= (Term.quorum.Sem lhs asp) v)) (exists ((v (domain (quorum (model asp))))) (= (Term.quorum.Sem rhs asp) v))))
     ((fol.forall.x0.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.round lhs rhs)
      (and (exists ((v (domain (round (model asp))))) (= (Term.round.Sem lhs asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem rhs asp) v))))
     ((fol.forall.x0.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.value lhs rhs)
      (and (exists ((v (domain (value (model asp))))) (= (Term.value.Sem lhs asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem rhs asp) v))))
     ((fol.atom.configure_round_msg a0 a1) (and (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a0 asp) v)) (exists ((v (domain (config (model asp))))) (= (Term.config.Sem a1 asp) v))))
     ((fol.atom.decision a0 a1 a2) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a1 asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem a2 asp) v))))
     ((fol.atom.irrelevant_msg a0) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a0 asp) v)))
     ((fol.atom.joined_round a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a1 asp) v))))
     ((fol.atom.le a0 a1) (and (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a0 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a1 asp) v))))
     ((fol.atom.left_rnd a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a1 asp) v))))
     ((fol.atom.member a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (quorum (model asp))))) (= (Term.quorum.Sem a1 asp) v))))
     ((fol.atom.minrelof a0 a1) (and (exists ((v (domain (config (model asp))))) (= (Term.config.Sem a0 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a1 asp) v))))
     ((fol.atom.one_a a0 a1) (and (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a0 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a1 asp) v))))
     ((fol.atom.one_b_max_vote a0 a1 a2 a3) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a1 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a2 asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem a3 asp) v))))
     ((fol.atom.proposal a0 a1) (and (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a0 asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem a1 asp) v))))
     ((fol.atom.quorumin a0 a1) (and (exists ((v (domain (quorum (model asp))))) (= (Term.quorum.Sem a0 asp) v)) (exists ((v (domain (config (model asp))))) (= (Term.config.Sem a1 asp) v))))
     ((fol.atom.vote a0 a1 a2) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a1 asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem a2 asp) v))))
  )))
