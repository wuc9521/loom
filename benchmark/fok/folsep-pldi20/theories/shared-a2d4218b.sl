(provide node quorum_a quorum_b quorum_c value dec done input member_a member_b member_c member_f rcv_msg rcv_msg_proj sent_msg sent_msg_proj und_cons und_cons_dec Formula FoAsp Term.node Term.node.Sem Term.quorum_a Term.quorum_a.Sem Term.quorum_b Term.quorum_b.Sem Term.quorum_c Term.quorum_c.Sem Term.value Term.value.Sem FO.Sem FO.Valid fol.true fol.false fol.not fol.and fol.or fol.forall.x0.node fol.exists.x0.node fol.forall.x1.node fol.exists.x1.node fol.eq.node fol.forall.x0.quorum_a fol.exists.x0.quorum_a fol.forall.x1.quorum_a fol.exists.x1.quorum_a fol.eq.quorum_a fol.forall.x0.quorum_b fol.exists.x0.quorum_b fol.forall.x1.quorum_b fol.exists.x1.quorum_b fol.eq.quorum_b fol.forall.x0.quorum_c fol.exists.x0.quorum_c fol.forall.x1.quorum_c fol.exists.x1.quorum_c fol.eq.quorum_c fol.forall.x0.value fol.exists.x0.value fol.forall.x1.value fol.exists.x1.value fol.eq.value fol.atom.dec fol.atom.done fol.atom.input fol.atom.member_a fol.atom.member_b fol.atom.member_c fol.atom.member_f fol.atom.rcv_msg fol.atom.rcv_msg_proj fol.atom.sent_msg fol.atom.sent_msg_proj fol.atom.und_cons fol.atom.und_cons_dec fol.var.x0.node fol.var.x1.node fol.var.x0.quorum_a fol.var.x1.quorum_a fol.var.x0.quorum_b fol.var.x1.quorum_b fol.var.x0.quorum_c fol.var.x1.quorum_c fol.var.x0.value fol.var.x1.value)
(set-logic ALL)
(declare-sort node 0)
(declare-sort quorum_a 0)
(declare-sort quorum_b 0)
(declare-sort quorum_c 0)
(declare-sort value 0)
(declare-fun dec (node value) Bool)
(declare-fun done (node) Bool)
(declare-fun input (node value) Bool)
(declare-fun member_a (node quorum_a) Bool)
(declare-fun member_b (node quorum_b) Bool)
(declare-fun member_c (node quorum_c) Bool)
(declare-fun member_f (node) Bool)
(declare-fun rcv_msg (node node value) Bool)
(declare-fun rcv_msg_proj (node node) Bool)
(declare-fun sent_msg (node node value) Bool)
(declare-fun sent_msg_proj (node node) Bool)
(declare-fun und_cons (node value) Bool)
(declare-fun und_cons_dec (value) Bool)

(declare-term-types
 ((Formula 0) (Term.node 0) (Term.quorum_a 0) (Term.quorum_b 0) (Term.quorum_c 0) (Term.value 0))
 (((fol.true)
   (fol.false)
   (fol.not Formula)
   (fol.and Formula Formula)
   (fol.or Formula Formula)
   (fol.forall.x0.node Formula)
   (fol.exists.x0.node Formula)
   (fol.forall.x1.node Formula)
   (fol.exists.x1.node Formula)
   (fol.eq.node Term.node Term.node)
   (fol.forall.x0.quorum_a Formula)
   (fol.exists.x0.quorum_a Formula)
   (fol.forall.x1.quorum_a Formula)
   (fol.exists.x1.quorum_a Formula)
   (fol.eq.quorum_a Term.quorum_a Term.quorum_a)
   (fol.forall.x0.quorum_b Formula)
   (fol.exists.x0.quorum_b Formula)
   (fol.forall.x1.quorum_b Formula)
   (fol.exists.x1.quorum_b Formula)
   (fol.eq.quorum_b Term.quorum_b Term.quorum_b)
   (fol.forall.x0.quorum_c Formula)
   (fol.exists.x0.quorum_c Formula)
   (fol.forall.x1.quorum_c Formula)
   (fol.exists.x1.quorum_c Formula)
   (fol.eq.quorum_c Term.quorum_c Term.quorum_c)
   (fol.forall.x0.value Formula)
   (fol.exists.x0.value Formula)
   (fol.forall.x1.value Formula)
   (fol.exists.x1.value Formula)
   (fol.eq.value Term.value Term.value)
   (fol.atom.dec Term.node Term.value)
   (fol.atom.done Term.node)
   (fol.atom.input Term.node Term.value)
   (fol.atom.member_a Term.node Term.quorum_a)
   (fol.atom.member_b Term.node Term.quorum_b)
   (fol.atom.member_c Term.node Term.quorum_c)
   (fol.atom.member_f Term.node)
   (fol.atom.rcv_msg Term.node Term.node Term.value)
   (fol.atom.rcv_msg_proj Term.node Term.node)
   (fol.atom.sent_msg Term.node Term.node Term.value)
   (fol.atom.sent_msg_proj Term.node Term.node)
   (fol.atom.und_cons Term.node Term.value)
   (fol.atom.und_cons_dec Term.value))
  ((fol.var.x0.node)
   (fol.var.x1.node))
  ((fol.var.x0.quorum_a)
   (fol.var.x1.quorum_a))
  ((fol.var.x0.quorum_b)
   (fol.var.x1.quorum_b))
  ((fol.var.x0.quorum_c)
   (fol.var.x1.quorum_c))
  ((fol.var.x0.value)
   (fol.var.x1.value))))

(define-finite FoAsp (record (model Model) (x0 (union fol.bot node quorum_a quorum_b quorum_c value)) (x1 (union fol.bot node quorum_a quorum_b quorum_c value))))

(define-semantics
  ((Term.node.Sem (term Term.node) (asp FoAsp)))
  :returns node
  ((match term
     ((fol.var.x0.node) (x0 asp))
     ((fol.var.x1.node) (x1 asp))
  )))

(define-semantics
  ((Term.quorum_a.Sem (term Term.quorum_a) (asp FoAsp)))
  :returns quorum_a
  ((match term
     ((fol.var.x0.quorum_a) (x0 asp))
     ((fol.var.x1.quorum_a) (x1 asp))
  )))

(define-semantics
  ((Term.quorum_b.Sem (term Term.quorum_b) (asp FoAsp)))
  :returns quorum_b
  ((match term
     ((fol.var.x0.quorum_b) (x0 asp))
     ((fol.var.x1.quorum_b) (x1 asp))
  )))

(define-semantics
  ((Term.quorum_c.Sem (term Term.quorum_c) (asp FoAsp)))
  :returns quorum_c
  ((match term
     ((fol.var.x0.quorum_c) (x0 asp))
     ((fol.var.x1.quorum_c) (x1 asp))
  )))

(define-semantics
  ((Term.value.Sem (term Term.value) (asp FoAsp)))
  :returns value
  ((match term
     ((fol.var.x0.value) (x0 asp))
     ((fol.var.x1.value) (x1 asp))
  )))

(define-semantics
  ((FO.Sem (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) false)
     ((fol.not p) (not (FO.Sem p asp)))
     ((fol.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (= (Term.node.Sem lhs asp) (Term.node.Sem rhs asp)))
     ((fol.forall.x0.quorum_a p)
      (forall ((v (domain (quorum_a (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum_a p)
      (exists ((v (domain (quorum_a (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum_a p)
      (forall ((v (domain (quorum_a (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum_a p)
      (exists ((v (domain (quorum_a (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum_a lhs rhs)
      (= (Term.quorum_a.Sem lhs asp) (Term.quorum_a.Sem rhs asp)))
     ((fol.forall.x0.quorum_b p)
      (forall ((v (domain (quorum_b (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum_b p)
      (exists ((v (domain (quorum_b (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum_b p)
      (forall ((v (domain (quorum_b (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum_b p)
      (exists ((v (domain (quorum_b (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum_b lhs rhs)
      (= (Term.quorum_b.Sem lhs asp) (Term.quorum_b.Sem rhs asp)))
     ((fol.forall.x0.quorum_c p)
      (forall ((v (domain (quorum_c (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum_c p)
      (exists ((v (domain (quorum_c (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum_c p)
      (forall ((v (domain (quorum_c (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum_c p)
      (exists ((v (domain (quorum_c (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum_c lhs rhs)
      (= (Term.quorum_c.Sem lhs asp) (Term.quorum_c.Sem rhs asp)))
     ((fol.forall.x0.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.value p)
      (exists ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.value p)
      (exists ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.value lhs rhs)
      (= (Term.value.Sem lhs asp) (Term.value.Sem rhs asp)))
     ((fol.atom.dec a0 a1) (dec (Term.node.Sem a0 asp) (Term.value.Sem a1 asp)))
     ((fol.atom.done a0) (done (Term.node.Sem a0 asp)))
     ((fol.atom.input a0 a1) (input (Term.node.Sem a0 asp) (Term.value.Sem a1 asp)))
     ((fol.atom.member_a a0 a1) (member_a (Term.node.Sem a0 asp) (Term.quorum_a.Sem a1 asp)))
     ((fol.atom.member_b a0 a1) (member_b (Term.node.Sem a0 asp) (Term.quorum_b.Sem a1 asp)))
     ((fol.atom.member_c a0 a1) (member_c (Term.node.Sem a0 asp) (Term.quorum_c.Sem a1 asp)))
     ((fol.atom.member_f a0) (member_f (Term.node.Sem a0 asp)))
     ((fol.atom.rcv_msg a0 a1 a2) (rcv_msg (Term.node.Sem a0 asp) (Term.node.Sem a1 asp) (Term.value.Sem a2 asp)))
     ((fol.atom.rcv_msg_proj a0 a1) (rcv_msg_proj (Term.node.Sem a0 asp) (Term.node.Sem a1 asp)))
     ((fol.atom.sent_msg a0 a1 a2) (sent_msg (Term.node.Sem a0 asp) (Term.node.Sem a1 asp) (Term.value.Sem a2 asp)))
     ((fol.atom.sent_msg_proj a0 a1) (sent_msg_proj (Term.node.Sem a0 asp) (Term.node.Sem a1 asp)))
     ((fol.atom.und_cons a0 a1) (und_cons (Term.node.Sem a0 asp) (Term.value.Sem a1 asp)))
     ((fol.atom.und_cons_dec a0) (und_cons_dec (Term.value.Sem a0 asp)))
  )))

(define-semantics
  ((FO.Valid (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) true)
     ((fol.not p) (FO.Valid p asp))
     ((fol.and p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.or p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem lhs asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem rhs asp) v))))
     ((fol.forall.x0.quorum_a p)
      (forall ((v (domain (quorum_a (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum_a p)
      (forall ((v (domain (quorum_a (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum_a p)
      (forall ((v (domain (quorum_a (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum_a p)
      (forall ((v (domain (quorum_a (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum_a lhs rhs)
      (and (exists ((v (domain (quorum_a (model asp))))) (= (Term.quorum_a.Sem lhs asp) v)) (exists ((v (domain (quorum_a (model asp))))) (= (Term.quorum_a.Sem rhs asp) v))))
     ((fol.forall.x0.quorum_b p)
      (forall ((v (domain (quorum_b (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum_b p)
      (forall ((v (domain (quorum_b (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum_b p)
      (forall ((v (domain (quorum_b (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum_b p)
      (forall ((v (domain (quorum_b (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum_b lhs rhs)
      (and (exists ((v (domain (quorum_b (model asp))))) (= (Term.quorum_b.Sem lhs asp) v)) (exists ((v (domain (quorum_b (model asp))))) (= (Term.quorum_b.Sem rhs asp) v))))
     ((fol.forall.x0.quorum_c p)
      (forall ((v (domain (quorum_c (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum_c p)
      (forall ((v (domain (quorum_c (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum_c p)
      (forall ((v (domain (quorum_c (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum_c p)
      (forall ((v (domain (quorum_c (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum_c lhs rhs)
      (and (exists ((v (domain (quorum_c (model asp))))) (= (Term.quorum_c.Sem lhs asp) v)) (exists ((v (domain (quorum_c (model asp))))) (= (Term.quorum_c.Sem rhs asp) v))))
     ((fol.forall.x0.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.value lhs rhs)
      (and (exists ((v (domain (value (model asp))))) (= (Term.value.Sem lhs asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem rhs asp) v))))
     ((fol.atom.dec a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem a1 asp) v))))
     ((fol.atom.done a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.input a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem a1 asp) v))))
     ((fol.atom.member_a a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (quorum_a (model asp))))) (= (Term.quorum_a.Sem a1 asp) v))))
     ((fol.atom.member_b a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (quorum_b (model asp))))) (= (Term.quorum_b.Sem a1 asp) v))))
     ((fol.atom.member_c a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (quorum_c (model asp))))) (= (Term.quorum_c.Sem a1 asp) v))))
     ((fol.atom.member_f a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.rcv_msg a0 a1 a2) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a1 asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem a2 asp) v))))
     ((fol.atom.rcv_msg_proj a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a1 asp) v))))
     ((fol.atom.sent_msg a0 a1 a2) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a1 asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem a2 asp) v))))
     ((fol.atom.sent_msg_proj a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a1 asp) v))))
     ((fol.atom.und_cons a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem a1 asp) v))))
     ((fol.atom.und_cons_dec a0) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem a0 asp) v)))
  )))
