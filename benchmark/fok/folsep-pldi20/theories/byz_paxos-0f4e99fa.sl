(provide node quorum_c quorum_w round value none decision le left_rnd member_b member_c member_w one_a one_b prepare proposal rcved_one_b vote Formula FoAsp Term.node Term.node.Sem Term.quorum_c Term.quorum_c.Sem Term.quorum_w Term.quorum_w.Sem Term.round Term.round.Sem Term.value Term.value.Sem FO.Sem FO.Valid fol.true fol.false fol.not fol.and fol.or fol.forall.x0.node fol.exists.x0.node fol.forall.x1.node fol.exists.x1.node fol.eq.node fol.forall.x0.quorum_c fol.exists.x0.quorum_c fol.forall.x1.quorum_c fol.exists.x1.quorum_c fol.eq.quorum_c fol.forall.x0.quorum_w fol.exists.x0.quorum_w fol.forall.x1.quorum_w fol.exists.x1.quorum_w fol.eq.quorum_w fol.forall.x0.round fol.exists.x0.round fol.forall.x1.round fol.exists.x1.round fol.eq.round fol.forall.x0.value fol.exists.x0.value fol.forall.x1.value fol.exists.x1.value fol.eq.value fol.atom.decision fol.atom.le fol.atom.left_rnd fol.atom.member_b fol.atom.member_c fol.atom.member_w fol.atom.one_a fol.atom.one_b fol.atom.prepare fol.atom.proposal fol.atom.rcved_one_b fol.atom.vote fol.var.x0.node fol.var.x1.node fol.var.x0.quorum_c fol.var.x1.quorum_c fol.var.x0.quorum_w fol.var.x1.quorum_w fol.var.x0.round fol.var.x1.round fol.term.none fol.var.x0.value fol.var.x1.value)
(set-logic ALL)
(declare-sort node 0)
(declare-sort quorum_c 0)
(declare-sort quorum_w 0)
(declare-sort round 0)
(declare-sort value 0)
(declare-fun none () round)
(declare-fun decision (node round value) Bool)
(declare-fun le (round round) Bool)
(declare-fun left_rnd (node round) Bool)
(declare-fun member_b (node) Bool)
(declare-fun member_c (node quorum_c) Bool)
(declare-fun member_w (node quorum_w) Bool)
(declare-fun one_a (round) Bool)
(declare-fun one_b (node round) Bool)
(declare-fun prepare (node round value) Bool)
(declare-fun proposal (round value) Bool)
(declare-fun rcved_one_b (node round node) Bool)
(declare-fun vote (node round value) Bool)

(declare-term-types
 ((Formula 0) (Term.node 0) (Term.quorum_c 0) (Term.quorum_w 0) (Term.round 0) (Term.value 0))
 (((fol.true)
   (fol.false)
   (fol.not Formula)
   (fol.and Formula Formula)
   (fol.or Formula Formula)
   (fol.forall.x0.node Formula)
   (fol.exists.x0.node Formula)
   (fol.forall.x1.node Formula)
   (fol.exists.x1.node Formula)
   (fol.eq.node Term.node Term.node)
   (fol.forall.x0.quorum_c Formula)
   (fol.exists.x0.quorum_c Formula)
   (fol.forall.x1.quorum_c Formula)
   (fol.exists.x1.quorum_c Formula)
   (fol.eq.quorum_c Term.quorum_c Term.quorum_c)
   (fol.forall.x0.quorum_w Formula)
   (fol.exists.x0.quorum_w Formula)
   (fol.forall.x1.quorum_w Formula)
   (fol.exists.x1.quorum_w Formula)
   (fol.eq.quorum_w Term.quorum_w Term.quorum_w)
   (fol.forall.x0.round Formula)
   (fol.exists.x0.round Formula)
   (fol.forall.x1.round Formula)
   (fol.exists.x1.round Formula)
   (fol.eq.round Term.round Term.round)
   (fol.forall.x0.value Formula)
   (fol.exists.x0.value Formula)
   (fol.forall.x1.value Formula)
   (fol.exists.x1.value Formula)
   (fol.eq.value Term.value Term.value)
   (fol.atom.decision Term.node Term.round Term.value)
   (fol.atom.le Term.round Term.round)
   (fol.atom.left_rnd Term.node Term.round)
   (fol.atom.member_b Term.node)
   (fol.atom.member_c Term.node Term.quorum_c)
   (fol.atom.member_w Term.node Term.quorum_w)
   (fol.atom.one_a Term.round)
   (fol.atom.one_b Term.node Term.round)
   (fol.atom.prepare Term.node Term.round Term.value)
   (fol.atom.proposal Term.round Term.value)
   (fol.atom.rcved_one_b Term.node Term.round Term.node)
   (fol.atom.vote Term.node Term.round Term.value))
  ((fol.var.x0.node)
   (fol.var.x1.node))
  ((fol.var.x0.quorum_c)
   (fol.var.x1.quorum_c))
  ((fol.var.x0.quorum_w)
   (fol.var.x1.quorum_w))
  ((fol.var.x0.round)
   (fol.var.x1.round)
   (fol.term.none))
  ((fol.var.x0.value)
   (fol.var.x1.value))))

(define-finite FoAsp (record (model Model) (x0 (union fol.bot node quorum_c quorum_w round value)) (x1 (union fol.bot node quorum_c quorum_w round value))))

(define-semantics
  ((Term.node.Sem (term Term.node) (asp FoAsp)))
  :returns node
  ((match term
     ((fol.var.x0.node) (x0 asp))
     ((fol.var.x1.node) (x1 asp))
  )))

(define-semantics
  ((Term.quorum_c.Sem (term Term.quorum_c) (asp FoAsp)))
  :returns quorum_c
  ((match term
     ((fol.var.x0.quorum_c) (x0 asp))
     ((fol.var.x1.quorum_c) (x1 asp))
  )))

(define-semantics
  ((Term.quorum_w.Sem (term Term.quorum_w) (asp FoAsp)))
  :returns quorum_w
  ((match term
     ((fol.var.x0.quorum_w) (x0 asp))
     ((fol.var.x1.quorum_w) (x1 asp))
  )))

(define-semantics
  ((Term.round.Sem (term Term.round) (asp FoAsp)))
  :returns round
  ((match term
     ((fol.var.x0.round) (x0 asp))
     ((fol.var.x1.round) (x1 asp))
     ((fol.term.none) none)
  )))

(define-semantics
  ((Term.value.Sem (term Term.value) (asp FoAsp)))
  :returns value
  ((match term
     ((fol.var.x0.value) (x0 asp))
     ((fol.var.x1.value) (x1 asp))
  )))

(define-semantics
  ((FO.Sem (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) false)
     ((fol.not p) (not (FO.Sem p asp)))
     ((fol.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (= (Term.node.Sem lhs asp) (Term.node.Sem rhs asp)))
     ((fol.forall.x0.quorum_c p)
      (forall ((v (domain (quorum_c (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum_c p)
      (exists ((v (domain (quorum_c (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum_c p)
      (forall ((v (domain (quorum_c (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum_c p)
      (exists ((v (domain (quorum_c (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum_c lhs rhs)
      (= (Term.quorum_c.Sem lhs asp) (Term.quorum_c.Sem rhs asp)))
     ((fol.forall.x0.quorum_w p)
      (forall ((v (domain (quorum_w (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum_w p)
      (exists ((v (domain (quorum_w (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum_w p)
      (forall ((v (domain (quorum_w (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum_w p)
      (exists ((v (domain (quorum_w (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum_w lhs rhs)
      (= (Term.quorum_w.Sem lhs asp) (Term.quorum_w.Sem rhs asp)))
     ((fol.forall.x0.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.round p)
      (exists ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.round p)
      (exists ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.round lhs rhs)
      (= (Term.round.Sem lhs asp) (Term.round.Sem rhs asp)))
     ((fol.forall.x0.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.value p)
      (exists ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.value p)
      (exists ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.value lhs rhs)
      (= (Term.value.Sem lhs asp) (Term.value.Sem rhs asp)))
     ((fol.atom.decision a0 a1 a2) (decision (Term.node.Sem a0 asp) (Term.round.Sem a1 asp) (Term.value.Sem a2 asp)))
     ((fol.atom.le a0 a1) (le (Term.round.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.left_rnd a0 a1) (left_rnd (Term.node.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.member_b a0) (member_b (Term.node.Sem a0 asp)))
     ((fol.atom.member_c a0 a1) (member_c (Term.node.Sem a0 asp) (Term.quorum_c.Sem a1 asp)))
     ((fol.atom.member_w a0 a1) (member_w (Term.node.Sem a0 asp) (Term.quorum_w.Sem a1 asp)))
     ((fol.atom.one_a a0) (one_a (Term.round.Sem a0 asp)))
     ((fol.atom.one_b a0 a1) (one_b (Term.node.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.prepare a0 a1 a2) (prepare (Term.node.Sem a0 asp) (Term.round.Sem a1 asp) (Term.value.Sem a2 asp)))
     ((fol.atom.proposal a0 a1) (proposal (Term.round.Sem a0 asp) (Term.value.Sem a1 asp)))
     ((fol.atom.rcved_one_b a0 a1 a2) (rcved_one_b (Term.node.Sem a0 asp) (Term.round.Sem a1 asp) (Term.node.Sem a2 asp)))
     ((fol.atom.vote a0 a1 a2) (vote (Term.node.Sem a0 asp) (Term.round.Sem a1 asp) (Term.value.Sem a2 asp)))
  )))

(define-semantics
  ((FO.Valid (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) true)
     ((fol.not p) (FO.Valid p asp))
     ((fol.and p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.or p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem lhs asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem rhs asp) v))))
     ((fol.forall.x0.quorum_c p)
      (forall ((v (domain (quorum_c (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum_c p)
      (forall ((v (domain (quorum_c (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum_c p)
      (forall ((v (domain (quorum_c (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum_c p)
      (forall ((v (domain (quorum_c (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum_c lhs rhs)
      (and (exists ((v (domain (quorum_c (model asp))))) (= (Term.quorum_c.Sem lhs asp) v)) (exists ((v (domain (quorum_c (model asp))))) (= (Term.quorum_c.Sem rhs asp) v))))
     ((fol.forall.x0.quorum_w p)
      (forall ((v (domain (quorum_w (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum_w p)
      (forall ((v (domain (quorum_w (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum_w p)
      (forall ((v (domain (quorum_w (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum_w p)
      (forall ((v (domain (quorum_w (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum_w lhs rhs)
      (and (exists ((v (domain (quorum_w (model asp))))) (= (Term.quorum_w.Sem lhs asp) v)) (exists ((v (domain (quorum_w (model asp))))) (= (Term.quorum_w.Sem rhs asp) v))))
     ((fol.forall.x0.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.round lhs rhs)
      (and (exists ((v (domain (round (model asp))))) (= (Term.round.Sem lhs asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem rhs asp) v))))
     ((fol.forall.x0.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.value lhs rhs)
      (and (exists ((v (domain (value (model asp))))) (= (Term.value.Sem lhs asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem rhs asp) v))))
     ((fol.atom.decision a0 a1 a2) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a1 asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem a2 asp) v))))
     ((fol.atom.le a0 a1) (and (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a0 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a1 asp) v))))
     ((fol.atom.left_rnd a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a1 asp) v))))
     ((fol.atom.member_b a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.member_c a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (quorum_c (model asp))))) (= (Term.quorum_c.Sem a1 asp) v))))
     ((fol.atom.member_w a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (quorum_w (model asp))))) (= (Term.quorum_w.Sem a1 asp) v))))
     ((fol.atom.one_a a0) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a0 asp) v)))
     ((fol.atom.one_b a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a1 asp) v))))
     ((fol.atom.prepare a0 a1 a2) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a1 asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem a2 asp) v))))
     ((fol.atom.proposal a0 a1) (and (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a0 asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem a1 asp) v))))
     ((fol.atom.rcved_one_b a0 a1 a2) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a1 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a2 asp) v))))
     ((fol.atom.vote a0 a1 a2) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (round (model asp))))) (= (Term.round.Sem a1 asp) v)) (exists ((v (domain (value (model asp))))) (= (Term.value.Sem a2 asp) v))))
  )))
