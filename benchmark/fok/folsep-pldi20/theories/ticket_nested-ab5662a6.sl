(provide ticket_protocol.thread ticket_protocol.ticket ticket_protocol.next_ticket ticket_protocol.service ticket_protocol.tp1.sk0 ticket_protocol.tp1.sk1 ticket_protocol.zero ticket_protocol.c ticket_protocol.le ticket_protocol.m ticket_protocol.pc1 ticket_protocol.pc2 ticket_protocol.pc3 ticket_protocol.scheduled Formula FoAsp Term.ticket_protocol.thread Term.ticket_protocol.thread.Sem Term.ticket_protocol.ticket Term.ticket_protocol.ticket.Sem FO.Sem FO.Valid fol.true fol.false fol.not fol.and fol.or fol.forall.x0.ticket_protocol.thread fol.exists.x0.ticket_protocol.thread fol.forall.x1.ticket_protocol.thread fol.exists.x1.ticket_protocol.thread fol.eq.ticket_protocol.thread fol.forall.x0.ticket_protocol.ticket fol.exists.x0.ticket_protocol.ticket fol.forall.x1.ticket_protocol.ticket fol.exists.x1.ticket_protocol.ticket fol.eq.ticket_protocol.ticket fol.atom.ticket_protocol.c fol.atom.ticket_protocol.le fol.atom.ticket_protocol.m fol.atom.ticket_protocol.pc1 fol.atom.ticket_protocol.pc2 fol.atom.ticket_protocol.pc3 fol.atom.ticket_protocol.scheduled fol.var.x0.ticket_protocol.thread fol.var.x1.ticket_protocol.thread fol.term.ticket_protocol.tp1.sk0 fol.term.ticket_protocol.tp1.sk1 fol.var.x0.ticket_protocol.ticket fol.var.x1.ticket_protocol.ticket fol.term.ticket_protocol.next_ticket fol.term.ticket_protocol.service fol.term.ticket_protocol.zero)
(set-logic ALL)
(declare-sort ticket_protocol.thread 0)
(declare-sort ticket_protocol.ticket 0)
(declare-fun ticket_protocol.next_ticket () ticket_protocol.ticket)
(declare-fun ticket_protocol.service () ticket_protocol.ticket)
(declare-fun ticket_protocol.tp1.sk0 () ticket_protocol.thread)
(declare-fun ticket_protocol.tp1.sk1 () ticket_protocol.thread)
(declare-fun ticket_protocol.zero () ticket_protocol.ticket)
(declare-fun ticket_protocol.c (ticket_protocol.thread ticket_protocol.ticket) Bool)
(declare-fun ticket_protocol.le (ticket_protocol.ticket ticket_protocol.ticket) Bool)
(declare-fun ticket_protocol.m (ticket_protocol.thread ticket_protocol.ticket) Bool)
(declare-fun ticket_protocol.pc1 (ticket_protocol.thread) Bool)
(declare-fun ticket_protocol.pc2 (ticket_protocol.thread) Bool)
(declare-fun ticket_protocol.pc3 (ticket_protocol.thread) Bool)
(declare-fun ticket_protocol.scheduled (ticket_protocol.thread) Bool)

(declare-term-types
 ((Formula 0) (Term.ticket_protocol.thread 0) (Term.ticket_protocol.ticket 0))
 (((fol.true)
   (fol.false)
   (fol.not Formula)
   (fol.and Formula Formula)
   (fol.or Formula Formula)
   (fol.forall.x0.ticket_protocol.thread Formula)
   (fol.exists.x0.ticket_protocol.thread Formula)
   (fol.forall.x1.ticket_protocol.thread Formula)
   (fol.exists.x1.ticket_protocol.thread Formula)
   (fol.eq.ticket_protocol.thread Term.ticket_protocol.thread Term.ticket_protocol.thread)
   (fol.forall.x0.ticket_protocol.ticket Formula)
   (fol.exists.x0.ticket_protocol.ticket Formula)
   (fol.forall.x1.ticket_protocol.ticket Formula)
   (fol.exists.x1.ticket_protocol.ticket Formula)
   (fol.eq.ticket_protocol.ticket Term.ticket_protocol.ticket Term.ticket_protocol.ticket)
   (fol.atom.ticket_protocol.c Term.ticket_protocol.thread Term.ticket_protocol.ticket)
   (fol.atom.ticket_protocol.le Term.ticket_protocol.ticket Term.ticket_protocol.ticket)
   (fol.atom.ticket_protocol.m Term.ticket_protocol.thread Term.ticket_protocol.ticket)
   (fol.atom.ticket_protocol.pc1 Term.ticket_protocol.thread)
   (fol.atom.ticket_protocol.pc2 Term.ticket_protocol.thread)
   (fol.atom.ticket_protocol.pc3 Term.ticket_protocol.thread)
   (fol.atom.ticket_protocol.scheduled Term.ticket_protocol.thread))
  ((fol.var.x0.ticket_protocol.thread)
   (fol.var.x1.ticket_protocol.thread)
   (fol.term.ticket_protocol.tp1.sk0)
   (fol.term.ticket_protocol.tp1.sk1))
  ((fol.var.x0.ticket_protocol.ticket)
   (fol.var.x1.ticket_protocol.ticket)
   (fol.term.ticket_protocol.next_ticket)
   (fol.term.ticket_protocol.service)
   (fol.term.ticket_protocol.zero))))

(define-finite FoAsp (record (model Model) (x0 (union fol.bot ticket_protocol.thread ticket_protocol.ticket)) (x1 (union fol.bot ticket_protocol.thread ticket_protocol.ticket))))

(define-semantics
  ((Term.ticket_protocol.thread.Sem (term Term.ticket_protocol.thread) (asp FoAsp)))
  :returns ticket_protocol.thread
  ((match term
     ((fol.var.x0.ticket_protocol.thread) (x0 asp))
     ((fol.var.x1.ticket_protocol.thread) (x1 asp))
     ((fol.term.ticket_protocol.tp1.sk0) ticket_protocol.tp1.sk0)
     ((fol.term.ticket_protocol.tp1.sk1) ticket_protocol.tp1.sk1)
  )))

(define-semantics
  ((Term.ticket_protocol.ticket.Sem (term Term.ticket_protocol.ticket) (asp FoAsp)))
  :returns ticket_protocol.ticket
  ((match term
     ((fol.var.x0.ticket_protocol.ticket) (x0 asp))
     ((fol.var.x1.ticket_protocol.ticket) (x1 asp))
     ((fol.term.ticket_protocol.next_ticket) ticket_protocol.next_ticket)
     ((fol.term.ticket_protocol.service) ticket_protocol.service)
     ((fol.term.ticket_protocol.zero) ticket_protocol.zero)
  )))

(define-semantics
  ((FO.Sem (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) false)
     ((fol.not p) (not (FO.Sem p asp)))
     ((fol.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.forall.x0.ticket_protocol.thread p)
      (forall ((v (domain (ticket_protocol.thread (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.ticket_protocol.thread p)
      (exists ((v (domain (ticket_protocol.thread (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.ticket_protocol.thread p)
      (forall ((v (domain (ticket_protocol.thread (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.ticket_protocol.thread p)
      (exists ((v (domain (ticket_protocol.thread (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.ticket_protocol.thread lhs rhs)
      (= (Term.ticket_protocol.thread.Sem lhs asp) (Term.ticket_protocol.thread.Sem rhs asp)))
     ((fol.forall.x0.ticket_protocol.ticket p)
      (forall ((v (domain (ticket_protocol.ticket (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.ticket_protocol.ticket p)
      (exists ((v (domain (ticket_protocol.ticket (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.ticket_protocol.ticket p)
      (forall ((v (domain (ticket_protocol.ticket (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.ticket_protocol.ticket p)
      (exists ((v (domain (ticket_protocol.ticket (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.ticket_protocol.ticket lhs rhs)
      (= (Term.ticket_protocol.ticket.Sem lhs asp) (Term.ticket_protocol.ticket.Sem rhs asp)))
     ((fol.atom.ticket_protocol.c a0 a1) (ticket_protocol.c (Term.ticket_protocol.thread.Sem a0 asp) (Term.ticket_protocol.ticket.Sem a1 asp)))
     ((fol.atom.ticket_protocol.le a0 a1) (ticket_protocol.le (Term.ticket_protocol.ticket.Sem a0 asp) (Term.ticket_protocol.ticket.Sem a1 asp)))
     ((fol.atom.ticket_protocol.m a0 a1) (ticket_protocol.m (Term.ticket_protocol.thread.Sem a0 asp) (Term.ticket_protocol.ticket.Sem a1 asp)))
     ((fol.atom.ticket_protocol.pc1 a0) (ticket_protocol.pc1 (Term.ticket_protocol.thread.Sem a0 asp)))
     ((fol.atom.ticket_protocol.pc2 a0) (ticket_protocol.pc2 (Term.ticket_protocol.thread.Sem a0 asp)))
     ((fol.atom.ticket_protocol.pc3 a0) (ticket_protocol.pc3 (Term.ticket_protocol.thread.Sem a0 asp)))
     ((fol.atom.ticket_protocol.scheduled a0) (ticket_protocol.scheduled (Term.ticket_protocol.thread.Sem a0 asp)))
  )))

(define-semantics
  ((FO.Valid (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) true)
     ((fol.not p) (FO.Valid p asp))
     ((fol.and p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.or p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.forall.x0.ticket_protocol.thread p)
      (forall ((v (domain (ticket_protocol.thread (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.ticket_protocol.thread p)
      (forall ((v (domain (ticket_protocol.thread (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.ticket_protocol.thread p)
      (forall ((v (domain (ticket_protocol.thread (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.ticket_protocol.thread p)
      (forall ((v (domain (ticket_protocol.thread (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.ticket_protocol.thread lhs rhs)
      (and (exists ((v (domain (ticket_protocol.thread (model asp))))) (= (Term.ticket_protocol.thread.Sem lhs asp) v)) (exists ((v (domain (ticket_protocol.thread (model asp))))) (= (Term.ticket_protocol.thread.Sem rhs asp) v))))
     ((fol.forall.x0.ticket_protocol.ticket p)
      (forall ((v (domain (ticket_protocol.ticket (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.ticket_protocol.ticket p)
      (forall ((v (domain (ticket_protocol.ticket (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.ticket_protocol.ticket p)
      (forall ((v (domain (ticket_protocol.ticket (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.ticket_protocol.ticket p)
      (forall ((v (domain (ticket_protocol.ticket (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.ticket_protocol.ticket lhs rhs)
      (and (exists ((v (domain (ticket_protocol.ticket (model asp))))) (= (Term.ticket_protocol.ticket.Sem lhs asp) v)) (exists ((v (domain (ticket_protocol.ticket (model asp))))) (= (Term.ticket_protocol.ticket.Sem rhs asp) v))))
     ((fol.atom.ticket_protocol.c a0 a1) (and (exists ((v (domain (ticket_protocol.thread (model asp))))) (= (Term.ticket_protocol.thread.Sem a0 asp) v)) (exists ((v (domain (ticket_protocol.ticket (model asp))))) (= (Term.ticket_protocol.ticket.Sem a1 asp) v))))
     ((fol.atom.ticket_protocol.le a0 a1) (and (exists ((v (domain (ticket_protocol.ticket (model asp))))) (= (Term.ticket_protocol.ticket.Sem a0 asp) v)) (exists ((v (domain (ticket_protocol.ticket (model asp))))) (= (Term.ticket_protocol.ticket.Sem a1 asp) v))))
     ((fol.atom.ticket_protocol.m a0 a1) (and (exists ((v (domain (ticket_protocol.thread (model asp))))) (= (Term.ticket_protocol.thread.Sem a0 asp) v)) (exists ((v (domain (ticket_protocol.ticket (model asp))))) (= (Term.ticket_protocol.ticket.Sem a1 asp) v))))
     ((fol.atom.ticket_protocol.pc1 a0) (exists ((v (domain (ticket_protocol.thread (model asp))))) (= (Term.ticket_protocol.thread.Sem a0 asp) v)))
     ((fol.atom.ticket_protocol.pc2 a0) (exists ((v (domain (ticket_protocol.thread (model asp))))) (= (Term.ticket_protocol.thread.Sem a0 asp) v)))
     ((fol.atom.ticket_protocol.pc3 a0) (exists ((v (domain (ticket_protocol.thread (model asp))))) (= (Term.ticket_protocol.thread.Sem a0 asp) v)))
     ((fol.atom.ticket_protocol.scheduled a0) (exists ((v (domain (ticket_protocol.thread (model asp))))) (= (Term.ticket_protocol.thread.Sem a0 asp) v)))
  )))
