(provide node quorum_a quorum_b rb.tp_correctness.n0 rb.tp_relay.n1 rb.tp_relay.n2 member_a member_b member_fa member_fc member_fi member_fs rb.accept rb.correct rb.d rb.obedient rb.rcv_init rb.rcv_msg rb.sent_msg rb.sent_msg_proj rb.symmetric Formula FoAsp Term.node Term.node.Sem Term.quorum_a Term.quorum_a.Sem Term.quorum_b Term.quorum_b.Sem FO.Sem FO.Valid fol.true fol.false fol.not fol.and fol.or fol.forall.x0.node fol.exists.x0.node fol.forall.x1.node fol.exists.x1.node fol.eq.node fol.forall.x0.quorum_a fol.exists.x0.quorum_a fol.forall.x1.quorum_a fol.exists.x1.quorum_a fol.eq.quorum_a fol.forall.x0.quorum_b fol.exists.x0.quorum_b fol.forall.x1.quorum_b fol.exists.x1.quorum_b fol.eq.quorum_b fol.atom.member_a fol.atom.member_b fol.atom.member_fa fol.atom.member_fc fol.atom.member_fi fol.atom.member_fs fol.atom.rb.accept fol.atom.rb.correct fol.atom.rb.d fol.atom.rb.obedient fol.atom.rb.rcv_init fol.atom.rb.rcv_msg fol.atom.rb.sent_msg fol.atom.rb.sent_msg_proj fol.atom.rb.symmetric fol.var.x0.node fol.var.x1.node fol.term.rb.tp_correctness.n0 fol.term.rb.tp_relay.n1 fol.term.rb.tp_relay.n2 fol.var.x0.quorum_a fol.var.x1.quorum_a fol.var.x0.quorum_b fol.var.x1.quorum_b)
(set-logic ALL)
(declare-sort node 0)
(declare-sort quorum_a 0)
(declare-sort quorum_b 0)
(declare-fun rb.tp_correctness.n0 () node)
(declare-fun rb.tp_relay.n1 () node)
(declare-fun rb.tp_relay.n2 () node)
(declare-fun member_a (node quorum_a) Bool)
(declare-fun member_b (node quorum_b) Bool)
(declare-fun member_fa (node) Bool)
(declare-fun member_fc (node) Bool)
(declare-fun member_fi (node) Bool)
(declare-fun member_fs (node) Bool)
(declare-fun rb.accept (node) Bool)
(declare-fun rb.correct (node) Bool)
(declare-fun rb.d (node) Bool)
(declare-fun rb.obedient (node) Bool)
(declare-fun rb.rcv_init (node) Bool)
(declare-fun rb.rcv_msg (node node) Bool)
(declare-fun rb.sent_msg (node node) Bool)
(declare-fun rb.sent_msg_proj (node) Bool)
(declare-fun rb.symmetric (node) Bool)

(declare-term-types
 ((Formula 0) (Term.node 0) (Term.quorum_a 0) (Term.quorum_b 0))
 (((fol.true)
   (fol.false)
   (fol.not Formula)
   (fol.and Formula Formula)
   (fol.or Formula Formula)
   (fol.forall.x0.node Formula)
   (fol.exists.x0.node Formula)
   (fol.forall.x1.node Formula)
   (fol.exists.x1.node Formula)
   (fol.eq.node Term.node Term.node)
   (fol.forall.x0.quorum_a Formula)
   (fol.exists.x0.quorum_a Formula)
   (fol.forall.x1.quorum_a Formula)
   (fol.exists.x1.quorum_a Formula)
   (fol.eq.quorum_a Term.quorum_a Term.quorum_a)
   (fol.forall.x0.quorum_b Formula)
   (fol.exists.x0.quorum_b Formula)
   (fol.forall.x1.quorum_b Formula)
   (fol.exists.x1.quorum_b Formula)
   (fol.eq.quorum_b Term.quorum_b Term.quorum_b)
   (fol.atom.member_a Term.node Term.quorum_a)
   (fol.atom.member_b Term.node Term.quorum_b)
   (fol.atom.member_fa Term.node)
   (fol.atom.member_fc Term.node)
   (fol.atom.member_fi Term.node)
   (fol.atom.member_fs Term.node)
   (fol.atom.rb.accept Term.node)
   (fol.atom.rb.correct Term.node)
   (fol.atom.rb.d Term.node)
   (fol.atom.rb.obedient Term.node)
   (fol.atom.rb.rcv_init Term.node)
   (fol.atom.rb.rcv_msg Term.node Term.node)
   (fol.atom.rb.sent_msg Term.node Term.node)
   (fol.atom.rb.sent_msg_proj Term.node)
   (fol.atom.rb.symmetric Term.node))
  ((fol.var.x0.node)
   (fol.var.x1.node)
   (fol.term.rb.tp_correctness.n0)
   (fol.term.rb.tp_relay.n1)
   (fol.term.rb.tp_relay.n2))
  ((fol.var.x0.quorum_a)
   (fol.var.x1.quorum_a))
  ((fol.var.x0.quorum_b)
   (fol.var.x1.quorum_b))))

(define-finite FoAsp (record (model Model) (x0 (union fol.bot node quorum_a quorum_b)) (x1 (union fol.bot node quorum_a quorum_b))))

(define-semantics
  ((Term.node.Sem (term Term.node) (asp FoAsp)))
  :returns node
  ((match term
     ((fol.var.x0.node) (x0 asp))
     ((fol.var.x1.node) (x1 asp))
     ((fol.term.rb.tp_correctness.n0) rb.tp_correctness.n0)
     ((fol.term.rb.tp_relay.n1) rb.tp_relay.n1)
     ((fol.term.rb.tp_relay.n2) rb.tp_relay.n2)
  )))

(define-semantics
  ((Term.quorum_a.Sem (term Term.quorum_a) (asp FoAsp)))
  :returns quorum_a
  ((match term
     ((fol.var.x0.quorum_a) (x0 asp))
     ((fol.var.x1.quorum_a) (x1 asp))
  )))

(define-semantics
  ((Term.quorum_b.Sem (term Term.quorum_b) (asp FoAsp)))
  :returns quorum_b
  ((match term
     ((fol.var.x0.quorum_b) (x0 asp))
     ((fol.var.x1.quorum_b) (x1 asp))
  )))

(define-semantics
  ((FO.Sem (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) false)
     ((fol.not p) (not (FO.Sem p asp)))
     ((fol.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (= (Term.node.Sem lhs asp) (Term.node.Sem rhs asp)))
     ((fol.forall.x0.quorum_a p)
      (forall ((v (domain (quorum_a (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum_a p)
      (exists ((v (domain (quorum_a (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum_a p)
      (forall ((v (domain (quorum_a (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum_a p)
      (exists ((v (domain (quorum_a (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum_a lhs rhs)
      (= (Term.quorum_a.Sem lhs asp) (Term.quorum_a.Sem rhs asp)))
     ((fol.forall.x0.quorum_b p)
      (forall ((v (domain (quorum_b (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum_b p)
      (exists ((v (domain (quorum_b (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum_b p)
      (forall ((v (domain (quorum_b (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum_b p)
      (exists ((v (domain (quorum_b (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum_b lhs rhs)
      (= (Term.quorum_b.Sem lhs asp) (Term.quorum_b.Sem rhs asp)))
     ((fol.atom.member_a a0 a1) (member_a (Term.node.Sem a0 asp) (Term.quorum_a.Sem a1 asp)))
     ((fol.atom.member_b a0 a1) (member_b (Term.node.Sem a0 asp) (Term.quorum_b.Sem a1 asp)))
     ((fol.atom.member_fa a0) (member_fa (Term.node.Sem a0 asp)))
     ((fol.atom.member_fc a0) (member_fc (Term.node.Sem a0 asp)))
     ((fol.atom.member_fi a0) (member_fi (Term.node.Sem a0 asp)))
     ((fol.atom.member_fs a0) (member_fs (Term.node.Sem a0 asp)))
     ((fol.atom.rb.accept a0) (rb.accept (Term.node.Sem a0 asp)))
     ((fol.atom.rb.correct a0) (rb.correct (Term.node.Sem a0 asp)))
     ((fol.atom.rb.d a0) (rb.d (Term.node.Sem a0 asp)))
     ((fol.atom.rb.obedient a0) (rb.obedient (Term.node.Sem a0 asp)))
     ((fol.atom.rb.rcv_init a0) (rb.rcv_init (Term.node.Sem a0 asp)))
     ((fol.atom.rb.rcv_msg a0 a1) (rb.rcv_msg (Term.node.Sem a0 asp) (Term.node.Sem a1 asp)))
     ((fol.atom.rb.sent_msg a0 a1) (rb.sent_msg (Term.node.Sem a0 asp) (Term.node.Sem a1 asp)))
     ((fol.atom.rb.sent_msg_proj a0) (rb.sent_msg_proj (Term.node.Sem a0 asp)))
     ((fol.atom.rb.symmetric a0) (rb.symmetric (Term.node.Sem a0 asp)))
  )))

(define-semantics
  ((FO.Valid (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) true)
     ((fol.not p) (FO.Valid p asp))
     ((fol.and p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.or p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem lhs asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem rhs asp) v))))
     ((fol.forall.x0.quorum_a p)
      (forall ((v (domain (quorum_a (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum_a p)
      (forall ((v (domain (quorum_a (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum_a p)
      (forall ((v (domain (quorum_a (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum_a p)
      (forall ((v (domain (quorum_a (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum_a lhs rhs)
      (and (exists ((v (domain (quorum_a (model asp))))) (= (Term.quorum_a.Sem lhs asp) v)) (exists ((v (domain (quorum_a (model asp))))) (= (Term.quorum_a.Sem rhs asp) v))))
     ((fol.forall.x0.quorum_b p)
      (forall ((v (domain (quorum_b (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.quorum_b p)
      (forall ((v (domain (quorum_b (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.quorum_b p)
      (forall ((v (domain (quorum_b (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.quorum_b p)
      (forall ((v (domain (quorum_b (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.quorum_b lhs rhs)
      (and (exists ((v (domain (quorum_b (model asp))))) (= (Term.quorum_b.Sem lhs asp) v)) (exists ((v (domain (quorum_b (model asp))))) (= (Term.quorum_b.Sem rhs asp) v))))
     ((fol.atom.member_a a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (quorum_a (model asp))))) (= (Term.quorum_a.Sem a1 asp) v))))
     ((fol.atom.member_b a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (quorum_b (model asp))))) (= (Term.quorum_b.Sem a1 asp) v))))
     ((fol.atom.member_fa a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.member_fc a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.member_fi a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.member_fs a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.rb.accept a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.rb.correct a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.rb.d a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.rb.obedient a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.rb.rcv_init a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.rb.rcv_msg a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a1 asp) v))))
     ((fol.atom.rb.sent_msg a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a1 asp) v))))
     ((fol.atom.rb.sent_msg_proj a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.rb.symmetric a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
  )))
