(provide id node idn le leader pending ring.btw Formula FoAsp Term.id Term.id.Sem Term.node Term.node.Sem FO.Sem FO.Valid fol.true fol.false fol.not fol.and fol.or fol.forall.x0.id fol.exists.x0.id fol.forall.x1.id fol.exists.x1.id fol.eq.id fol.forall.x0.node fol.exists.x0.node fol.forall.x1.node fol.exists.x1.node fol.eq.node fol.atom.le fol.atom.leader fol.atom.pending fol.atom.ring.btw fol.var.x0.id fol.var.x1.id fol.term.idn fol.var.x0.node fol.var.x1.node)
(set-logic ALL)
(declare-sort id 0)
(declare-sort node 0)
(declare-fun idn (node) id)
(declare-fun le (id id) Bool)
(declare-fun leader (node) Bool)
(declare-fun pending (id node) Bool)
(declare-fun ring.btw (node node node) Bool)

(declare-term-types
 ((Formula 0) (Term.id 0) (Term.node 0))
 (((fol.true)
   (fol.false)
   (fol.not Formula)
   (fol.and Formula Formula)
   (fol.or Formula Formula)
   (fol.forall.x0.id Formula)
   (fol.exists.x0.id Formula)
   (fol.forall.x1.id Formula)
   (fol.exists.x1.id Formula)
   (fol.eq.id Term.id Term.id)
   (fol.forall.x0.node Formula)
   (fol.exists.x0.node Formula)
   (fol.forall.x1.node Formula)
   (fol.exists.x1.node Formula)
   (fol.eq.node Term.node Term.node)
   (fol.atom.le Term.id Term.id)
   (fol.atom.leader Term.node)
   (fol.atom.pending Term.id Term.node)
   (fol.atom.ring.btw Term.node Term.node Term.node))
  ((fol.var.x0.id)
   (fol.var.x1.id)
   (fol.term.idn Term.node))
  ((fol.var.x0.node)
   (fol.var.x1.node))))

(define-finite FoAsp (record (model Model) (x0 (union fol.bot id node)) (x1 (union fol.bot id node))))

(define-semantics
  ((Term.id.Sem (term Term.id) (asp FoAsp)))
  :returns id
  ((match term
     ((fol.var.x0.id) (x0 asp))
     ((fol.var.x1.id) (x1 asp))
     ((fol.term.idn a0) (idn (Term.node.Sem a0 asp)))
  )))

(define-semantics
  ((Term.node.Sem (term Term.node) (asp FoAsp)))
  :returns node
  ((match term
     ((fol.var.x0.node) (x0 asp))
     ((fol.var.x1.node) (x1 asp))
  )))

(define-semantics
  ((FO.Sem (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) false)
     ((fol.not p) (not (FO.Sem p asp)))
     ((fol.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.forall.x0.id p)
      (forall ((v (domain (id (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.id p)
      (exists ((v (domain (id (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.id p)
      (forall ((v (domain (id (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.id p)
      (exists ((v (domain (id (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.id lhs rhs)
      (= (Term.id.Sem lhs asp) (Term.id.Sem rhs asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (= (Term.node.Sem lhs asp) (Term.node.Sem rhs asp)))
     ((fol.atom.le a0 a1) (le (Term.id.Sem a0 asp) (Term.id.Sem a1 asp)))
     ((fol.atom.leader a0) (leader (Term.node.Sem a0 asp)))
     ((fol.atom.pending a0 a1) (pending (Term.id.Sem a0 asp) (Term.node.Sem a1 asp)))
     ((fol.atom.ring.btw a0 a1 a2) (ring.btw (Term.node.Sem a0 asp) (Term.node.Sem a1 asp) (Term.node.Sem a2 asp)))
  )))

(define-semantics
  ((FO.Valid (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) true)
     ((fol.not p) (FO.Valid p asp))
     ((fol.and p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.or p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.forall.x0.id p)
      (forall ((v (domain (id (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.id p)
      (forall ((v (domain (id (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.id p)
      (forall ((v (domain (id (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.id p)
      (forall ((v (domain (id (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.id lhs rhs)
      (and (exists ((v (domain (id (model asp))))) (= (Term.id.Sem lhs asp) v)) (exists ((v (domain (id (model asp))))) (= (Term.id.Sem rhs asp) v))))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem lhs asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem rhs asp) v))))
     ((fol.atom.le a0 a1) (and (exists ((v (domain (id (model asp))))) (= (Term.id.Sem a0 asp) v)) (exists ((v (domain (id (model asp))))) (= (Term.id.Sem a1 asp) v))))
     ((fol.atom.leader a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.pending a0 a1) (and (exists ((v (domain (id (model asp))))) (= (Term.id.Sem a0 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a1 asp) v))))
     ((fol.atom.ring.btw a0 a1 a2) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a1 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a2 asp) v))))
  )))
