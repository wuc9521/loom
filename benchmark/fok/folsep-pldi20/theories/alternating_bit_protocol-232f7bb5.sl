     ((fol.exists.x0.abp.index_t p)
      (forall ((v (domain (abp.index_t (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.abp.index_t p)
      (forall ((v (domain (abp.index_t (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.abp.index_t p)
      (forall ((v (domain (abp.index_t (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.abp.index_t lhs rhs)
      (and (exists ((v (domain (abp.index_t (model asp))))) (= (Term.abp.index_t.Sem lhs asp) v)) (exists ((v (domain (abp.index_t (model asp))))) (= (Term.abp.index_t.Sem rhs asp) v))))
     ((fol.forall.x0.abp.value p)
      (forall ((v (domain (abp.value (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.abp.value p)
      (forall ((v (domain (abp.value (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.abp.value p)
      (forall ((v (domain (abp.value (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.abp.value p)
      (forall ((v (domain (abp.value (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.abp.value lhs rhs)
      (and (exists ((v (domain (abp.value (model asp))))) (= (Term.abp.value.Sem lhs asp) v)) (exists ((v (domain (abp.value (model asp))))) (= (Term.abp.value.Sem rhs asp) v))))
     ((fol.atom.abp.abit a0) (exists ((v (domain (abp.ack_msg_t (model asp))))) (= (Term.abp.ack_msg_t.Sem a0 asp) v)))
     ((fol.atom.abp.ack_msg.le a0 a1) (and (exists ((v (domain (abp.ack_msg_t (model asp))))) (= (Term.abp.ack_msg_t.Sem a0 asp) v)) (exists ((v (domain (abp.ack_msg_t (model asp))))) (= (Term.abp.ack_msg_t.Sem a1 asp) v))))
     ((fol.atom.abp.ack_received ) true)
     ((fol.atom.abp.ack_sent ) true)
     ((fol.atom.abp.data_msg.le a0 a1) (and (exists ((v (domain (abp.data_msg_t (model asp))))) (= (Term.abp.data_msg_t.Sem a0 asp) v)) (exists ((v (domain (abp.data_msg_t (model asp))))) (= (Term.abp.data_msg_t.Sem a1 asp) v))))
