(define-semantics
  ((FO.Sem (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) false)
     ((fol.not p) (not (FO.Sem p asp)))
     ((fol.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.forall.x0.abp.ack_msg_t p)
      (forall ((v (domain (abp.ack_msg_t (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.abp.ack_msg_t p)
      (exists ((v (domain (abp.ack_msg_t (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.abp.ack_msg_t p)
      (forall ((v (domain (abp.ack_msg_t (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.abp.ack_msg_t p)
      (exists ((v (domain (abp.ack_msg_t (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.abp.ack_msg_t lhs rhs)
      (= (Term.abp.ack_msg_t.Sem lhs asp) (Term.abp.ack_msg_t.Sem rhs asp)))
     ((fol.forall.x0.abp.data_msg_t p)
      (forall ((v (domain (abp.data_msg_t (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.abp.data_msg_t p)
