        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.abp.index_t p)
      (forall ((v (domain (abp.index_t (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.abp.index_t p)
      (exists ((v (domain (abp.index_t (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.abp.index_t lhs rhs)
      (= (Term.abp.index_t.Sem lhs asp) (Term.abp.index_t.Sem rhs asp)))
     ((fol.forall.x0.abp.value p)
      (forall ((v (domain (abp.value (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.abp.value p)
      (exists ((v (domain (abp.value (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.abp.value p)
      (forall ((v (domain (abp.value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.abp.value p)
      (exists ((v (domain (abp.value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.abp.value lhs rhs)
      (= (Term.abp.value.Sem lhs asp) (Term.abp.value.Sem rhs asp)))
     ((fol.atom.abp.abit a0) (abp.abit (Term.abp.ack_msg_t.Sem a0 asp)))
     ((fol.atom.abp.ack_msg.le a0 a1) (abp.ack_msg.le (Term.abp.ack_msg_t.Sem a0 asp) (Term.abp.ack_msg_t.Sem a1 asp)))
     ((fol.atom.abp.ack_received ) (abp.ack_received))
     ((fol.atom.abp.ack_sent ) (abp.ack_sent))
     ((fol.atom.abp.data_msg.le a0 a1) (abp.data_msg.le (Term.abp.data_msg_t.Sem a0 asp) (Term.abp.data_msg_t.Sem a1 asp)))
