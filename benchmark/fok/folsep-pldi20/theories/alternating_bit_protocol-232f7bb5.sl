        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.abp.data_msg_t p)
      (exists ((v (domain (abp.data_msg_t (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.abp.data_msg_t lhs rhs)
      (= (Term.abp.data_msg_t.Sem lhs asp) (Term.abp.data_msg_t.Sem rhs asp)))
     ((fol.forall.x0.abp.index_t p)
      (forall ((v (domain (abp.index_t (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.abp.index_t p)
