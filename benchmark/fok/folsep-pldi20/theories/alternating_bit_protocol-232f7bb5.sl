  ((Term.abp.ack_msg_t.Sem (term Term.abp.ack_msg_t) (asp FoAsp)))
  :returns abp.ack_msg_t
  ((match term
     ((fol.var.x0.abp.ack_msg_t) (x0 asp))
     ((fol.var.x1.abp.ack_msg_t) (x1 asp))
