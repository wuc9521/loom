        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.abp.data_msg_t p)
      (forall ((v (domain (abp.data_msg_t (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.abp.data_msg_t lhs rhs)
      (and (exists ((v (domain (abp.data_msg_t (model asp))))) (= (Term.abp.data_msg_t.Sem lhs asp) v)) (exists ((v (domain (abp.data_msg_t (model asp))))) (= (Term.abp.data_msg_t.Sem rhs asp) v))))
     ((fol.forall.x0.abp.index_t p)
      (forall ((v (domain (abp.index_t (model asp)))))
