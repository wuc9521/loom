     ((fol.atom.tlb.pc_i15 a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
     ((fol.atom.tlb.pc_i2 a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
     ((fol.atom.tlb.pc_i3 a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
     ((fol.atom.tlb.pc_i4 a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
     ((fol.atom.tlb.pc_i5 a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
     ((fol.atom.tlb.pc_i6 a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
     ((fol.atom.tlb.pc_i7 a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
     ((fol.atom.tlb.pc_i8 a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
