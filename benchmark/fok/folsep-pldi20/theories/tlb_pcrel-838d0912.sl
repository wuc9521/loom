(define-finite FoAsp (record (model Model) (x0 (union fol.bot tlb.pageentry tlb.pmap tlb.processor)) (x1 (union fol.bot tlb.pageentry tlb.pmap tlb.processor))))

(define-semantics
  ((Term.tlb.pageentry.Sem (term Term.tlb.pageentry) (asp FoAsp)))
  :returns tlb.pageentry
  ((match term
     ((fol.var.x0.tlb.pageentry) (x0 asp))
     ((fol.var.x1.tlb.pageentry) (x1 asp))
     ((fol.term.tlb.pentry a0) (tlb.pentry (Term.tlb.pmap.Sem a0 asp)))
     ((fol.term.tlb.tlb a0) (tlb.tlb (Term.tlb.processor.Sem a0 asp)))
  )))

(define-semantics
  ((Term.tlb.pmap.Sem (term Term.tlb.pmap) (asp FoAsp)))
  :returns tlb.pmap
  ((match term
     ((fol.var.x0.tlb.pmap) (x0 asp))
     ((fol.var.x1.tlb.pmap) (x1 asp))
     ((fol.term.tlb.tp1.sk2) tlb.tp1.sk2)
     ((fol.term.tlb.userpmap a0) (tlb.userpmap (Term.tlb.processor.Sem a0 asp)))
     ((fol.term.tlb.writepmap a0) (tlb.writepmap (Term.tlb.processor.Sem a0 asp)))
  )))

(define-semantics
  ((Term.tlb.processor.Sem (term Term.tlb.processor) (asp FoAsp)))
  :returns tlb.processor
  ((match term
     ((fol.var.x0.tlb.processor) (x0 asp))
     ((fol.var.x1.tlb.processor) (x1 asp))
     ((fol.term.tlb.tp1.sk0) tlb.tp1.sk0)
     ((fol.term.tlb.tp1.sk1) tlb.tp1.sk1)
  )))

(define-semantics
  ((FO.Sem (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) false)
     ((fol.not p) (not (FO.Sem p asp)))
     ((fol.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.forall.x0.tlb.pageentry p)
      (forall ((v (domain (tlb.pageentry (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.tlb.pageentry p)
      (exists ((v (domain (tlb.pageentry (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.tlb.pageentry p)
      (forall ((v (domain (tlb.pageentry (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.tlb.pageentry p)
      (exists ((v (domain (tlb.pageentry (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.tlb.pageentry lhs rhs)
      (= (Term.tlb.pageentry.Sem lhs asp) (Term.tlb.pageentry.Sem rhs asp)))
     ((fol.forall.x0.tlb.pmap p)
      (forall ((v (domain (tlb.pmap (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.tlb.pmap p)
      (exists ((v (domain (tlb.pmap (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.tlb.pmap p)
      (forall ((v (domain (tlb.pmap (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.tlb.pmap p)
      (exists ((v (domain (tlb.pmap (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.tlb.pmap lhs rhs)
      (= (Term.tlb.pmap.Sem lhs asp) (Term.tlb.pmap.Sem rhs asp)))
     ((fol.forall.x0.tlb.processor p)
      (forall ((v (domain (tlb.processor (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.tlb.processor p)
      (exists ((v (domain (tlb.processor (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.tlb.processor p)
      (forall ((v (domain (tlb.processor (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.tlb.processor p)
      (exists ((v (domain (tlb.processor (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.tlb.processor lhs rhs)
      (= (Term.tlb.processor.Sem lhs asp) (Term.tlb.processor.Sem rhs asp)))
     ((fol.atom.tlb.actionlock a0) (tlb.actionlock (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.actionneeded a0) (tlb.actionneeded (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.active a0) (tlb.active (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.currentcpu a0 a1) (tlb.currentcpu (Term.tlb.processor.Sem a0 asp) (Term.tlb.processor.Sem a1 asp)))
     ((fol.atom.tlb.error ) (tlb.error))
     ((fol.atom.tlb.interrupt a0) (tlb.interrupt (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_b1 a0) (tlb.pc_b1 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_i1 a0) (tlb.pc_i1 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_i11 a0) (tlb.pc_i11 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_i12 a0) (tlb.pc_i12 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_i14 a0) (tlb.pc_i14 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_i15 a0) (tlb.pc_i15 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_i2 a0) (tlb.pc_i2 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_i3 a0) (tlb.pc_i3 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_i4 a0) (tlb.pc_i4 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_i5 a0) (tlb.pc_i5 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_i6 a0) (tlb.pc_i6 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_i7 a0) (tlb.pc_i7 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_i8 a0) (tlb.pc_i8 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_i9 a0) (tlb.pc_i9 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_m2 a0) (tlb.pc_m2 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_m3 a0) (tlb.pc_m3 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_m5 a0) (tlb.pc_m5 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_r1 a0) (tlb.pc_r1 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_r2 a0) (tlb.pc_r2 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_r3 a0) (tlb.pc_r3 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_r5 a0) (tlb.pc_r5 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_r6 a0) (tlb.pc_r6 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_r7 a0) (tlb.pc_r7 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.pc_r8 a0) (tlb.pc_r8 (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.plock a0) (tlb.plock (Term.tlb.pmap.Sem a0 asp)))
     ((fol.atom.tlb.scheduled a0) (tlb.scheduled (Term.tlb.processor.Sem a0 asp)))
     ((fol.atom.tlb.todo a0 a1) (tlb.todo (Term.tlb.processor.Sem a0 asp) (Term.tlb.processor.Sem a1 asp)))
  )))

(define-semantics
  ((FO.Valid (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) true)
     ((fol.not p) (FO.Valid p asp))
     ((fol.and p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.or p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.forall.x0.tlb.pageentry p)
      (forall ((v (domain (tlb.pageentry (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.tlb.pageentry p)
      (forall ((v (domain (tlb.pageentry (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.tlb.pageentry p)
      (forall ((v (domain (tlb.pageentry (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.tlb.pageentry p)
      (forall ((v (domain (tlb.pageentry (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.tlb.pageentry lhs rhs)
      (and (exists ((v (domain (tlb.pageentry (model asp))))) (= (Term.tlb.pageentry.Sem lhs asp) v)) (exists ((v (domain (tlb.pageentry (model asp))))) (= (Term.tlb.pageentry.Sem rhs asp) v))))
     ((fol.forall.x0.tlb.pmap p)
      (forall ((v (domain (tlb.pmap (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.tlb.pmap p)
      (forall ((v (domain (tlb.pmap (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.tlb.pmap p)
      (forall ((v (domain (tlb.pmap (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.tlb.pmap p)
      (forall ((v (domain (tlb.pmap (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.tlb.pmap lhs rhs)
      (and (exists ((v (domain (tlb.pmap (model asp))))) (= (Term.tlb.pmap.Sem lhs asp) v)) (exists ((v (domain (tlb.pmap (model asp))))) (= (Term.tlb.pmap.Sem rhs asp) v))))
     ((fol.forall.x0.tlb.processor p)
      (forall ((v (domain (tlb.processor (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.tlb.processor p)
      (forall ((v (domain (tlb.processor (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.tlb.processor p)
      (forall ((v (domain (tlb.processor (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.tlb.processor p)
      (forall ((v (domain (tlb.processor (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.tlb.processor lhs rhs)
      (and (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem lhs asp) v)) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem rhs asp) v))))
     ((fol.atom.tlb.actionlock a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
     ((fol.atom.tlb.actionneeded a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
     ((fol.atom.tlb.active a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
     ((fol.atom.tlb.currentcpu a0 a1) (and (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a1 asp) v))))
     ((fol.atom.tlb.error ) true)
     ((fol.atom.tlb.interrupt a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
     ((fol.atom.tlb.pc_b1 a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
     ((fol.atom.tlb.pc_i1 a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
     ((fol.atom.tlb.pc_i11 a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
     ((fol.atom.tlb.pc_i12 a0) (exists ((v (domain (tlb.processor (model asp))))) (= (Term.tlb.processor.Sem a0 asp) v)))
