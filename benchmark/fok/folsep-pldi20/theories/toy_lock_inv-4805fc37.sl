(provide epoch node zero ep held le locked transfer Formula FoAsp Term.epoch Term.epoch.Sem Term.node Term.node.Sem FO.Sem FO.Valid fol.true fol.false fol.not fol.and fol.or fol.forall.x0.epoch fol.exists.x0.epoch fol.forall.x1.epoch fol.exists.x1.epoch fol.eq.epoch fol.forall.x0.node fol.exists.x0.node fol.forall.x1.node fol.exists.x1.node fol.eq.node fol.atom.held fol.atom.le fol.atom.locked fol.atom.transfer fol.var.x0.epoch fol.var.x1.epoch fol.term.zero fol.term.ep fol.var.x0.node fol.var.x1.node)
(set-logic ALL)
(declare-sort epoch 0)
(declare-sort node 0)
(declare-fun zero () epoch)
(declare-fun ep (node) epoch)
(declare-fun held (node) Bool)
(declare-fun le (epoch epoch) Bool)
(declare-fun locked (epoch node) Bool)
(declare-fun transfer (epoch node) Bool)

(declare-term-types
 ((Formula 0) (Term.epoch 0) (Term.node 0))
 (((fol.true)
   (fol.false)
   (fol.not Formula)
   (fol.and Formula Formula)
   (fol.or Formula Formula)
   (fol.forall.x0.epoch Formula)
   (fol.exists.x0.epoch Formula)
   (fol.forall.x1.epoch Formula)
   (fol.exists.x1.epoch Formula)
   (fol.eq.epoch Term.epoch Term.epoch)
   (fol.forall.x0.node Formula)
   (fol.exists.x0.node Formula)
   (fol.forall.x1.node Formula)
   (fol.exists.x1.node Formula)
   (fol.eq.node Term.node Term.node)
   (fol.atom.held Term.node)
   (fol.atom.le Term.epoch Term.epoch)
   (fol.atom.locked Term.epoch Term.node)
   (fol.atom.transfer Term.epoch Term.node))
  ((fol.var.x0.epoch)
   (fol.var.x1.epoch)
   (fol.term.zero)
   (fol.term.ep Term.node))
  ((fol.var.x0.node)
   (fol.var.x1.node))))

(define-finite FoAsp (record (model Model) (x0 (union fol.bot epoch node)) (x1 (union fol.bot epoch node))))

(define-semantics
  ((Term.epoch.Sem (term Term.epoch) (asp FoAsp)))
  :returns epoch
  ((match term
     ((fol.var.x0.epoch) (x0 asp))
     ((fol.var.x1.epoch) (x1 asp))
     ((fol.term.zero) zero)
     ((fol.term.ep a0) (ep (Term.node.Sem a0 asp)))
  )))

(define-semantics
  ((Term.node.Sem (term Term.node) (asp FoAsp)))
  :returns node
  ((match term
     ((fol.var.x0.node) (x0 asp))
     ((fol.var.x1.node) (x1 asp))
  )))

(define-semantics
  ((FO.Sem (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) false)
     ((fol.not p) (not (FO.Sem p asp)))
     ((fol.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.forall.x0.epoch p)
      (forall ((v (domain (epoch (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.epoch p)
      (exists ((v (domain (epoch (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.epoch p)
      (forall ((v (domain (epoch (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.epoch p)
      (exists ((v (domain (epoch (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.epoch lhs rhs)
      (= (Term.epoch.Sem lhs asp) (Term.epoch.Sem rhs asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (= (Term.node.Sem lhs asp) (Term.node.Sem rhs asp)))
     ((fol.atom.held a0) (held (Term.node.Sem a0 asp)))
     ((fol.atom.le a0 a1) (le (Term.epoch.Sem a0 asp) (Term.epoch.Sem a1 asp)))
     ((fol.atom.locked a0 a1) (locked (Term.epoch.Sem a0 asp) (Term.node.Sem a1 asp)))
     ((fol.atom.transfer a0 a1) (transfer (Term.epoch.Sem a0 asp) (Term.node.Sem a1 asp)))
  )))

(define-semantics
  ((FO.Valid (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) true)
     ((fol.not p) (FO.Valid p asp))
     ((fol.and p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.or p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.forall.x0.epoch p)
      (forall ((v (domain (epoch (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.epoch p)
      (forall ((v (domain (epoch (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.epoch p)
      (forall ((v (domain (epoch (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.epoch p)
      (forall ((v (domain (epoch (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.epoch lhs rhs)
      (and (exists ((v (domain (epoch (model asp))))) (= (Term.epoch.Sem lhs asp) v)) (exists ((v (domain (epoch (model asp))))) (= (Term.epoch.Sem rhs asp) v))))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem lhs asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem rhs asp) v))))
     ((fol.atom.held a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.le a0 a1) (and (exists ((v (domain (epoch (model asp))))) (= (Term.epoch.Sem a0 asp) v)) (exists ((v (domain (epoch (model asp))))) (= (Term.epoch.Sem a1 asp) v))))
     ((fol.atom.locked a0 a1) (and (exists ((v (domain (epoch (model asp))))) (= (Term.epoch.Sem a0 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a1 asp) v))))
     ((fol.atom.transfer a0 a1) (and (exists ((v (domain (epoch (model asp))))) (= (Term.epoch.Sem a0 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a1 asp) v))))
  )))
