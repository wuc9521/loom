(provide node quorum_c quorum_f round value none any_msg decision fast le left_rnd member_c member_f one_a one_b proposal s vote Formula FoAsp Term.node Term.node.Sem Term.quorum_c Term.quorum_c.Sem Term.quorum_f Term.quorum_f.Sem Term.round Term.round.Sem Term.value Term.value.Sem FO.Sem fol.true fol.false fol.not fol.and fol.or fol.forall.x0.node fol.exists.x0.node fol.forall.x1.node fol.exists.x1.node fol.eq.node fol.forall.x0.quorum_c fol.exists.x0.quorum_c fol.forall.x1.quorum_c fol.exists.x1.quorum_c fol.eq.quorum_c fol.forall.x0.quorum_f fol.exists.x0.quorum_f fol.forall.x1.quorum_f fol.exists.x1.quorum_f fol.eq.quorum_f fol.forall.x0.round fol.exists.x0.round fol.forall.x1.round fol.exists.x1.round fol.eq.round fol.forall.x0.value fol.exists.x0.value fol.forall.x1.value fol.exists.x1.value fol.eq.value fol.atom.any_msg fol.atom.decision fol.atom.fast fol.atom.le fol.atom.left_rnd fol.atom.member_c fol.atom.member_f fol.atom.one_a fol.atom.one_b fol.atom.proposal fol.atom.s fol.atom.vote fol.var.x0.node fol.var.x1.node fol.var.x0.quorum_c fol.var.x1.quorum_c fol.var.x0.quorum_f fol.var.x1.quorum_f fol.var.x0.round fol.var.x1.round fol.term.none fol.var.x0.value fol.var.x1.value)
(set-logic ALL)
(declare-sort node 0)
(declare-sort quorum_c 0)
(declare-sort quorum_f 0)
(declare-sort round 0)
(declare-sort value 0)
(declare-fun none () round)
(declare-fun any_msg (round) Bool)
(declare-fun decision (node round value) Bool)
(declare-fun fast (round) Bool)
(declare-fun le (round round) Bool)
(declare-fun left_rnd (node round) Bool)
(declare-fun member_c (node quorum_c) Bool)
(declare-fun member_f (node quorum_f) Bool)
(declare-fun one_a (round) Bool)
(declare-fun one_b (node round) Bool)
(declare-fun proposal (round value) Bool)
(declare-fun s (node) Bool)
(declare-fun vote (node round value) Bool)

(declare-term-types
 ((Formula 0) (Term.node 0) (Term.quorum_c 0) (Term.quorum_f 0) (Term.round 0) (Term.value 0))
 (((fol.true)
   (fol.false)
   (fol.not Formula)
   (fol.and Formula Formula)
   (fol.or Formula Formula)
   (fol.forall.x0.node Formula)
   (fol.exists.x0.node Formula)
   (fol.forall.x1.node Formula)
   (fol.exists.x1.node Formula)
   (fol.eq.node Term.node Term.node)
   (fol.forall.x0.quorum_c Formula)
   (fol.exists.x0.quorum_c Formula)
   (fol.forall.x1.quorum_c Formula)
   (fol.exists.x1.quorum_c Formula)
   (fol.eq.quorum_c Term.quorum_c Term.quorum_c)
   (fol.forall.x0.quorum_f Formula)
   (fol.exists.x0.quorum_f Formula)
   (fol.forall.x1.quorum_f Formula)
   (fol.exists.x1.quorum_f Formula)
   (fol.eq.quorum_f Term.quorum_f Term.quorum_f)
   (fol.forall.x0.round Formula)
   (fol.exists.x0.round Formula)
   (fol.forall.x1.round Formula)
   (fol.exists.x1.round Formula)
   (fol.eq.round Term.round Term.round)
   (fol.forall.x0.value Formula)
   (fol.exists.x0.value Formula)
   (fol.forall.x1.value Formula)
   (fol.exists.x1.value Formula)
   (fol.eq.value Term.value Term.value)
   (fol.atom.any_msg Term.round)
   (fol.atom.decision Term.node Term.round Term.value)
   (fol.atom.fast Term.round)
   (fol.atom.le Term.round Term.round)
   (fol.atom.left_rnd Term.node Term.round)
   (fol.atom.member_c Term.node Term.quorum_c)
   (fol.atom.member_f Term.node Term.quorum_f)
   (fol.atom.one_a Term.round)
   (fol.atom.one_b Term.node Term.round)
   (fol.atom.proposal Term.round Term.value)
   (fol.atom.s Term.node)
   (fol.atom.vote Term.node Term.round Term.value))
  ((fol.var.x0.node)
   (fol.var.x1.node))
  ((fol.var.x0.quorum_c)
   (fol.var.x1.quorum_c))
  ((fol.var.x0.quorum_f)
   (fol.var.x1.quorum_f))
  ((fol.var.x0.round)
   (fol.var.x1.round)
   (fol.term.none))
  ((fol.var.x0.value)
   (fol.var.x1.value))))

(define-finite FoAsp (record (model Model) (x0.node node) (x1.node node) (x0.quorum_c quorum_c) (x1.quorum_c quorum_c) (x0.quorum_f quorum_f) (x1.quorum_f quorum_f) (x0.round round) (x1.round round) (x0.value value) (x1.value value)))

(define-semantics
  ((Term.node.Sem (term Term.node) (asp FoAsp)))
  :returns node
  ((match term
     ((fol.var.x0.node) (x0.node asp))
     ((fol.var.x1.node) (x1.node asp))
  )))

(define-semantics
  ((Term.quorum_c.Sem (term Term.quorum_c) (asp FoAsp)))
  :returns quorum_c
  ((match term
     ((fol.var.x0.quorum_c) (x0.quorum_c asp))
     ((fol.var.x1.quorum_c) (x1.quorum_c asp))
  )))

(define-semantics
  ((Term.quorum_f.Sem (term Term.quorum_f) (asp FoAsp)))
  :returns quorum_f
  ((match term
     ((fol.var.x0.quorum_f) (x0.quorum_f asp))
     ((fol.var.x1.quorum_f) (x1.quorum_f asp))
  )))

(define-semantics
  ((Term.round.Sem (term Term.round) (asp FoAsp)))
  :returns round
  ((match term
     ((fol.var.x0.round) (x0.round asp))
     ((fol.var.x1.round) (x1.round asp))
     ((fol.term.none) none)
  )))

(define-semantics
  ((Term.value.Sem (term Term.value) (asp FoAsp)))
  :returns value
  ((match term
     ((fol.var.x0.value) (x0.value asp))
     ((fol.var.x1.value) (x1.value asp))
  )))

(define-semantics
  ((FO.Sem (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) false)
     ((fol.not p) (not (FO.Sem p asp)))
     ((fol.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1.node asp) (x0.quorum_c asp) (x1.quorum_c asp) (x0.quorum_f asp) (x1.quorum_f asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.exists.x0.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1.node asp) (x0.quorum_c asp) (x1.quorum_c asp) (x0.quorum_f asp) (x1.quorum_f asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) v (x0.quorum_c asp) (x1.quorum_c asp) (x0.quorum_f asp) (x1.quorum_f asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.exists.x1.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) v (x0.quorum_c asp) (x1.quorum_c asp) (x0.quorum_f asp) (x1.quorum_f asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.eq.node lhs rhs)
      (= (Term.node.Sem lhs asp) (Term.node.Sem rhs asp)))
     ((fol.forall.x0.quorum_c p)
      (forall ((v (domain (quorum_c (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) v (x1.quorum_c asp) (x0.quorum_f asp) (x1.quorum_f asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.exists.x0.quorum_c p)
      (exists ((v (domain (quorum_c (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) v (x1.quorum_c asp) (x0.quorum_f asp) (x1.quorum_f asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.forall.x1.quorum_c p)
      (forall ((v (domain (quorum_c (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) (x0.quorum_c asp) v (x0.quorum_f asp) (x1.quorum_f asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.exists.x1.quorum_c p)
      (exists ((v (domain (quorum_c (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) (x0.quorum_c asp) v (x0.quorum_f asp) (x1.quorum_f asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.eq.quorum_c lhs rhs)
      (= (Term.quorum_c.Sem lhs asp) (Term.quorum_c.Sem rhs asp)))
     ((fol.forall.x0.quorum_f p)
      (forall ((v (domain (quorum_f (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) (x0.quorum_c asp) (x1.quorum_c asp) v (x1.quorum_f asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.exists.x0.quorum_f p)
      (exists ((v (domain (quorum_f (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) (x0.quorum_c asp) (x1.quorum_c asp) v (x1.quorum_f asp) (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.forall.x1.quorum_f p)
      (forall ((v (domain (quorum_f (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) (x0.quorum_c asp) (x1.quorum_c asp) (x0.quorum_f asp) v (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.exists.x1.quorum_f p)
      (exists ((v (domain (quorum_f (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) (x0.quorum_c asp) (x1.quorum_c asp) (x0.quorum_f asp) v (x0.round asp) (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.eq.quorum_f lhs rhs)
      (= (Term.quorum_f.Sem lhs asp) (Term.quorum_f.Sem rhs asp)))
     ((fol.forall.x0.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) (x0.quorum_c asp) (x1.quorum_c asp) (x0.quorum_f asp) (x1.quorum_f asp) v (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.exists.x0.round p)
      (exists ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) (x0.quorum_c asp) (x1.quorum_c asp) (x0.quorum_f asp) (x1.quorum_f asp) v (x1.round asp) (x0.value asp) (x1.value asp)))))
     ((fol.forall.x1.round p)
      (forall ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) (x0.quorum_c asp) (x1.quorum_c asp) (x0.quorum_f asp) (x1.quorum_f asp) (x0.round asp) v (x0.value asp) (x1.value asp)))))
     ((fol.exists.x1.round p)
      (exists ((v (domain (round (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) (x0.quorum_c asp) (x1.quorum_c asp) (x0.quorum_f asp) (x1.quorum_f asp) (x0.round asp) v (x0.value asp) (x1.value asp)))))
     ((fol.eq.round lhs rhs)
      (= (Term.round.Sem lhs asp) (Term.round.Sem rhs asp)))
     ((fol.forall.x0.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) (x0.quorum_c asp) (x1.quorum_c asp) (x0.quorum_f asp) (x1.quorum_f asp) (x0.round asp) (x1.round asp) v (x1.value asp)))))
     ((fol.exists.x0.value p)
      (exists ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) (x0.quorum_c asp) (x1.quorum_c asp) (x0.quorum_f asp) (x1.quorum_f asp) (x0.round asp) (x1.round asp) v (x1.value asp)))))
     ((fol.forall.x1.value p)
      (forall ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) (x0.quorum_c asp) (x1.quorum_c asp) (x0.quorum_f asp) (x1.quorum_f asp) (x0.round asp) (x1.round asp) (x0.value asp) v))))
     ((fol.exists.x1.value p)
      (exists ((v (domain (value (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0.node asp) (x1.node asp) (x0.quorum_c asp) (x1.quorum_c asp) (x0.quorum_f asp) (x1.quorum_f asp) (x0.round asp) (x1.round asp) (x0.value asp) v))))
     ((fol.eq.value lhs rhs)
      (= (Term.value.Sem lhs asp) (Term.value.Sem rhs asp)))
     ((fol.atom.any_msg a0) (any_msg (Term.round.Sem a0 asp)))
     ((fol.atom.decision a0 a1 a2) (decision (Term.node.Sem a0 asp) (Term.round.Sem a1 asp) (Term.value.Sem a2 asp)))
     ((fol.atom.fast a0) (fast (Term.round.Sem a0 asp)))
     ((fol.atom.le a0 a1) (le (Term.round.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.left_rnd a0 a1) (left_rnd (Term.node.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.member_c a0 a1) (member_c (Term.node.Sem a0 asp) (Term.quorum_c.Sem a1 asp)))
     ((fol.atom.member_f a0 a1) (member_f (Term.node.Sem a0 asp) (Term.quorum_f.Sem a1 asp)))
     ((fol.atom.one_a a0) (one_a (Term.round.Sem a0 asp)))
     ((fol.atom.one_b a0 a1) (one_b (Term.node.Sem a0 asp) (Term.round.Sem a1 asp)))
     ((fol.atom.proposal a0 a1) (proposal (Term.round.Sem a0 asp) (Term.value.Sem a1 asp)))
     ((fol.atom.s a0) (s (Term.node.Sem a0 asp)))
     ((fol.atom.vote a0 a1 a2) (vote (Term.node.Sem a0 asp) (Term.round.Sem a1 asp) (Term.value.Sem a2 asp)))
  )))
