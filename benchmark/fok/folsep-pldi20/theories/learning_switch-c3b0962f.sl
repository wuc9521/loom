(provide node packet dst src link pending route.dom route.tc Formula FoAsp Term.node Term.node.Sem Term.packet Term.packet.Sem FO.Sem FO.Valid fol.true fol.false fol.not fol.and fol.or fol.forall.x0.node fol.exists.x0.node fol.forall.x1.node fol.exists.x1.node fol.eq.node fol.forall.x0.packet fol.exists.x0.packet fol.forall.x1.packet fol.exists.x1.packet fol.eq.packet fol.atom.link fol.atom.pending fol.atom.route.dom fol.atom.route.tc fol.var.x0.node fol.var.x1.node fol.term.dst fol.term.src fol.var.x0.packet fol.var.x1.packet)
(set-logic ALL)
(declare-sort node 0)
(declare-sort packet 0)
(declare-fun dst (packet) node)
(declare-fun src (packet) node)
(declare-fun link (node node) Bool)
(declare-fun pending (packet node node) Bool)
(declare-fun route.dom (node node) Bool)
(declare-fun route.tc (node node node) Bool)

(declare-term-types
 ((Formula 0) (Term.node 0) (Term.packet 0))
 (((fol.true)
   (fol.false)
   (fol.not Formula)
   (fol.and Formula Formula)
   (fol.or Formula Formula)
   (fol.forall.x0.node Formula)
   (fol.exists.x0.node Formula)
   (fol.forall.x1.node Formula)
   (fol.exists.x1.node Formula)
   (fol.eq.node Term.node Term.node)
   (fol.forall.x0.packet Formula)
   (fol.exists.x0.packet Formula)
   (fol.forall.x1.packet Formula)
   (fol.exists.x1.packet Formula)
   (fol.eq.packet Term.packet Term.packet)
   (fol.atom.link Term.node Term.node)
   (fol.atom.pending Term.packet Term.node Term.node)
   (fol.atom.route.dom Term.node Term.node)
   (fol.atom.route.tc Term.node Term.node Term.node))
  ((fol.var.x0.node)
   (fol.var.x1.node)
   (fol.term.dst Term.packet)
   (fol.term.src Term.packet))
  ((fol.var.x0.packet)
   (fol.var.x1.packet))))

(define-finite FoAsp (record (model Model) (x0 (union fol.bot node packet)) (x1 (union fol.bot node packet))))

(define-semantics
  ((Term.node.Sem (term Term.node) (asp FoAsp)))
  :returns node
  ((match term
     ((fol.var.x0.node) (x0 asp))
     ((fol.var.x1.node) (x1 asp))
     ((fol.term.dst a0) (dst (Term.packet.Sem a0 asp)))
     ((fol.term.src a0) (src (Term.packet.Sem a0 asp)))
  )))

(define-semantics
  ((Term.packet.Sem (term Term.packet) (asp FoAsp)))
  :returns packet
  ((match term
     ((fol.var.x0.packet) (x0 asp))
     ((fol.var.x1.packet) (x1 asp))
  )))

(define-semantics
  ((FO.Sem (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) false)
     ((fol.not p) (not (FO.Sem p asp)))
     ((fol.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (= (Term.node.Sem lhs asp) (Term.node.Sem rhs asp)))
     ((fol.forall.x0.packet p)
      (forall ((v (domain (packet (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.packet p)
      (exists ((v (domain (packet (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.packet p)
      (forall ((v (domain (packet (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.packet p)
      (exists ((v (domain (packet (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.packet lhs rhs)
      (= (Term.packet.Sem lhs asp) (Term.packet.Sem rhs asp)))
     ((fol.atom.link a0 a1) (link (Term.node.Sem a0 asp) (Term.node.Sem a1 asp)))
     ((fol.atom.pending a0 a1 a2) (pending (Term.packet.Sem a0 asp) (Term.node.Sem a1 asp) (Term.node.Sem a2 asp)))
     ((fol.atom.route.dom a0 a1) (route.dom (Term.node.Sem a0 asp) (Term.node.Sem a1 asp)))
     ((fol.atom.route.tc a0 a1 a2) (route.tc (Term.node.Sem a0 asp) (Term.node.Sem a1 asp) (Term.node.Sem a2 asp)))
  )))

(define-semantics
  ((FO.Valid (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) true)
     ((fol.not p) (FO.Valid p asp))
     ((fol.and p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.or p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem lhs asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem rhs asp) v))))
     ((fol.forall.x0.packet p)
      (forall ((v (domain (packet (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.packet p)
      (forall ((v (domain (packet (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.packet p)
      (forall ((v (domain (packet (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.packet p)
      (forall ((v (domain (packet (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.packet lhs rhs)
      (and (exists ((v (domain (packet (model asp))))) (= (Term.packet.Sem lhs asp) v)) (exists ((v (domain (packet (model asp))))) (= (Term.packet.Sem rhs asp) v))))
     ((fol.atom.link a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a1 asp) v))))
     ((fol.atom.pending a0 a1 a2) (and (exists ((v (domain (packet (model asp))))) (= (Term.packet.Sem a0 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a1 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a2 asp) v))))
     ((fol.atom.route.dom a0 a1) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a1 asp) v))))
     ((fol.atom.route.tc a0 a1 a2) (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a1 asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a2 asp) v))))
  )))
