(provide node grant_msg holds_lock lock_msg server_holds_lock unlock_msg Formula FoAsp Term.node Term.node.Sem FO.Sem FO.Valid fol.true fol.false fol.not fol.and fol.or fol.forall.x0.node fol.exists.x0.node fol.forall.x1.node fol.exists.x1.node fol.eq.node fol.atom.grant_msg fol.atom.holds_lock fol.atom.lock_msg fol.atom.server_holds_lock fol.atom.unlock_msg fol.var.x0.node fol.var.x1.node)
(set-logic ALL)
(declare-sort node 0)
(declare-fun grant_msg (node) Bool)
(declare-fun holds_lock (node) Bool)
(declare-fun lock_msg (node) Bool)
(declare-fun server_holds_lock () Bool)
(declare-fun unlock_msg (node) Bool)

(declare-term-types
 ((Formula 0) (Term.node 0))
 (((fol.true)
   (fol.false)
   (fol.not Formula)
   (fol.and Formula Formula)
   (fol.or Formula Formula)
   (fol.forall.x0.node Formula)
   (fol.exists.x0.node Formula)
   (fol.forall.x1.node Formula)
   (fol.exists.x1.node Formula)
   (fol.eq.node Term.node Term.node)
   (fol.atom.grant_msg Term.node)
   (fol.atom.holds_lock Term.node)
   (fol.atom.lock_msg Term.node)
   (fol.atom.server_holds_lock )
   (fol.atom.unlock_msg Term.node))
  ((fol.var.x0.node)
   (fol.var.x1.node))))

(define-finite FoAsp (record (model Model) (x0 (union fol.bot node)) (x1 (union fol.bot node))))

(define-semantics
  ((Term.node.Sem (term Term.node) (asp FoAsp)))
  :returns node
  ((match term
     ((fol.var.x0.node) (x0 asp))
     ((fol.var.x1.node) (x1 asp))
  )))

(define-semantics
  ((FO.Sem (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) false)
     ((fol.not p) (not (FO.Sem p asp)))
     ((fol.and p q) (and (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.or p q) (or (FO.Sem p asp) (FO.Sem q asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (exists ((v (domain (node (model asp)))))
        (FO.Sem p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (= (Term.node.Sem lhs asp) (Term.node.Sem rhs asp)))
     ((fol.atom.grant_msg a0) (grant_msg (Term.node.Sem a0 asp)))
     ((fol.atom.holds_lock a0) (holds_lock (Term.node.Sem a0 asp)))
     ((fol.atom.lock_msg a0) (lock_msg (Term.node.Sem a0 asp)))
     ((fol.atom.server_holds_lock ) (server_holds_lock))
     ((fol.atom.unlock_msg a0) (unlock_msg (Term.node.Sem a0 asp)))
  )))

(define-semantics
  ((FO.Valid (phi Formula) (asp FoAsp)))
  ((match phi
     ((fol.true) true)
     ((fol.false) true)
     ((fol.not p) (FO.Valid p asp))
     ((fol.and p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.or p q) (and (FO.Valid p asp) (FO.Valid q asp)))
     ((fol.forall.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.exists.x0.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) v (x1 asp)))))
     ((fol.forall.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.exists.x1.node p)
      (forall ((v (domain (node (model asp)))))
        (FO.Valid p (FoAsp (model asp) (x0 asp) v))))
     ((fol.eq.node lhs rhs)
      (and (exists ((v (domain (node (model asp))))) (= (Term.node.Sem lhs asp) v)) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem rhs asp) v))))
     ((fol.atom.grant_msg a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.holds_lock a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.lock_msg a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
     ((fol.atom.server_holds_lock ) true)
     ((fol.atom.unlock_msg a0) (exists ((v (domain (node (model asp))))) (= (Term.node.Sem a0 asp) v)))
  )))
