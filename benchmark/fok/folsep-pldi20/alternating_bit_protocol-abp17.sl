  (define-univ abp.value (@abp.value_0 @abp.value_1))
  (interp-fun abp.bot (@abp.value_0))
  (interp-fun abp.index.zero (@abp.index_t_0))
  (interp-fun abp.receiver_i (@abp.index_t_0))
  (interp-fun abp.sender_gen_i (@abp.index_t_0))
  (interp-fun abp.sender_i (@abp.index_t_0))
  (interp-fun abp.tp1.sk0 (@abp.index_t_0))
  (interp-fun abp.d (match (
    ((@uc_abp.data_msg_t_0) @abp.value_0)
    ((_) @abp.value_0)
  )))
  (interp-fun abp.receiver_array (match (
    ((@abp.index_t_0) @abp.value_1)
    ((_) @abp.value_0)
  )))
  (interp-fun abp.sender_array (match (
    ((@abp.index_t_0) @abp.value_0)
    ((_) @abp.value_0)
  )))
  (interp-fun abp.abit (match (
    ((@abp.ack_msg_t_1) true)
    ((_) false)
  )))
  (interp-fun abp.ack_msg.le (match (
    ((@abp.ack_msg_t_1 @abp.ack_msg_t_1) true)
    ((_ _) false)
  )))
  (interp-fun abp.ack_received (false))
  (interp-fun abp.ack_sent (false))
  (interp-fun abp.data_msg.le (match (
    ((_ _) false)
  )))
  (interp-fun abp.data_received (false))
  (interp-fun abp.data_sent (false))
  (interp-fun abp.dbit (match (
    ((_) false)
  )))
  (interp-fun abp.index.le (match (
    ((@abp.index_t_0 @abp.index_t_0) true)
    ((_ _) false)
  )))
  (interp-fun abp.receiver_bit (false))
  (interp-fun abp.receiver_scheduled (false))
  (interp-fun abp.sender_bit (true))
  (interp-fun abp.sender_scheduled (false))
)

(synth-fun phi () Formula)

(constraint (FO.Valid phi (FoAsp P0 fol.bot fol.bot)))
(constraint (FO.Sem phi (FoAsp P0 fol.bot fol.bot)))
(constraint (not (FO.Sem phi (FoAsp N1 fol.bot fol.bot))))
(constraint (not (FO.Sem phi (FoAsp N2 fol.bot fol.bot))))
(constraint (not (FO.Sem phi (FoAsp N3 fol.bot fol.bot))))
(constraint (not (FO.Sem phi (FoAsp N4 fol.bot fol.bot))))
(constraint (not (FO.Sem phi (FoAsp N5 fol.bot fol.bot))))
(constraint (FO.Sem phi (FoAsp P6 fol.bot fol.bot)))
(constraint (not (FO.Sem phi (FoAsp N7 fol.bot fol.bot))))
(constraint (FO.Sem phi (FoAsp P8 fol.bot fol.bot)))
(constraint (FO.Sem phi (FoAsp P9 fol.bot fol.bot)))
(constraint (not (FO.Sem phi (FoAsp N10 fol.bot fol.bot))))

(check-synth)
