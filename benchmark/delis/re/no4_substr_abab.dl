(declare-sort Pos 0)
(declare-fun X (Pos) Bool)
(declare-fun a (Pos) Bool)
(declare-fun b (Pos) Bool)
(define-model w1 (define-univ Pos ($0 $1 $2 $3)) (interp-fun b (match ((($0) false) (($1) true) (($2) false) (($3) true)))) (interp-fun a (match ((($0) true) (($1) false) (($2) true) (($3) false)))) )
(define-model w2 (define-univ Pos ($0 $1 $2 $3 $4 $5)) (interp-fun b (match ((($0) false) (($1) false) (($2) true) (($3) false) (($4) true) (($5) false)))) (interp-fun a (match ((($0) false) (($1) true) (($2) false) (($3) true) (($4) false) (($5) false)))) (interp-fun X (match ((($0) true) (($1) false) (($2) false) (($3) false) (($4) false) (($5) true)))) )
(define-model w3 (define-univ Pos ($0 $1 $2 $3 $4 $5 $6 $7)) (interp-fun b (match ((($0) false) (($1) false) (($2) false) (($3) true) (($4) false) (($5) true) (($6) false) (($7) false)))) (interp-fun a (match ((($0) false) (($1) false) (($2) true) (($3) false) (($4) true) (($5) false) (($6) false) (($7) false)))) (interp-fun X (match ((($0) true) (($1) true) (($2) false) (($3) false) (($4) false) (($5) false) (($6) true) (($7) true)))) )
(define-model w4 (define-univ Pos ($0)) (interp-fun b (match ((($0) false)))) (interp-fun a (match ((($0) true)))) (interp-fun X (match ((($0) false)))) )
(define-model w5 (define-univ Pos ($0)) (interp-fun b (match ((($0) true)))) (interp-fun a (match ((($0) false)))) (interp-fun X (match ((($0) false)))) )
(define-model w6 (define-univ Pos ($0 $1)) (interp-fun b (match ((($0) false) (($1) false)))) (interp-fun a (match ((($0) false) (($1) false)))) (interp-fun X (match ((($0) true) (($1) true)))) )
(define-model w7 (define-univ Pos ($0 $1 $2)) (interp-fun b (match ((($0) false) (($1) false) (($2) false)))) (interp-fun a (match ((($0) false) (($1) false) (($2) false)))) (interp-fun X (match ((($0) true) (($1) true) (($2) true)))) )
(define-model w8 (define-univ Pos ($0 $1 $2 $3)) (interp-fun b (match ((($0) false) (($1) false) (($2) false) (($3) false)))) (interp-fun a (match ((($0) false) (($1) false) (($2) false) (($3) true)))) (interp-fun X (match ((($0) true) (($1) true) (($2) true) (($3) false)))) )
(define-model w9 (define-univ Pos ($0 $1 $2 $3)) (interp-fun b (match ((($0) false) (($1) true) (($2) false) (($3) false)))) (interp-fun a (match ((($0) false) (($1) false) (($2) false) (($3) false)))) (interp-fun X (match ((($0) true) (($1) false) (($2) true) (($3) true)))) )
(define-model w10 (define-univ Pos ($0 $1 $2 $3)) (interp-fun b (match ((($0) true) (($1) false) (($2) false) (($3) false)))) (interp-fun a (match ((($0) false) (($1) false) (($2) false) (($3) false)))) (interp-fun X (match ((($0) false) (($1) true) (($2) true) (($3) true)))) )
(define-model w11 (define-univ Pos ($0 $1 $2 $3)) (interp-fun b (match ((($0) false) (($1) false) (($2) true) (($3) false)))) (interp-fun a (match ((($0) false) (($1) false) (($2) false) (($3) false)))) (interp-fun X (match ((($0) true) (($1) true) (($2) false) (($3) true)))) )
(set-logic ALL)
(set-logic ALL)

(declare-term-types
 ((RegLan 0))
 (((a) (b) (X) (re.a) (re.b)
   (re.++ RegLan RegLan)
   (re.union RegLan RegLan)
   (re.inter RegLan RegLan)
   (re.comp RegLan)
   (re.* RegLan))))


(define-finite ReAsp
  (record (model Model) (i Int) (j Int))
  :where (and (<= 0 i) (<= i j) (<= j (len model))))

(define-semantics
  ((RegLan.Sem (r RegLan) (asp ReAsp)))
  ((match r
     ((a) (and (= (j asp) (+ (i asp) 1)) (a (i asp))))
     ((b) (and (= (j asp) (+ (i asp) 1)) (b (i asp))))
     ((X) (and (= (j asp) (+ (i asp) 1)) (X (i asp))))
     ((re.a) (and (= (j asp) (+ (i asp) 1)) (a (i asp))))
     ((re.b) (and (= (j asp) (+ (i asp) 1)) (b (i asp))))
     ((re.++ x y)
      (exists ((k (int-range (i asp) (j asp))))
        (and (RegLan.Sem x (ReAsp (model asp) (i asp) k))
             (RegLan.Sem y (ReAsp (model asp) k (j asp))))))
     ((re.union x y)
      (or (RegLan.Sem x asp) (RegLan.Sem y asp)))
     ((re.inter x y)
      (and (RegLan.Sem x asp) (RegLan.Sem y asp)))
     ((re.comp x)
      (dual (RegLan.Sem x asp)))
     ((re.* x)
      (or (= (i asp) (j asp))
          (exists ((k (int-range (+ (i asp) 1) (j asp))))
            (and (RegLan.Sem x (ReAsp (model asp) (i asp) k))
                 (RegLan.Sem r (ReAsp (model asp) k (j asp))))))))))

(synth-fun regex () RegLan  ((Start RegLan)) ((Start RegLan (a b X (re.++ Start Start) (re.union Start Start) (re.inter Start Start) (re.* Start)))))
(constraint (RegLan.Sem regex (ReAsp w1 0 (len w1))))
(constraint (RegLan.Sem regex (ReAsp w2 0 (len w2))))
(constraint (RegLan.Sem regex (ReAsp w3 0 (len w3))))
(constraint (not (RegLan.Sem regex (ReAsp w4 0 (len w4)))))
(constraint (not (RegLan.Sem regex (ReAsp w5 0 (len w5)))))
(constraint (not (RegLan.Sem regex (ReAsp w6 0 (len w6)))))
(constraint (not (RegLan.Sem regex (ReAsp w7 0 (len w7)))))
(constraint (not (RegLan.Sem regex (ReAsp w8 0 (len w8)))))
(constraint (not (RegLan.Sem regex (ReAsp w9 0 (len w9)))))
(constraint (not (RegLan.Sem regex (ReAsp w10 0 (len w10)))))
(constraint (not (RegLan.Sem regex (ReAsp w11 0 (len w11)))))
(check-synth)
