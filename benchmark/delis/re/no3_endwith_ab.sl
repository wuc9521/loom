(declare-sort Pos 0)
(declare-fun X (Pos) Bool)
(declare-fun a (Pos) Bool)
(declare-fun b (Pos) Bool)
(define-model w1 (define-univ Pos ($0 $1)) (interp-fun b (match ((($0) false) (($1) true)))) (interp-fun a (match ((($0) true) (($1) false)))) )
(define-model w2 (define-univ Pos ($0 $1 $2)) (interp-fun X (match ((($0) true) (($1) false) (($2) false)))) (interp-fun b (match ((($0) false) (($1) false) (($2) true)))) (interp-fun a (match ((($0) false) (($1) true) (($2) false)))) )
(define-model w3 (define-univ Pos ($0 $1 $2 $3)) (interp-fun X (match ((($0) true) (($1) true) (($2) false) (($3) false)))) (interp-fun b (match ((($0) false) (($1) false) (($2) false) (($3) true)))) (interp-fun a (match ((($0) false) (($1) false) (($2) true) (($3) false)))) )
(define-model w4 (define-univ Pos ($0 $1)) (interp-fun X (match ((($0) false) (($1) false)))) (interp-fun b (match ((($0) false) (($1) false)))) (interp-fun a (match ((($0) true) (($1) true)))) )
(define-model w5 (define-univ Pos ($0 $1)) (interp-fun X (match ((($0) false) (($1) false)))) (interp-fun b (match ((($0) true) (($1) false)))) (interp-fun a (match ((($0) false) (($1) true)))) )
(define-model w6 (define-univ Pos ($0 $1)) (interp-fun X (match ((($0) false) (($1) false)))) (interp-fun b (match ((($0) true) (($1) true)))) (interp-fun a (match ((($0) false) (($1) false)))) )
(define-model w7 (define-univ Pos ($0 $1 $2)) (interp-fun X (match ((($0) true) (($1) false) (($2) false)))) (interp-fun b (match ((($0) false) (($1) false) (($2) false)))) (interp-fun a (match ((($0) false) (($1) true) (($2) true)))) )
(define-model w8 (define-univ Pos ($0 $1 $2)) (interp-fun X (match ((($0) true) (($1) false) (($2) false)))) (interp-fun b (match ((($0) false) (($1) true) (($2) false)))) (interp-fun a (match ((($0) false) (($1) false) (($2) true)))) )
(define-model w9 (define-univ Pos ($0 $1 $2)) (interp-fun X (match ((($0) true) (($1) false) (($2) false)))) (interp-fun b (match ((($0) false) (($1) true) (($2) true)))) (interp-fun a (match ((($0) false) (($1) false) (($2) false)))) )
(set-logic RE)
(set-logic SLIA)
(synth-fun regex () RegLan  ((Start RegLan)) ((Start RegLan (a b X (re.++ Start Start) (re.union Start Start) (re.inter Start Start) (re.* Start)))))
(constraint (models w1 regex))
(constraint (models w2 regex))
(constraint (models w3 regex))
(constraint (not (models w4 regex)))
(constraint (not (models w5 regex)))
(constraint (not (models w6 regex)))
(constraint (not (models w7 regex)))
(constraint (not (models w8 regex)))
(constraint (not (models w9 regex)))
(check-synth)
