(declare-sort Pos 0)
(declare-fun a (Pos) Bool)
(declare-fun b (Pos) Bool)
(define-model wb (define-univ Pos ($0)) (interp-fun a (match ((($0) true)))) )
(define-model w2 (define-univ Pos ($0)) (interp-fun a (match ((($0) false)))) (interp-fun b (match ((($0) true)))) )
(define-model w3 (define-univ Pos ($0 $1)) (interp-fun a (match ((($0) true) (($1) false)))) (interp-fun b (match ((($0) false) (($1) true)))) )
(define-model w4 (define-univ Pos ($0 $1)) (interp-fun a (match ((($0) false) (($1) true)))) (interp-fun b (match ((($0) true) (($1) false)))) )
(define-model w5 (define-univ Pos ($0 $1 $2)) (interp-fun a (match ((($0) false) (($1) true) (($2) false)))) (interp-fun b (match ((($0) true) (($1) false) (($2) true)))) )
(define-model w6 (define-univ Pos ($0 $1 $2)) (interp-fun a (match ((($0) true) (($1) false) (($2) true)))) (interp-fun b (match ((($0) false) (($1) true) (($2) false)))) )
(define-model w7 (define-univ Pos ($0 $1 $2 $3)) (interp-fun a (match ((($0) false) (($1) true) (($2) false) (($3) true)))) (interp-fun b (match ((($0) true) (($1) false) (($2) true) (($3) false)))) )
(define-model w8 (define-univ Pos ($0 $1 $2 $3)) (interp-fun a (match ((($0) true) (($1) false) (($2) true) (($3) false)))) (interp-fun b (match ((($0) false) (($1) true) (($2) false) (($3) true)))) )
(define-model w9 (define-univ Pos ($0 $1 $2 $3 $4)) (interp-fun a (match ((($0) false) (($1) true) (($2) false) (($3) true) (($4) false)))) (interp-fun b (match ((($0) true) (($1) false) (($2) true) (($3) false) (($4) true)))) )
(define-model wba (define-univ Pos ($0 $1)) (interp-fun a (match ((($0) true) (($1) true)))) (interp-fun b (match ((($0) false) (($1) false)))) )
(define-model wbb (define-univ Pos ($0 $1)) (interp-fun a (match ((($0) false) (($1) false)))) (interp-fun b (match ((($0) true) (($1) true)))) )
(define-model wb2 (define-univ Pos ($0 $1 $2)) (interp-fun a (match ((($0) true) (($1) false) (($2) false)))) (interp-fun b (match ((($0) false) (($1) true) (($2) true)))) )
(define-model wb3 (define-univ Pos ($0 $1 $2)) (interp-fun a (match ((($0) true) (($1) true) (($2) false)))) (interp-fun b (match ((($0) false) (($1) false) (($2) true)))) )
(define-model wb4 (define-univ Pos ($0 $1 $2)) (interp-fun a (match ((($0) false) (($1) false) (($2) true)))) (interp-fun b (match ((($0) true) (($1) true) (($2) false)))) )
(define-model wb5 (define-univ Pos ($0 $1 $2 $3)) (interp-fun a (match ((($0) false) (($1) true) (($2) true) (($3) false)))) (interp-fun b (match ((($0) true) (($1) false) (($2) false) (($3) true)))) )
(define-model wb6 (define-univ Pos ($0 $1 $2 $3 $4 $5)) (interp-fun a (match ((($0) false) (($1) true) (($2) false) (($3) false) (($4) true) (($5) false)))) (interp-fun b (match ((($0) true) (($1) false) (($2) true) (($3) true) (($4) false) (($5) true)))) )
(define-model wb7 (define-univ Pos ($0 $1 $2 $3 $4 $5)) (interp-fun a (match ((($0) true) (($1) false) (($2) true) (($3) true) (($4) false) (($5) true)))) (interp-fun b (match ((($0) false) (($1) true) (($2) false) (($3) false) (($4) true) (($5) false)))) )
(set-logic RE)
(set-logic SLIA)
(synth-fun regex () RegLan  ((Start RegLan)) ((Start RegLan (a b (re.++ Start Start) (re.union Start Start) (re.inter Start Start) (re.* Start)))))
(constraint (models wb regex))
(constraint (models w2 regex))
(constraint (models w3 regex))
(constraint (models w4 regex))
(constraint (models w5 regex))
(constraint (models w6 regex))
(constraint (models w7 regex))
(constraint (models w8 regex))
(constraint (models w9 regex))
(constraint (not (models wba regex)))
(constraint (not (models wbb regex)))
(constraint (not (models wb2 regex)))
(constraint (not (models wb3 regex)))
(constraint (not (models wb4 regex)))
(constraint (not (models wb5 regex)))
(constraint (not (models wb6 regex)))
(constraint (not (models wb7 regex)))
(check-synth)
