(declare-sort Pos 0)
(declare-fun a (Pos) Bool)
(declare-fun b (Pos) Bool)
(define-model w1 (define-univ Pos ($0 $1)) (interp-fun a (match ((($0) true) (($1) false)))) (interp-fun b (match ((($0) false) (($1) true)))) )
(define-model w2 (define-univ Pos ($0 $1 $2 $3)) (interp-fun a (match ((($0) true) (($1) false) (($2) true) (($3) false)))) (interp-fun b (match ((($0) false) (($1) true) (($2) false) (($3) true)))) )
(define-model w3 (define-univ Pos ($0 $1 $2 $3 $4 $5)) (interp-fun a (match ((($0) true) (($1) false) (($2) true) (($3) false) (($4) true) (($5) false)))) (interp-fun b (match ((($0) false) (($1) true) (($2) false) (($3) true) (($4) false) (($5) true)))) )
(define-model w4 (define-univ Pos ($0 $1 $2)) (interp-fun a (match ((($0) false) (($1) true) (($2) true)))) (interp-fun b (match ((($0) true) (($1) false) (($2) false)))) )
(define-model w5 (define-univ Pos ($0 $1 $2)) (interp-fun a (match ((($0) true) (($1) true) (($2) false)))) (interp-fun b (match ((($0) false) (($1) false) (($2) true)))) )
(set-logic RE)
(set-logic SLIA)
(synth-fun regex () RegLan  ((Start RegLan)) ((Start RegLan (a b (re.++ Start Start) (re.union Start Start) (re.inter Start Start) (re.* Start)))))
(constraint (models w1 regex))
(constraint (models w2 regex))
(constraint (models w3 regex))
(constraint (not (models w4 regex)))
(constraint (not (models w5 regex)))
(check-synth)
