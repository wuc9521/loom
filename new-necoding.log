(define-fun cfg.lhs.S ((arg0 Rhs) (arg1 Rules)) Rules (bvor arg0 arg1))
(define-fun cfg.top.S ((arg0 Rhs) (arg1 Rules)) CFG (bvor arg0 arg1))
(synth-fun cfg.rhs.S () Rhs ((C Rhs)) ((C Rhs ((Constant Rhs)))))
(synth-fun g () CFG ((Start CFG) (NRhs Rhs) (NRules Rules)) ((Start CFG ((cfg.top.S NRhs NRules))) (NRhs Rhs (a b cfg.rhs.S (cfg.++ NRhs NRhs))) (NRules Rules ((cfg.lhs.S NRhs NRules) end))))
(constraint (= g cfg.rhs.S))
(constraint (= ((extract 2 2) cfg.rhs.S) #b1))
(constraint (= ((extract 10 10) cfg.rhs.S) #b1))
(constraint (= ((extract 27 27) cfg.rhs.S) #b1))
