use crate::ast::*;


grammar;

extern {
    // token Symbol;
    enum Token {
        Token => Token,
    }
    // token LParen = "(";
    // token RParen = ")";
    // token LBrace = "{";
    // token RBrace = "}";
    // token Semi   = ";";
    // token Whitespace = r"[ \t\r\n]+"; 
}


pub File: Vec<Command> = {
    <cmd:Command>* => cmd
};

Command: Command = {
    // (set-logic FOL)
    LParen "set-logic" <l:Symbol> RParen => Command::SetLogic(l.to_string())
    // (declare-sort U 0)
  | LParen "declare-sort" <s:Symbol> <n:u32> RParen
      => Command::DeclareSort { name: s.to_string(), arity: n }
    // (define-signature Sigma (...))
  | LParen "define-signature" <sig_name:Symbol>
       <items:SigBody>
    RParen => Command::DefineSignature {
        name: sig_name.to_string(),
        items
    }

    // (define-model G1 Sigma (...))
  | LParen "define-model" <model_name:Symbol> <signature_name:Symbol>
       <items:ModelBody>
    RParen => Command::DefineModel {
        model_name: model_name.to_string(),
        signature_name: signature_name.to_string(),
        items
    }

    // (define-grammar G (...))
  | LParen "define-grammar" <g_name:Symbol>
       <rules:GrammarBody>
    RParen => Command::DefineGrammar {
        grammar_name: g_name.to_string(),
        rules
    }

    // (synth-form f Sigma G)
  | LParen "synth-form" <fname:Symbol> <sig:Symbol> <g:Symbol> RParen
      => Command::SynthForm { func_name: fname.to_string(),
                              signature: sig.to_string(),
                              grammar: g.to_string() }

    // (constraint (models G1 f))
  | LParen "constraint" <rest:Sexp> RParen
      => {
        // 这里先直接把 (models G1 f) 当成字符串存储
        Command::Constraint(rest)
      }

    // (check-synth)
  | LParen "check-synth" RParen
      => Command::CheckSynth
};

// 解析 define-signature 的 body：它是一系列 (declare-fun ...) 等等
SigBody: Vec<SignatureItem> = {
    // LParen ... RParen 这一堆
    <items:SigItem*> => items
};

SigItem: SignatureItem = {
    // (declare-fun s () U)
    LParen "declare-fun" <name:Symbol> LParen <arg_sorts:ManySymbols> RParen <ret_sort:Symbol> RParen
      => SignatureItem::DeclareFun {
        name: name.to_string(),
        arg_sorts,
        ret_sort: ret_sort.to_string()
      }
};

// 解析 define-model 的 body
ModelBody: Vec<ModelItem> = {
    <items:ModelItem*> => items
};

ModelItem: ModelItem = {
    // (define-universe (U {a b c d}))
    LParen "define-universe"
         LParen <sort:Symbol> LBrace <elems:ManySymbols> RBrace RParen
    RParen => ModelItem::DefineUniverse {
        sort: sort.to_string(),
        elements: elems,
    }

    // (interpret s a)
  | LParen "interpret" <name:Symbol> <body:InterpretBody> RParen => ModelItem::Interpret {
      name: name.to_string(),
      body
    }
};

// interpret body
InterpretBody: InterpretBody = {
    // 常量解释
    <c:Symbol> => InterpretBody::Const(c.to_string())

    // (match ((a a) True) ((b a) True) ((_ _) False))
  | LParen "match" <pairs:MatchPairs> RParen => InterpretBody::Match(pairs)
};

// match 里面的 ((a a) True) ((b a) True) ((_ _) False) 之类
MatchPairs: Vec<(Vec<String>, bool)> = {
    <pair:MatchPair>* => pair
};

MatchPair: (Vec<String>, bool) = {
    LParen LParen <syms:ManySymbols> RParen <tf:BooleanAtom> RParen => (syms, tf)
};

// Grammar body: 类似
//   ((Term U)
//    (Term s t x y)
//    (Fml Bool)
//    (Fml (and Fml Fml) (or Fml Fml) (not Fml) (E Term Term) (= Term Term)))
GrammarBody: Vec<GrammarRule> = {
    LParen <rules:GrammarRule*> RParen => rules
};

GrammarRule: GrammarRule = {
    // (Term U)
    LParen <lhs:Symbol> <rhs:Symbol> RParen
      => GrammarRule::NonTerminal(lhs.to_string(), rhs.to_string())

    // (Term s t x y) / (Fml (and Fml Fml) (or Fml Fml) ...)
  | LParen <lhs:Symbol> <rhs:ManySymbols> RParen
      => GrammarRule::Expansions(lhs.to_string(), rhs)
};

// 解析 (constraint (models G1 f)) 这样的内部 S-表达式，我们先泛化
// 这里返回一个 String
// 注意：这里为了演示，把所有子 Sexp 递归转成字符串即可
Sexp: String = {
    LParen <head:Symbol> <parts:SexpList> RParen => {
        let mut s = String::new();
        s.push('(');
        s.push_str(&head);
        for p in parts {
            s.push(' ');
            s.push_str(&p);
        }
        s.push(')');
        s
    }
  | <sym:Symbol> => sym.to_string()
};

// 把 ( ... ) 里面的每个子节点当成一个 Sexp，然后放到列表里
SexpList: Vec<String> = {
    <e:Sexp>* => e
};

// 多个 symbol
ManySymbols: Vec<String> = {
    <syms:Symbol>* => ({
        let mut v = Vec::new();
        for s in syms {
            v.push(s.to_string());
        }
        v
    })
};

// 布尔字面量
BooleanAtom: bool = {
    "True"  => true
  | "False" => false
};

// 整数
u32: u32 = {
    <n:Symbol> => match n.parse::<u32>() {
        Ok(v) => v,
        Err(_) => panic!("Expecting u32, found {}", n),
    }
};
