// CompoundValue = { "(" ~ Identifier ~ SyGuSTerm+ ~ ")" }

// // Clearer InterpedCase with explicit handling of each case
// InterpedCase = { 
//   "(" ~ Pattern ~ InterpedValue ~ ")" |  // Case with pattern
//   "(" ~ CompoundValue ~ ")" |           // Case with compound value
//   "(" ~ UnivElem ~ ")" |               // Case with universe element
//   "(" ~ BoolConst ~ ")"                // Case with boolean constant
// }

LSProg = { SOI ~ LSCmd* ~ EOI }

LSCmd = {
  SyGuSCmd
| SignatureDef
| FuncDecl
| QVarDecl
| ModelDef
}
SignatureDef = { "(" ~ "define-signature" ~ Symbol ~ (FuncDecl | QVarDecl)+ ~ ")" }
FuncDecl = { "(" ~ "declare-fun" ~ Symbol ~ "(" ~ Sort* ~ ")" ~ Sort ~ ")" } 
QVarDecl = { "(" ~ "declare-qvar" ~ Symbol ~ Sort ~ ")" }
ModelDef = { "(" ~ "define-model" ~ Symbol ~ (":" ~ "signature" ~ Symbol)? ~ UnivDef* ~ FuncInterp* ~ ")" }
FuncInterp = { "(" ~ "interp-fun" ~ Symbol ~ (SimpleInterp | MatchInterp) ~ ")" }
SimpleInterp = { "(" ~ InterpedValue ~ ")" }  // For simple 0-ary functions
MatchInterp = { "(" ~ "match" ~ "(" ~ MatchCase+ ~ ")" ~ ")" }
MatchCase = { "(" ~ Pattern ~ InterpedValue ~ ")" }
UnivDef = { "(" ~ "define-universe" ~ Sort ~ "(" ~ UnivElem* ~ ")" ~ ")" }
UnivElem = @{ "$" ~ Symbol }

// Define values that can be interpreted
InterpedValue = {
  UnivElem 
| BoolConst 
| "(" ~ Identifier ~ SyGuSTerm+ ~ ")"
}

// Pattern definition (simplified to match SMT-LIB2 style)
Pattern = { 
  UnivElem | Symbol | "_" |           // Simple pattern elements
  "(" ~ (UnivElem | Symbol | "_")+ ~ ")"  // Compound pattern in parentheses
}
