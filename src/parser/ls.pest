LSProg = { SOI ~ LSCmd* ~ EOI }


LSTerm = {
  Identifier
| Literal
| AppTerm
| AttrTerm
| MatchTerm
| LambdaTerm
| MuTerm
| NuTerm
| ForallTerm
| ExistsTerm
| LetTerm
}

AppTerm = { "(" ~ Identifier ~ LSTerm+ ~ ")" } // apply on at least one argument
AttrTerm = { "(" ~ "!" ~ LSTerm ~ Attribute+ ~ ")" }
MatchTerm = { "(" ~ #LSTkMatch="match" ~ LSTerm ~ "(" ~ MatchCase+ ~ ")" ~ ")" }
LambdaTerm = { "(" ~ #LSTkLambda="lambda" ~ "(" ~ SortedVar+ ~ ")" ~ LSTerm ~ ")" }
MuTerm = { "(" ~ "(" ~ #LSTkMu="mu" ~ "(" ~ Symbol ~ "(" ~ SortedVar+ ~ ")" ~ Sort ~ ")" ~ LSTerm ~ ")" ~ LSTerm ~ ")" } // μX.body
NuTerm = { "(" ~ "(" ~ #LSTkNu="nu" ~ "(" ~ Symbol ~ "(" ~ SortedVar+ ~ ")" ~ Sort ~ ")" ~ LSTerm ~ ")" ~ LSTerm ~ ")" } // νX.body
ForallTerm = { "(" ~ #LSTkForall="forall" ~ "(" ~ SortedVar+ ~ ")" ~ LSTerm ~ ")" }
ExistsTerm = { "(" ~ #LSTkExists="exists" ~ "(" ~ SortedVar+ ~ ")" ~ LSTerm ~ ")" }
LetTerm = { "(" ~ #LSTkLet="let" ~ "(" ~ LSVarBinding+ ~ ")" ~ LSTerm ~ ")" }
LSVarBinding = { "(" ~ Symbol ~ LSTerm ~ ")" }

LSCmd = {
  SyGuSCmd
| FuncDecl
| ModelDef
| FuncDefRec
| ModelDecl
| ThSpecCmd
}

FuncDecl = { "(" ~ #LSTkDeclFun="declare-fun" ~ Symbol ~ "(" ~ Sort* ~ ")" ~ Sort ~ ")" } 
ModelDef = { "(" ~ #LSTkDefModel="define-model" ~ Symbol ~ (UnivDef | FuncInterp | ThSpecCmd)* ~ ")" }
ModelDecl = { "(" ~ #LSTkDeclModel="declare-model" ~ Symbol ~ ")" }
FuncInterp = { "(" ~ #LSTkInterpFun="interp-fun" ~ Symbol ~ "(" ~ SortedVar* ~ ")" ~ Sort ~ LSTerm ~ ")" }
MatchCase = { "(" ~ Pattern ~ LSTerm ~ ")" }

UnivDef = { "(" ~ #LSTkDefUniv="define-univ" ~ Sort ~ "(" ~ UnivElem* ~ ")" ~ ")" }
UnivElem = @{ "$" ~ ASCII_ALPHANUMERIC+ }
FuncDefRec = {"(" ~ #LSTkDefineFunRec="define-fun-rec" ~ Symbol ~ "(" ~ SortedVar* ~ ")" ~ Sort ~ LSTerm ~ ")" }

Pattern = { 
  "_" // wildcard
| UnivElem 
| Symbol 
| "(" ~ (UnivElem | Symbol | "_")+ ~ ")" 
}

LSReservedCmd = { 
  "define-univ" | "interp-fun" | "define-model" | "declare-fun"
}

// Theory specification commands
ThSpecCmd = { "(" ~ !(LSReservedCmd|ReservedCommandName) ~ Symbol ~ ThSpecBody* ~ ")" }
ThSpecBody = { ThSpecAtom | ThSpecList }
ThSpecAtom = { (!("(" | ")") ~ ANY)+ }
ThSpecList = { "(" ~ ThSpecBody* ~ ")" }