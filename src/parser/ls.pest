LSProg = { SOI ~ LSCmd* ~ EOI }


LSTerm = {
  MethodCallTerm
| Identifier
| Literal
| AttrTerm
| MatchTerm
| LambdaTerm
| MuTerm
| NuTerm
| ForallTerm
| ExistsTerm
| LetTerm
| AppTerm
}

// Method call term: object.method or self.method
MethodCallTerm = { Symbol ~ "." ~ Symbol }

AppTerm = { 
  "(" ~ MethodCall ~ LSTerm* ~ ")" |  // method call with arguments
  "(" ~ Identifier ~ LSTerm+ ~ ")"    // regular function call
} 

// Method call: object.method or self.method
MethodCall = { Symbol ~ "." ~ Symbol }

AttrTerm = { "(" ~ "!" ~ LSTerm ~ Attribute+ ~ ")" }
MatchTerm = { "(" ~ #LSTkMatch="match" ~ LSTerm ~ "(" ~ MatchCase+ ~ ")" ~ ")" }
LambdaTerm = { "(" ~ #LSTkLambda="lambda" ~ "(" ~ SortedVar+ ~ ")" ~ LSTerm ~ ")" }
MuTerm = { "(" ~ "(" ~ #LSTkMu="mu" ~ "(" ~ Symbol ~ "(" ~ SortedVar+ ~ ")" ~ Sort ~ ")" ~ LSTerm ~ ")" ~ LSTerm+ ~ ")" } // μX.body
NuTerm = { "(" ~ "(" ~ #LSTkNu="nu" ~ "(" ~ Symbol ~ "(" ~ SortedVar+ ~ ")" ~ Sort ~ ")" ~ LSTerm ~ ")" ~ LSTerm+ ~ ")" } // νX.body
ForallTerm = { "(" ~ #LSTkForall="forall" ~ "(" ~ SortedVar+ ~ ")" ~ LSTerm ~ ")" }
ExistsTerm = { "(" ~ #LSTkExists="exists" ~ "(" ~ SortedVar+ ~ ")" ~ LSTerm ~ ")" }
LetTerm = { "(" ~ #LSTkLet="let" ~ "(" ~ LSVarBinding+ ~ ")" ~ LSTerm ~ ")" }
LSVarBinding = { "(" ~ Symbol ~ LSTerm ~ ")" }

LSCmd = {
FuncDecl
| SynthFunExt
| FuncDef
| FuncDefRec
| EnumSortDef
| EchoCmd
| ThSpecCmd
| ClassDef
| ObjectDef
| SyGuSCmd
}

EchoCmd = { "(" ~ #LSTkEcho="echo" ~ LSTerm ~ ")" }
FuncDecl = { "(" ~ #LSTkDeclFun="declare-fun" ~ Symbol ~ "(" ~ Sort* ~ ")" ~ Sort ~ ")" } 
SynthFunExt = { "(" ~ #LSTkSynthFun="synth-fun" ~ Symbol ~ "(" ~ SortedVar+ ~ ")" ~ Sort ~ ")" }
ClassDef = {  "(" ~ #LSTkDefClass="define-class" ~ "(" ~ Symbol ~ "[" ~ Symbol* ~ "]" ~ ")" ~  "(" ~FieldDecl*  ~ ")" ~ (LSCmd)* ~ ")" }

// Field declaration: [fieldName Type]
FieldDecl = {  "[" ~ Symbol ~ Sort ~ "]"  }

// Method definition inside class
MethodDef = { FuncDef | FuncDefRec }

// Object definition: (define-object ObjectName (ClassName TypeArgs) ObjectMember*)
ObjectDef = {  "(" ~ #LSTkDefObject="define-object" ~ Symbol ~ "(" ~ Symbol ~ Sort* ~ ")" ~ LSCmd* ~ ")"  }
MatchCase = { "(" ~ Pattern ~ LSTerm ~ ")" }

SetUniv = { "(" ~ #LSTkSetUniv="set-univ" ~ Symbol ~ Sort ~ ")" }
FuncDef = {"(" ~ #LSTkDefineFun="define-fun" ~ Symbol ~ "(" ~ SortedVar* ~ ")" ~ Sort ~ LSTerm ~ ")" }
FuncDefRec = {"(" ~ #LSTkDefineFunRec="define-fun-rec" ~ Symbol ~ "(" ~ SortedVar* ~ ")" ~ Sort ~ LSTerm ~ ")" }
EnumSortDef = { "(" ~ #LSTkDefSortEnum="define-sort-enum" ~ Symbol ~ "(" ~ Symbol* ~ ")" ~ ")" }
Pattern = { 
  Wildcard // wildcard
| Symbol // variable binding or simple constructor
| "(" ~ Symbol ~ Symbol+ ~ ")" // constructor pattern like (cons head tail) or (nil)
}

Wildcard = { "_" }
LSReservedCmd = { 
  "set-univ" | "interp-fun" | "define-model" | "declare-fun" | "define-sort-enum" | "match" | "define-class" | "define-object"
}

// Theory specification commands
ThSpecCmd = { "(" ~ !(LSReservedCmd|ReservedCommandName) ~ Symbol ~ ThSpecBody* ~ ")" }
ThSpecBody = { ThSpecAtom | ThSpecList }
ThSpecAtom = { (!("(" | ")") ~ ANY)+ }
ThSpecList = { "(" ~ ThSpecBody* ~ ")" }