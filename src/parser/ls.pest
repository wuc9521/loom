LSProg = { SOI ~ LSCmd* ~ EOI }

LSCmd = {
  SyGuSCmd
| SignatureDef
| FuncDecl
| QVarDecl
| ModelDef
}

SignatureDef = { "(" ~ "define-signature" ~ Symbol ~ (FuncDecl | QVarDecl)+ ~ ")" }
FuncDecl = { "(" ~ "declare-fun" ~ Symbol ~ "(" ~ Sort* ~ ")" ~ Sort ~ ")" } // ! extends SMT-lib, doesn't exist in SyGuS.
QVarDecl = { "(" ~ "declare-qvar" ~ Symbol ~ Sort ~ ")" }
ModelDef = { "(" ~ "define-model" ~ Symbol ~ (":" ~ "signature" ~ Symbol)? ~ UnivDef* ~ FuncInterp* ~ ")" }
FuncInterp = {  "(" ~ "interp-fun" ~ Symbol ~  "(" ~ InterpedCase+ ~ ")" ~ ")" }
UnivDef = { "(" ~ "define-universe" ~ Sort ~ "(" ~ UnivElem* ~ ")" ~ ")" }
UnivElem = @{ "$" ~ Symbol }
InterpedValue = {
  UnivElem 
| BoolConst 
| "(" ~ Identifier ~ SyGuSTerm+ ~ ")"
}
InterpedCase = { 
  "(" ~ Pattern ~ InterpedValue ~ ")" // ! same as SMT-lib
| InterpedValue             // if the function symbol is 0-ary, we may ignore the outmost parenthesis
| "(" ~ InterpedValue ~ ")" // or may not.
} 
Pattern = { (UnivElem | Symbol | "_")+ }