LSProg = { SOI ~ LSCmd* ~ EOI }

LSCmd = {
  SyGuSCmd
| SignatureDef
| FuncDecl
| ModelDef
| ThSpecCmd
}
SignatureDef = { "(" ~ "define-signature" ~ Symbol ~ (FuncDecl | ThSpecCmd)+ ~ ")" }
FuncDecl = { "(" ~ "declare-fun" ~ Symbol ~ "(" ~ Sort* ~ ")" ~ Sort ~ ")" } 
// QVarDecl = { "(" ~ "declare-qvar" ~ Symbol ~ Sort ~ ")" }
ModelDef = { "(" ~ "define-model" ~ Symbol ~ (UnivDef | FuncInterp | ThSpecCmd)* ~ ")" }
LSReservedCmd = { "define-univ" | "interp-fun"}
ThSpecCmd = { "(" ~ !LSReservedCmd ~ Symbol ~ (SExpr*) ~ ")" }
FuncInterp = { "(" ~ "interp-fun" ~ Symbol ~ (SimpleInterp | MatchInterp) ~ ")" }
SimpleInterp = { "(" ~ InterpedValue ~ ")" }  // For simple 0-ary functions
MatchInterp = { "(" ~ "match" ~ "(" ~ MatchCase+ ~ ")" ~ ")" }
MatchCase = { "(" ~ Pattern ~ InterpedValue ~ ")" }
UnivDef = { "(" ~ "define-univ" ~ Sort ~ "(" ~ UnivElem* ~ ")" ~ ")" }
UnivElem = @{ "$" ~ ASCII_ALPHANUMERIC+ }

// Define values that can be interpreted
InterpedValue = {
  UnivElem 
| Literal
| "(" ~ Identifier ~ SyGuSTerm+ ~ ")"
}

// Pattern definition (simplified to match SMT-LIB2 style)
Pattern = { 
  UnivElem | Symbol | "_" |           // Simple pattern elements
  "(" ~ (UnivElem | Symbol | "_")+ ~ ")"  // Compound pattern in parentheses
}
