DelisProg = { SOI ~ DelisCmd* ~ EOI }

DelisCmd = {
  SyGuSCmd
| DeclareTermTypes
| DefineFinite
| DefineSemantics
| FuncDecl
| ModelDef
| FuncDefRec
}
DeclareTermTypes = {
  "("
  ~ #DelisTkDeclareTermTypes="declare-term-types"
  ~ "(" ~ DelisTermSortDecl+ ~ ")"
  ~ "(" ~ DelisTermTypeDecl+ ~ ")"
  ~ ")"
}
DelisTermSortDecl = { "(" ~ Symbol ~ Numeral ~ ")" }
DelisTermTypeDecl = { "(" ~ DelisTermCtorDecl* ~ ")" }
DelisTermCtorDecl = { "(" ~ Identifier ~ Sort* ~ ")" }
DefineFinite = {
  "("
  ~ #DelisTkDefineFinite="define-finite"
  ~ Symbol
  ~ DelisSExprBody*
  ~ ")"
}
DefineSemantics = {
  "("
  ~ #DelisTkDefineSemantics="define-semantics"
  ~ DelisSExprBody*
  ~ ")"
}
FuncDecl = { "(" ~ #DelisTkDeclFun="declare-fun" ~ Symbol ~ "(" ~ Sort* ~ ")" ~ Sort ~ ")" } 
ModelDef = { "(" ~ #DelisTkDefModel="define-model" ~ Symbol ~ (UnivDef | FuncInterp)* ~ ")" }
FuncInterp = { "(" ~ #DelisTkInterpFun="interp-fun" ~ Symbol ~ (SimpleInterp | MatchInterp) ~ ")" }
SimpleInterp = { "(" ~ InterpedValue ~ ")" }  // For simple 0-ary functions
MatchInterp = { "(" ~ #DelisTkMatch="match" ~ "(" ~ MatchCase+ ~ ")" ~ ")" }
MatchCase = { "(" ~ Pattern ~ InterpedValue ~ ")" }
UnivDef = { "(" ~ #DelisTkDefUniv="define-univ" ~ Sort ~ "(" ~ UnivElem* ~ ")" ~ ")" }
UnivElem = @{ "$" ~ ASCII_ALPHANUMERIC+ }
FuncDefRec = {"(" ~ #DelisTkDefineFunRec="define-fun-rec" ~ Symbol ~ "(" ~ SortedVar* ~ ")" ~ Sort ~ SyGuSTerm ~ ")" }

// Define values that can be interpreted
InterpedValue = {
  UnivElem 
| Literal
| "(" ~ Identifier ~ SyGuSTerm+ ~ ")"
}

// Pattern definition (simplified to match SMT-LIB2 style)
Pattern = { 
  UnivElem | Symbol | "_" |           // Simple pattern elements
  "(" ~ (UnivElem | Symbol | "_")+ ~ ")"  // Compound pattern in parentheses
}

DelisReservedCmd = { 
  "define-univ" | "interp-fun" | "define-model" | "declare-fun" | "declare-term-types" | "define-finite" | "define-semantics"
}

DelisSExprBody = { DelisSExprAtom | DelisSExprList }
DelisSExprAtom = { (!("(" | ")") ~ ANY)+ }
DelisSExprList = { "(" ~ DelisSExprBody* ~ ")" }
