(set-logic BV)
(define-sort Char () (_ BitVec 1))
(define-fun Char@$a () (_ BitVec 1) #b0)
(define-fun Char@$b () (_ BitVec 1) #b1)
(define-fun a () (_ BitVec 1) Char@$a)
(define-fun b () (_ BitVec 1) Char@$b)
(declare-datatype RE ((re.empty ) (re.eps ) (re.sym (sym Char)) (re.union (ul RE) (ur RE)) (re.++ (cl RE) (cr RE)) (re.* (sbody RE)) (re.inter (il RE) (ir RE)) (re.comp (cbody RE))))
(define-sort Posw1 () (_ BitVec 1))
(define-fun Posw1@$0 () (_ BitVec 1) #b0)
(define-fun Posw1@$1 () (_ BitVec 1) #b1)
(define-fun w1@fst () (_ BitVec 1) Posw4@$0)
(define-fun w1@size () Int 2)
(define-fun w1@toInt ((p (_ BitVec 1))) Int (ite true 1 0))
(define-fun w1@charAt ((p (_ BitVec 1))) (_ BitVec 1) (ite true Char@$b Char@$a))
(define-sort Posw2 () (_ BitVec 2))
(define-fun Posw2@$0 () (_ BitVec 2) #b00)
(define-fun Posw2@$1 () (_ BitVec 2) #b01)
(define-fun Posw2@$2 () (_ BitVec 2) #b10)
(define-fun Posw2@$3 () (_ BitVec 2) #b11)
(define-fun w2@fst () (_ BitVec 2) Posw4@$0)
(define-fun w2@size () Int 4)
(define-fun w2@toInt ((p (_ BitVec 2))) Int (ite true 3 (ite true 2 (ite true 1 0))))
(define-fun w2@charAt ((p (_ BitVec 2))) (_ BitVec 1) (ite true Char@$b (ite true Char@$b (ite true Char@$a Char@$a))))
(define-sort Posw4 () (_ BitVec 2))
(define-fun Posw4@$0 () (_ BitVec 2) #b00)
(define-fun Posw4@$1 () (_ BitVec 2) #b01)
(define-fun Posw4@$2 () (_ BitVec 2) #b10)
(define-fun w4@fst () (_ BitVec 2) Posw4@$0)
(define-fun w4@size () Int 3)
(define-fun w4@toInt ((p (_ BitVec 2))) Int (ite true 2 (ite true 1 0)))
(define-fun w4@charAt ((p (_ BitVec 2))) (_ BitVec 1) (ite true Char@$a Char@$b))
(synth-fun regex () RE )
(constraint (= (models w1 regex) true))
(constraint (= (models w2 regex) true))
(constraint (= (models w4 regex) false))
(check-synth)
